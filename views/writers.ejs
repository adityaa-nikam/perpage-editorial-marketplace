<%- include('partials/head', { 
  pageTitle: 'Choose Your Editor — PerPage', 
  metaDescription: 'Browse editors with upfront per-page rates and completed deal counts.',
  canonical: canonical,
  noindex: noindex 
}) %>
<%- include('partials/navbar') %>

<main id="main-content" class="py-10 sm:py-14">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

    <% if (typeof dbError !== 'undefined' && dbError) { %>
      <!-- Database Connection Error State -->
      <div class="alert alert-danger" role="alert">
        <div class="flex items-start gap-3">
          <%- icon('alert-circle', { class: 'w-5 h-5 flex-shrink-0 mt-0.5' }) %>
          <div class="space-y-1">
            <h2 class="text-sm font-semibold text-[var(--text-ink)]">Unable to load editors</h2>
            <p class="text-xs text-[var(--text-muted)]">
              A temporary database issue prevented loading editor profiles. Please refresh or try again shortly.
            </p>
            <div class="pt-2">
              <a href="/writers" class="btn btn-secondary btn-sm">Try again</a>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Page Header -->
    <div class="space-y-2 border-b border-[var(--border-color)] pb-6">
      <div class="section-eyebrow">
        <span class="eyebrow-num">01</span>
        <span class="eyebrow-rule"></span>
        <span class="eyebrow-label">Editor Directory</span>
      </div>
      <h1 class="type-h1">Choose your editor</h1>
      <p class="type-body text-sm text-[var(--text-muted)] max-w-2xl prose-measure">
        Browse editor profiles, review transparent per-page rates, and create an editing deal directly with your chosen editor.
      </p>
    </div>

    <!-- Search & Filter Toolbar (Works purely with GET, enhanced by Alpine) -->
    <div class="card p-4 sm:p-5" x-data="{ searchQuery: '<%= q || '' %>' }">
      <form action="/writers" method="GET" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-4 items-end">
          
          <!-- Search Input -->
          <div class="sm:col-span-5 space-y-1.5">
            <label for="search-input" class="form-label text-xs">Search name or bio</label>
            <div class="relative flex items-center">
              <span class="absolute left-3 text-[var(--text-muted)] pointer-events-none">
                <%- icon('search', { class: 'w-4 h-4' }) %>
              </span>
              <input 
                type="text" 
                id="search-input" 
                name="q" 
                value="<%= q || '' %>"
                x-model="searchQuery"
                maxlength="80"
                placeholder="Search by editor name or keywords..."
                class="form-input pl-9 pr-8 text-sm w-full"
              >
              <button 
                type="button" 
                x-show="searchQuery.length > 0" 
                @click="searchQuery = ''; $nextTick(() => $el.form.submit())"
                class="absolute right-2.5 text-[var(--text-muted)] hover:text-[var(--text-ink)] p-0.5 cursor-pointer"
                aria-label="Clear search query"
                style="display: none;"
              >
                <%- icon('x', { class: 'w-3.5 h-3.5' }) %>
              </button>
            </div>
          </div>

          <!-- Sort Select -->
          <div class="sm:col-span-3 space-y-1.5">
            <label for="sort-select" class="form-label text-xs">Sort by</label>
            <select id="sort-select" name="sort" class="form-select text-sm w-full">
              <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest</option>
              <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Price: low to high</option>
              <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Price: high to low</option>
              <option value="completed" <%= sort === 'completed' ? 'selected' : '' %>>Most completed</option>
            </select>
          </div>

          <!-- Has Rate Checkbox -->
          <div class="sm:col-span-2 flex items-center h-10 pb-1">
            <label class="inline-flex items-center gap-2 cursor-pointer text-xs text-[var(--text-ink)] select-none">
              <input 
                type="checkbox" 
                name="hasRate" 
                value="1" 
                <%= hasRate ? 'checked' : '' %>
                class="form-checkbox"
              >
              <span>Has rate set</span>
            </label>
          </div>

          <!-- Submit Button -->
          <div class="sm:col-span-2">
            <button type="submit" class="btn btn-primary btn-md w-full justify-center">
              Apply
            </button>
          </div>
        </div>

        <!-- Hidden input to preserve or reset page -->
        <input type="hidden" name="page" value="1">
      </form>

      <!-- Active Filters Chips & Result Count -->
      <% 
        const hasActiveFilters = Boolean(q || hasRate || (sort && sort !== 'newest'));
      %>
      <div class="pt-3 mt-3 border-t border-[var(--border-color)] flex flex-wrap items-center justify-between gap-3 text-xs">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-[var(--text-muted)] font-medium">
            <% if (totalCount === 1) { %>
              Showing 1 editor
            <% } else { %>
              Showing <%= totalCount %> editors
            <% } %>
          </span>

          <% if (q) { %>
            <a href="/writers?sort=<%= sort %><%= hasRate ? '&hasRate=1' : '' %>" class="chip" title="Remove search filter">
              <span>Keyword: "<%= q %>"</span>
              <span class="chip-remove" aria-hidden="true">&times;</span>
            </a>
          <% } %>

          <% if (hasRate) { %>
            <a href="/writers?q=<%= encodeURIComponent(q) %>&sort=<%= sort %>" class="chip" title="Remove rate filter">
              <span>Has rate set</span>
              <span class="chip-remove" aria-hidden="true">&times;</span>
            </a>
          <% } %>

          <% if (sort && sort !== 'newest') { %>
            <a href="/writers?q=<%= encodeURIComponent(q) %><%= hasRate ? '&hasRate=1' : '' %>" class="chip" title="Reset to newest">
              <span>Sort: <%= sort === 'price_asc' ? 'Price: low to high' : sort === 'price_desc' ? 'Price: high to low' : 'Most completed' %></span>
              <span class="chip-remove" aria-hidden="true">&times;</span>
            </a>
          <% } %>
        </div>

        <% if (hasActiveFilters) { %>
          <a href="/writers" class="text-xs text-[var(--accent)] hover:underline font-medium">
            Reset all filters
          </a>
        <% } %>
      </div>
    </div>

    <!-- Writers Grid -->
    <% if (writers && writers.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% writers.forEach((writer) => { 
          const completedCount = completedDealsMap[writer._id.toString()] || 0;
          const initials = (writer.name || 'W').split(' ').map(n => n.charAt(0)).slice(0, 2).join('').toUpperCase();
        %>
          <div class="card p-5 flex flex-col justify-between transition-colors duration-150 hover:border-[var(--border-strong)] relative">
            <div class="space-y-4">
              <!-- Header: Avatar, Name & Upfront Price -->
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="avatar avatar-md flex-shrink-0" aria-hidden="true">
                    <% if (writer.profilePic) { %>
                      <img src="<%= writer.profilePic %>" alt="<%= writer.name %>">
                    <% } else { %>
                      <span><%= initials %></span>
                    <% } %>
                  </div>
                  <div class="min-w-0">
                    <h2 class="type-h3 text-base truncate font-semibold text-[var(--text-ink)]">
                      <a href="/writers/<%= writer._id %>" class="hover:text-[var(--accent)] transition-colors focus-ring rounded">
                        <%= writer.name %>
                      </a>
                    </h2>
                    <div class="mt-1">
                      <% if (completedCount > 0) { %>
                        <span class="badge badge-neutral text-[11px] tabular-nums">
                          Completed: <%= completedCount %>
                        </span>
                      <% } else { %>
                        <span class="badge badge-neutral text-[11px]">
                          New Fellow
                        </span>
                      <% } %>
                    </div>
                  </div>
                </div>

                <div class="text-right flex-shrink-0">
                  <% if (writer.pricePerPage && writer.pricePerPage > 0) { %>
                    <div class="text-sm font-semibold text-[var(--text-ink)] tabular-nums">
                      ₹<%= writer.pricePerPage %>
                    </div>
                    <div class="text-[11px] text-[var(--text-muted)]">per page</div>
                  <% } else { %>
                    <span class="badge badge-neutral text-[11px] font-mono">
                      Rate on inquiry
                    </span>
                  <% } %>
                </div>
              </div>

              <!-- Clamped Bio -->
              <div>
                <% if (writer.bio && writer.bio.trim()) { %>
                  <p class="type-body text-xs text-[var(--text-muted)] line-clamp-2 leading-relaxed">
                    <%= writer.bio %>
                  </p>
                <% } else { %>
                  <p class="type-body text-xs text-[var(--text-muted)] italic opacity-80">
                    Specialist active. Detailed background pending.
                  </p>
                <% } %>
              </div>
            </div>

            <!-- Footer Action: Exactly one focusable link per card -->
            <div class="pt-4 mt-4 border-t border-[var(--border-color)]">
              <a href="/writers/<%= writer._id %>" class="btn btn-secondary btn-sm w-full justify-center">
                View profile
                <%- icon('arrow-right', { class: 'w-3.5 h-3.5 ml-1' }) %>
              </a>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Server-Side Pagination Controls -->
      <% if (totalPages > 1) { 
        function buildPageUrl(p) {
          const params = new URLSearchParams();
          if (q) params.set('q', q);
          if (sort && sort !== 'newest') params.set('sort', sort);
          if (hasRate) params.set('hasRate', '1');
          params.set('page', p);
          return '/writers?' + params.toString();
        }
      %>
        <nav class="pagination pt-6 flex items-center justify-between" aria-label="Editors directory pagination">
          <div>
            <% if (currentPage > 1) { %>
              <a href="<%= buildPageUrl(currentPage - 1) %>" class="btn btn-secondary btn-sm">
                <%- icon('chevron-left', { class: 'w-3.5 h-3.5 mr-1' }) %>
                Previous
              </a>
            <% } else { %>
              <span class="btn btn-secondary btn-sm opacity-50 cursor-not-allowed" aria-disabled="true">
                <%- icon('chevron-left', { class: 'w-3.5 h-3.5 mr-1' }) %>
                Previous
              </span>
            <% } %>
          </div>

          <div class="flex items-center gap-1.5 text-xs">
            <% for (let p = 1; p <= totalPages; p++) { %>
              <% if (p === currentPage) { %>
                <span class="pagination-link active" aria-current="page"><%= p %></span>
              <% } else if (p === 1 || p === totalPages || (p >= currentPage - 2 && p <= currentPage + 2)) { %>
                <a href="<%= buildPageUrl(p) %>" class="pagination-link"><%= p %></a>
              <% } else if (p === currentPage - 3 || p === currentPage + 3) { %>
                <span class="px-1 text-[var(--text-muted)]">…</span>
              <% } %>
            <% } %>
          </div>

          <div>
            <% if (currentPage < totalPages) { %>
              <a href="<%= buildPageUrl(currentPage + 1) %>" class="btn btn-secondary btn-sm">
                Next
                <%- icon('chevron-right', { class: 'w-3.5 h-3.5 ml-1' }) %>
              </a>
            <% } else { %>
              <span class="btn btn-secondary btn-sm opacity-50 cursor-not-allowed" aria-disabled="true">
                Next
                <%- icon('chevron-right', { class: 'w-3.5 h-3.5 ml-1' }) %>
              </span>
            <% } %>
          </div>
        </nav>
      <% } %>

    <% } else { %>
      <!-- Empty State -->
      <div class="empty-state p-8 sm:p-12 space-y-4">
        <div class="w-12 h-12 mx-auto rounded-full bg-[var(--bg-surface-muted)] border border-[var(--border-color)] flex items-center justify-center text-[var(--text-muted)]">
          <%- icon('search', { class: 'w-6 h-6' }) %>
        </div>

        <% if (hasActiveFilters) { %>
          <div class="space-y-1.5">
            <h2 class="type-h3 text-base">No editors match your search</h2>
            <p class="type-body text-xs text-[var(--text-muted)] max-w-sm mx-auto">
              We couldn't find any editors matching your search keywords or filter criteria. Try clearing filters or adjusting terms.
            </p>
          </div>
          <div class="pt-2">
            <a href="/writers" class="btn btn-secondary btn-sm">
              Clear filters
            </a>
          </div>
        <% } else { %>
          <div class="space-y-1.5">
            <h2 class="type-h3 text-base">No editors registered yet</h2>
            <p class="type-body text-xs text-[var(--text-muted)] max-w-sm mx-auto">
              There are currently no editors listed in the directory. Create an account to become an editor on PerPage.
            </p>
          </div>
          <div class="pt-2">
            <a href="/register" class="btn btn-primary btn-sm">
              Become an editor
            </a>
          </div>
        <% } %>
      </div>
    <% } %>

  </div>
</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
