<%- include('partials/head', { 
  pageTitle: 'Create an account | perpage.', 
  metaDescription: 'Create a PerPage account as a client or freelance editor. Commission editing reviews with upfront per-page rates.' 
}) %>
<%- include('partials/navbar') %>

<main id="main-content" class="auth-wrapper" x-data="{ showPassword: false, selectedRole: 'user', isSubmitting: false }">
  <div class="auth-grid">

    <!-- Left Column: Editorial Showcase (Brand consistency with navbar) -->
    <div class="auth-showcase-panel">
      <!-- Brand Header -->
      <div>
        <a href="/home" class="inline-flex items-center gap-2 text-decoration-none group mb-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] rounded-lg">
          <span class="brand-mark-tile w-7 h-7 rounded-md text-sm">
            P
          </span>
          <span class="font-serif text-xl tracking-tight text-[var(--text-ink)] font-bold flex items-baseline select-none">
            perpage<span class="text-[var(--mark)]">.</span>
          </span>
        </a>

        <div class="space-y-1.5">
          <div class="section-eyebrow">
            <span class="eyebrow-num">02</span>
            <span class="eyebrow-rule"></span>
            <span class="eyebrow-label">Join PerPage Registry</span>
          </div>
          <h2 class="type-h2 text-xl font-normal text-[var(--text-ink)] leading-snug">
            Transparent editing partnerships for scholars &amp; editors.
          </h2>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed">
            Whether commissioning structural feedback on a draft or offering specialist copy editing, PerPage models clear, upfront per-page agreements.
          </p>
        </div>
      </div>

      <!-- Live Interactive Editorial Manuscript Preview Card -->
      <div class="my-4 p-3 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-color)] shadow-xs space-y-2">
        <div class="flex items-center justify-between text-[10px] pb-1.5 border-b border-[var(--border-color)]">
          <span class="font-mono text-[var(--text-muted)]">Editorial Standard</span>
          <span class="font-mono font-semibold text-[var(--accent)]">Author Autonomy</span>
        </div>

        <div class="space-y-1">
          <div class="text-xs font-semibold text-[var(--text-ink)]">
            Clear separation of writing and editing
          </div>
          <p class="text-[10px] text-[var(--text-muted)] leading-tight">
            You give feedback and edits on the client's own text. You do not write documents from scratch.
          </p>
        </div>

        <div class="pt-1.5 border-t border-[var(--border-color)] grid grid-cols-2 gap-1.5 text-[10px]">
          <div class="p-1.5 rounded bg-[var(--bg-surface-muted)] text-center">
            <div class="font-mono font-semibold text-[var(--text-ink)]">Per-Page</div>
            <div class="text-[9px] text-[var(--text-muted)]">Predictable costs</div>
          </div>
          <div class="p-1.5 rounded bg-[var(--bg-surface-muted)] text-center">
            <div class="font-mono font-semibold text-[var(--text-ink)]">Direct</div>
            <div class="text-[9px] text-[var(--text-muted)]">No middlemen</div>
          </div>
        </div>
      </div>

      <!-- Acceptable Use Notice Footer -->
      <div class="pt-2.5 border-t border-[var(--border-color)] text-[11px] text-[var(--text-muted)] leading-relaxed">
        <p>
          By creating an account, you agree to our 
          <a href="/acceptable-use" target="_blank" class="text-[var(--accent)] underline hover:text-[var(--text-ink)]">
            Acceptable Use Policy
          </a>.
        </p>
      </div>
    </div>

    <!-- Right Column: Sleek Registration Form -->
    <div class="auth-form-panel">
      <!-- Mobile-only Brand Wordmark -->
      <div class="lg:hidden flex items-center justify-center gap-2 mb-3">
        <a href="/home" class="inline-flex items-center gap-2 text-decoration-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] rounded-lg">
          <span class="brand-mark-tile w-6 h-6 text-xs rounded-md">
            P
          </span>
          <span class="font-serif text-lg tracking-tight text-[var(--text-ink)] font-bold flex items-baseline select-none">
            perpage<span class="text-[var(--mark)]">.</span>
          </span>
        </a>
      </div>

      <!-- Top Tab Switcher (Segmented Control) -->
      <div class="segmented-control w-full mb-3.5 grid grid-cols-2 p-0.5 bg-[var(--bg-surface-muted)] border border-[var(--border-color)] rounded-lg">
        <a href="/login" class="segmented-tab py-1.5 text-center text-xs font-medium rounded-md text-[var(--text-muted)] hover:text-[var(--text-ink)]">
          Sign In
        </a>
        <a href="/register" class="segmented-tab is-active py-1.5 text-center text-xs font-semibold rounded-md bg-[var(--bg-surface)] shadow-xs text-[var(--text-ink)]" aria-current="page">
          Create Account
        </a>
      </div>

      <!-- Title & Subtitle -->
      <div class="mb-3">
        <h1 class="text-lg sm:text-xl font-serif text-[var(--text-ink)] font-normal">
          Create your <span class="font-bold">perpage<span class="text-[var(--mark)]">.</span></span> account
        </h1>
        <p class="text-xs text-[var(--text-muted)] mt-0.5">
          Join scholars, researchers, and freelance academic editors.
        </p>
      </div>

      <!-- Fast OAuth Social Buttons -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-3">
        <form action="/auth/google" method="GET">
          <button type="submit" class="auth-social-button" aria-label="Sign up with Google">
            <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span>Google</span>
          </button>
        </form>

        <form action="/auth/github" method="GET">
          <button type="submit" class="auth-social-button" aria-label="Sign up with GitHub">
            <svg class="w-3.5 h-3.5 shrink-0 fill-current text-[var(--text-ink)]" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>GitHub</span>
          </button>
        </form>
      </div>

      <!-- Hairline Divider -->
      <div class="relative flex items-center justify-center my-2.5">
        <div class="w-full border-t border-[var(--border-color)]"></div>
        <span class="absolute bg-[var(--bg-surface)] px-2.5 text-[9px] uppercase font-mono tracking-wider text-[var(--text-muted)]">
          or register with email
        </span>
      </div>

      <!-- Registration Form -->
      <form action="/register" method="POST" class="space-y-2.5" @submit="isSubmitting = true">
        <!-- Interactive Role Selection Cards -->
        <div class="space-y-1">
          <label class="form-label text-xs">Select your role</label>
          <div class="grid grid-cols-2 gap-2">
            <!-- Client Option -->
            <label 
              @click="selectedRole = 'user'" 
              class="auth-role-card flex flex-col justify-between"
              :class="{ 'is-selected': selectedRole === 'user' }"
            >
              <input type="radio" name="role" value="user" class="sr-only" :checked="selectedRole === 'user'">
              <div class="flex items-center justify-between mb-0.5">
                <span class="text-xs font-semibold text-[var(--text-ink)]">Client</span>
                <span x-show="selectedRole === 'user'" class="text-[var(--accent)]">
                  <%- icon('check', { class: 'w-3 h-3' }) %>
                </span>
              </div>
              <p class="text-[10px] text-[var(--text-muted)] leading-tight">
                Commission editing on drafts
              </p>
            </label>

            <!-- Editor Option -->
            <label 
              @click="selectedRole = 'writer'" 
              class="auth-role-card flex flex-col justify-between"
              :class="{ 'is-selected': selectedRole === 'writer' }"
            >
              <input type="radio" name="role" value="writer" class="sr-only" :checked="selectedRole === 'writer'">
              <div class="flex items-center justify-between mb-0.5">
                <span class="text-xs font-semibold text-[var(--text-ink)]">Editor</span>
                <span x-show="selectedRole === 'writer'" class="text-[var(--accent)]" x-cloak>
                  <%- icon('check', { class: 'w-3 h-3' }) %>
                </span>
              </div>
              <p class="text-[10px] text-[var(--text-muted)] leading-tight">
                Review drafts &amp; offer feedback
              </p>
            </label>
          </div>
        </div>

        <!-- Full Name -->
        <div class="space-y-1">
          <label for="name" class="form-label text-xs">Full Name</label>
          <div class="auth-input-group">
            <span class="auth-input-icon">
              <%- icon('user', { class: 'w-3.5 h-3.5' }) %>
            </span>
            <input 
              type="text" 
              id="name" 
              name="name" 
              placeholder="e.g. Dr. Kavita Sharma" 
              required 
              autocomplete="name"
              class="auth-input"
            >
          </div>
        </div>

        <!-- Email Address -->
        <div class="space-y-1">
          <label for="email" class="form-label text-xs">Email Address</label>
          <div class="auth-input-group">
            <span class="auth-input-icon">
              <%- icon('mail', { class: 'w-3.5 h-3.5' }) %>
            </span>
            <input 
              type="email" 
              id="email" 
              name="email" 
              placeholder="name@university.edu" 
              required 
              autocomplete="email"
              class="auth-input"
            >
          </div>
        </div>

        <!-- Password with Interactive Visibility Toggle -->
        <div class="space-y-1">
          <div class="flex items-center justify-between">
            <label for="password" class="form-label text-xs mb-0">Password (8–72 characters)</label>
          </div>
          <div class="auth-input-group">
            <span class="auth-input-icon">
              <%- icon('lock', { class: 'w-3.5 h-3.5' }) %>
            </span>
            <input 
              :type="showPassword ? 'text' : 'password'" 
              id="password" 
              name="password" 
              placeholder="••••••••" 
              required 
              minlength="8"
              maxlength="72"
              autocomplete="new-password"
              class="auth-input"
            >
            <button 
              type="button" 
              @click="showPassword = !showPassword" 
              class="auth-password-toggle"
              :aria-label="showPassword ? 'Hide password' : 'Show password'"
            >
              <span x-show="!showPassword">
                <%- icon('eye', { class: 'w-3.5 h-3.5' }) %>
              </span>
              <span x-show="showPassword" x-cloak>
                <%- icon('eye-off', { class: 'w-3.5 h-3.5' }) %>
              </span>
            </button>
          </div>
        </div>

        <!-- Location / Institution -->
        <div class="space-y-1">
          <label for="address" class="form-label text-xs">Location / University affiliation</label>
          <input 
            type="text" 
            id="address" 
            name="address" 
            placeholder="e.g. University of Delhi"
            class="form-input h-9 text-xs"
          >
        </div>

        <!-- Bio (Visible when Editor is selected) -->
        <div class="space-y-1" x-show="selectedRole === 'writer'" x-cloak>
          <label for="bio" class="form-label text-xs">Editorial Focus &amp; Bio</label>
          <textarea 
            id="bio" 
            name="bio" 
            placeholder="Outline your subject matter expertise (e.g. Econometrics, Social Sciences, APA 7th Referencing)..."
            class="form-textarea text-xs"
            rows="2"
          ></textarea>
        </div>

        <!-- Submit Button -->
        <button 
          type="submit" 
          class="btn btn-primary h-9 w-full mt-1 text-xs font-medium"
          :disabled="isSubmitting"
          :aria-busy="isSubmitting ? 'true' : 'false'"
        >
          <span x-show="!isSubmitting" class="flex items-center justify-center gap-1.5">
            <span>Create PerPage Account</span>
            <%- icon('arrow-right', { class: 'w-3.5 h-3.5' }) %>
          </span>
          <span x-show="isSubmitting" x-cloak class="flex items-center justify-center gap-1.5">
            <%- icon('loader', { class: 'w-3.5 h-3.5 animate-spin' }) %>
            <span>Creating account...</span>
          </span>
        </button>
      </form>

      <!-- Bottom Redirect Link -->
      <div class="text-center mt-3 pt-2.5 border-t border-[var(--border-color)]">
        <p class="text-xs text-[var(--text-muted)]">
          Already have an account? 
          <a href="/login" class="text-[var(--accent)] font-semibold hover:underline">
            Sign in here &rarr;
          </a>
        </p>
      </div>

    </div>

  </div>
</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>