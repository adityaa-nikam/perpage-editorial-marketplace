<%- include('partials/head', { 
  pageTitle: 'PerPage — Document Editing & Feedback Marketplace',
  metaDescription: 'Browse freelance editors, calculate upfront per-page rates, and get structured editing and feedback on your own drafts.',
  canonical: 'https://perpage.onrender.com/'
}) %>
<%- include('partials/navbar') %>

<% 
  function getInitials(name) {
    if (!name) return 'E';
    const parts = name.trim().split(/\s+/);
    if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
    return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  }
%>

<!-- Brand Intro Loader (First visit per session only, maximum 800ms visible) -->
<div id="brand-intro" aria-hidden="true">
  <div class="flex flex-col items-center">
    <div class="intro-letter">
      P
      <svg class="absolute -bottom-2 left-0 w-full h-3 overflow-visible" viewBox="0 0 40 8" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M 2 4 Q 10 1, 20 5 T 38 4" class="intro-underline-path" />
      </svg>
    </div>
  </div>
</div>
<script nonce="<%= locals.cspNonce || '' %>">
  (function() {
    try {
      var isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var isBot = navigator.webdriver || window.location.search.indexOf('noloader') !== -1;
      var alreadySeen = sessionStorage.getItem('perpage_intro_seen');
      var introEl = document.getElementById('brand-intro');
      if (isReduced || isBot || alreadySeen) {
        if (introEl) introEl.remove();
      } else {
        sessionStorage.setItem('perpage_intro_seen', '1');
        setTimeout(function() {
          if (introEl) {
            introEl.classList.add('fade-out');
            setTimeout(function() { introEl.remove(); }, 250);
          }
        }, 700);
      }
    } catch (e) {
      var el = document.getElementById('brand-intro');
      if (el) el.remove();
    }
  })();
</script>

