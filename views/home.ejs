  <!-- =========================================================================
       4. FEATURED EDITORS SECTION (Editorial Card Layout)
       ========================================================================= -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 reveal-on-scroll">
    <div class="section-header-rule">
      <div class="section-eyebrow">
        <span class="eyebrow-num">04</span>
        <span class="eyebrow-rule"></span>
        <span class="eyebrow-label">Editors</span>
      </div>
      <a href="/writers" class="inline-flex items-center gap-1.5 text-xs font-mono text-[var(--accent)] hover:underline uppercase tracking-wider">
        <span>View all editors</span>
        <%- icon('arrow-right', { class: 'w-3.5 h-3.5' }) %>
      </a>
    </div>

    <div class="max-w-xl mb-8">
      <h2 class="type-h2 tracking-tight">Featured Editors</h2>
      <p class="type-body text-[var(--text-muted)] prose-measure">
        Editors you can hire for document editing and feedback.
      </p>
    </div>

    <% if (locals.featuredWriters && featuredWriters.length > 0) { %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% featuredWriters.forEach(function(writer, index) { %>
          <% 
            const hasReviews = Boolean(writer.reviewCount && writer.reviewCount > 0);
            const ratingVal = hasReviews ? Number(writer.averageRating || 0).toFixed(1) : null;
            const reviewsCount = hasReviews ? writer.reviewCount : 0;
          %>
          <div class="card p-6 flex flex-col justify-between space-y-5 hover:border-[var(--border-strong)] transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md <%= index === 0 ? 'border-[var(--border-strong)] bg-[var(--bg-surface)]' : '' %>">
            <div class="space-y-4">
              <!-- Editor Header -->
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="avatar avatar-md font-serif font-semibold shrink-0">
                    <% if (writer.profilePic) { %>
                      <img src="<%= writer.profilePic %>" alt="<%= writer.name || 'Editor' %>" class="w-full h-full object-cover">
                    <% } else { %>
                      <span><%= getInitials(writer.name) %></span>
                    <% } %>
                  </div>
                  <div class="min-w-0">
                    <h3 class="type-h4 text-base text-[var(--text-ink)] leading-snug truncate"><%= writer.name || 'Freelance Editor' %></h3>
                    <div class="text-xs text-[var(--text-muted)]">Freelance Editor</div>
                  </div>
                </div>

                <!-- Star Rating Badge (Only if real reviews exist) -->
                <% if (hasReviews) { %>
                  <span class="inline-flex items-center gap-1 text-[11px] font-mono font-bold text-amber-700 bg-amber-50 dark:bg-amber-950/50 dark:text-amber-300 border border-amber-200 dark:border-amber-800/60 px-2 py-0.5 rounded-full shrink-0">
                    <svg class="w-3 h-3 fill-amber-400 text-amber-500" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    <%= ratingVal %>
                  </span>
                <% } else { %>
                  <span class="badge badge-neutral text-[10px] font-mono shrink-0">New Fellow</span>
                <% } %>
              </div>

              <!-- Rating Star Cluster & Review Count (Only if real reviews exist) -->
              <div class="flex items-center gap-1.5 text-xs min-h-[1.25rem]">
                <% if (hasReviews) { %>
                  <div class="flex items-center text-amber-400" aria-label="<%= ratingVal %> out of 5 stars">
                    <% const fullStars = Math.floor(Number(ratingVal)); %>
                    <% for (let s = 0; s < 5; s++) { %>
                      <svg class="w-3.5 h-3.5 <%= s < fullStars ? 'fill-amber-400 text-amber-400' : 'fill-slate-200 text-slate-300 dark:fill-zinc-700 dark:text-zinc-600' %>" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    <% } %>
                  </div>
                  <span class="font-bold text-[var(--text-ink)] text-xs tabular-nums"><%= ratingVal %></span>
                  <span class="text-[var(--text-muted)] text-[11px]">(<%= reviewsCount %> <%= reviewsCount === 1 ? 'review' : 'reviews' %>)</span>
                <% } else { %>
                  <span class="text-[var(--text-muted)] text-xs italic">No client reviews yet</span>
                <% } %>
              </div>

              <!-- Editor Bio -->
              <p class="type-small text-[var(--text-muted)] line-clamp-2 leading-relaxed">
                <%= writer.bio || 'Experienced editor specializing in document structure, clarity, grammar polish, and reference formatting.' %>
              </p>
            </div>

            <!-- Rate & Action -->
            <div class="pt-4 border-t border-[var(--border-color)] flex items-center justify-between">
              <div>
                <span class="text-xs text-[var(--text-muted)] block">Rate</span>
                <span class="text-sm font-semibold text-[var(--text-ink)] font-mono tabular-nums">
                  <%= writer.pricePerPage ? ('₹' + writer.pricePerPage + ' / page') : 'Rates on profile' %>
                </span>
              </div>
              <a href="/writers/<%= writer._id %>" class="btn btn-secondary btn-sm">
                View profile
                <%- icon('arrow-right', { class: 'w-3.5 h-3.5' }) %>
              </a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <!-- Empty State Fallback -->
      <div class="empty-state">
        <div class="max-w-md mx-auto space-y-3">
          <div class="w-10 h-10 rounded-full bg-[var(--bg-surface)] border border-[var(--border-color)] mx-auto flex items-center justify-center text-[var(--text-muted)]">
            <%- icon('user', { class: 'w-5 h-5' }) %>
          </div>
          <h3 class="type-h4 text-base">No editors registered yet</h3>
          <p class="type-small text-[var(--text-muted)]">
            Be the first freelance editor to join PerPage, establish your per-page rate, and receive editing requests.
          </p>
          <div class="pt-2">
            <a href="/register" class="btn btn-primary btn-sm">
              Become the first editor
              <%- icon('arrow-right', { class: 'w-3.5 h-3.5' }) %>
            </a>
          </div>
        </div>
      </div>
    <% } %>
  </section>


