  <script nonce="<%= locals.cspNonce || '' %>">
    function howItWorksComponent() {
      return {
        activeStep: 1,
        timer: null,
        init() {
          this.startAutoSwitch();
        },
        startAutoSwitch() {
          if (this.timer) clearInterval(this.timer);
          this.timer = setInterval(() => {
            this.activeStep = this.activeStep === 3 ? 1 : (this.activeStep + 1);
          }, 6000);
        },
        setStep(s) {
          this.activeStep = s;
          this.startAutoSwitch();
        }
      };
    }
  </script>

