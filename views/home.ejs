  <!-- Interactive Spline 3D Scene Initialization with Session-Aware One-Time Entrance Animation -->
  <script type="module" nonce="<%= locals.cspNonce || '' %>">
    (async function() {
      const stage = document.querySelector('.hero-3d-stage');
      const canvas = document.getElementById('hero-spline-canvas');
      const fallbackImg = document.getElementById('hero-laptop-fallback');
      if (!stage || !canvas) return;

      // Check if user has already seen the 3D laptop animation in this session
      let hasAnimated = false;
      try {
        hasAnimated = sessionStorage.getItem('perpage_laptop_seen') === '1';
      } catch (_) {}

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Only trigger the entrance animation on the user's FIRST load of the website
      if (!hasAnimated && !prefersReducedMotion) {
        stage.classList.add('hero-anim-first-load');
        try {
          sessionStorage.setItem('perpage_laptop_seen', '1');
        } catch (_) {}
      }

      try {
        // Dynamically load Spline runtime and local binary scene data
        const [{ Application }, { sceneData }] = await Promise.all([
          import('https://cdn.spline.design/@splinetool/runtime@2.0.79/build/runtime.js'),
          import('/js/spline-data.js')
        ]);

        const app = new Application(canvas);
        window.__splineApp = app;

        await app.start(sceneData);

        // 1. Remove internal 3D floor backdrop for seamless page integration
        const backdrop = app.findObjectByName('Backdrop');
        if (backdrop) backdrop.visible = false;

        // 2. Set clear alpha to 0 for native light & dark mode background transparency
        if (typeof app.setBackgroundColor === 'function') {
          app.setBackgroundColor('rgba(0, 0, 0, 0)');
        }
        if (app._scene) {
          app._scene.background = null;
          if (app._scene.activePage) app._scene.activePage.background = null;
        }
        if (app._renderer) {
          if (app._renderer.setClearAlpha) app._renderer.setClearAlpha(0);
          if (app._renderer.setClearColor) app._renderer.setClearColor(0x000000, 0);
        }

        // 3. Reveal canvas and sync with fallback artwork
        canvas.classList.add('loaded');
        if (fallbackImg) {
          setTimeout(() => {
            fallbackImg.style.opacity = '0';
          }, 350);
        }

        // 4. Trigger the laptop open animation ONLY on first visit; keep open on subsequent navigations
        if (!hasAnimated && !prefersReducedMotion) {
          setTimeout(() => {
            ['Laptop', 'OPEN LAPTOP', 'Laptop with keyboard'].forEach(name => {
              try { app.emitEvent('mouseDown', name); } catch (_) {}
              try { app.emitEvent('click', name); } catch (_) {}
            });
          }, 350);
        } else {
          // Immediately place laptop into open resting state without replaying the slow sequence
          ['Laptop', 'OPEN LAPTOP', 'Laptop with keyboard'].forEach(name => {
            try { app.emitEvent('mouseDown', name); } catch (_) {}
          });
        }
      } catch (err) {
        // Fallback: If Spline CDN is blocked or unavailable, the high-res 3D artwork is already visible
        console.info('3D Spline fallback active; retaining high-resolution artwork');
        if (canvas) canvas.remove();
      }
    })();
  </script>

  <!-- Subtle Mouse Parallax for 3D Hero Artwork -->
  <script nonce="<%= locals.cspNonce || '' %>">
    (function() {
      try {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (window.innerWidth < 1024) return;
        
        const el = document.querySelector('.hero-artwork-interactive');
        if (!el) return;

        let targetX = 0, targetY = 0, curX = 0, curY = 0;
        let rafId = null;

        window.addEventListener('pointermove', function(e) {
          const cx = window.innerWidth / 2;
          const cy = window.innerHeight / 2;
          targetX = ((e.clientX - cx) / cx) * 10;
          targetY = ((e.clientY - cy) / cy) * 8;
        }, { passive: true });

        function tick() {
          curX += (targetX - curX) * 0.06;
          curY += (targetY - curY) * 0.06;
          el.style.setProperty('--parallax-x', curX.toFixed(2) + 'px');
          el.style.setProperty('--parallax-y', curY.toFixed(2) + 'px');
          rafId = requestAnimationFrame(tick);
        }
        rafId = requestAnimationFrame(tick);
      } catch (_) {}
    })();
  </script>

  <!-- Red Wavy Underline Animation Trigger -->
  <script nonce="<%= locals.cspNonce || '' %>">
    (function() {
      const wavy = document.querySelector('.proof-wavy-hero path');
      if (wavy) {
        setTimeout(function() {
          wavy.style.transition = 'stroke-dashoffset 0.85s cubic-bezier(0.16, 1, 0.3, 1)';
          wavy.style.strokeDashoffset = '0';
        }, 150);
      }
    })();
  </script>

  <!-- =========================================================================
