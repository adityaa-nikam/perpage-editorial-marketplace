            </span>
            <div class="flex items-center gap-2">
              <span class="badge badge-neutral text-[10px]">Sample</span>
              <!-- Mini 3-step progress dots -->
              <div class="flex items-center gap-1.5 ml-1" role="tablist" aria-label="Step indicator">
                <button 
                  type="button" 
                  @click.stop="setStep(1)" 
                  class="h-1.5 rounded-full transition-all duration-300 focus:outline-none cursor-pointer"
                  :class="activeStep === 1 ? 'w-5 bg-[var(--accent)]' : 'w-2 bg-[var(--border-strong)] hover:bg-[var(--text-muted)]'"
                  aria-label="Go to step 1"
                ></button>
                <button 
                  type="button" 
                  @click.stop="setStep(2)" 
                  class="h-1.5 rounded-full transition-all duration-300 focus:outline-none cursor-pointer"
                  :class="activeStep === 2 ? 'w-5 bg-[var(--accent)]' : 'w-2 bg-[var(--border-strong)] hover:bg-[var(--text-muted)]'"
                  aria-label="Go to step 2"
                ></button>
                <button 
                  type="button" 
                  @click.stop="setStep(3)" 
                  class="h-1.5 rounded-full transition-all duration-300 focus:outline-none cursor-pointer"
                  :class="activeStep === 3 ? 'w-5 bg-[var(--accent)]' : 'w-2 bg-[var(--border-strong)] hover:bg-[var(--text-muted)]'"
                  aria-label="Go to step 3"
                ></button>
              </div>
            </div>
          </div>

          <!-- Relative Container for silky-smooth cross-fade with no layout shift -->
          <div class="relative min-h-[190px]">
            
            <!-- Preview State 1: Browse Profile -->
            <div 
              x-show="activeStep === 1" 
              x-transition:enter="transition ease-out duration-300 transform"
              x-transition:enter-start="opacity-0 translate-y-2 scale-[0.99]"
              x-transition:enter-end="opacity-100 translate-y-0 scale-100"
              x-transition:leave="transition ease-in duration-200 transform absolute inset-0 pointer-events-none"
              x-transition:leave-start="opacity-100 translate-y-0 scale-100"
              x-transition:leave-end="opacity-0 -translate-y-2 scale-[0.99]"
              class="space-y-4"
            >
              <div class="flex items-center gap-3">
                <div class="avatar avatar-md">AS</div>
                <div>
                  <div class="font-semibold text-[var(--text-ink)] text-sm">Ananya Sharma</div>
                  <div class="text-xs text-[var(--text-muted)]">Freelance Academic &amp; Technical Editor</div>
                </div>
              </div>
              <p class="text-xs text-[var(--text-muted)] leading-relaxed">
                Specializing in document structure, clarity, grammar polish, and reference formatting with consistent per-page pricing.
              </p>
              <div class="p-3 rounded-md bg-[var(--bg-surface-muted)] border border-[var(--border-color)] flex items-center justify-between">
                <span class="text-xs text-[var(--text-muted)]">Fixed Rate</span>
                <span class="font-mono text-xs font-bold text-[var(--text-ink)] tabular-nums">₹45 / page</span>
              </div>
            </div>

            <!-- Preview State 2: Create Deal & Upload -->
            <div 
              x-show="activeStep === 2" 
              x-transition:enter="transition ease-out duration-300 transform"
              x-transition:enter-start="opacity-0 translate-y-2 scale-[0.99]"
              x-transition:enter-end="opacity-100 translate-y-0 scale-100"
              x-transition:leave="transition ease-in duration-200 transform absolute inset-0 pointer-events-none"
              x-transition:leave-start="opacity-100 translate-y-0 scale-100"
              x-transition:leave-end="opacity-0 -translate-y-2 scale-[0.99]"
              class="space-y-4"
              x-cloak
            >
              <div class="space-y-1">
                <div class="text-sm font-semibold text-[var(--text-ink)]">Commission Request</div>
                <div class="text-xs text-[var(--text-muted)]">Report draft submission</div>
              </div>
              <div class="p-4 rounded-md border border-dashed border-[var(--border-strong)] bg-[var(--bg-surface-muted)] flex items-center justify-between text-xs">
                <div class="flex items-center gap-2.5 truncate">
                  <%- icon('file-text', { class: 'w-4 h-4 text-[var(--accent)] shrink-0' }) %>
                  <span class="font-mono text-xs text-[var(--text-ink)] truncate">report-draft.pdf</span>
                </div>
                <span class="text-[11px] text-[var(--text-muted)] shrink-0">1.8 MB</span>
              </div>
              <div class="p-3 rounded-md bg-[var(--bg-surface-muted)] border border-[var(--border-color)] flex items-center justify-between">
                <span class="text-xs text-[var(--text-muted)]">Calculated Total (12 pgs × ₹45)</span>
                <span class="font-mono text-xs font-bold text-[var(--text-ink)] tabular-nums">₹540</span>
              </div>
            </div>

            <!-- Preview State 3: Tracked Delivery -->
            <div 
              x-show="activeStep === 3" 
              x-transition:enter="transition ease-out duration-300 transform"
              x-transition:enter-start="opacity-0 translate-y-2 scale-[0.99]"
              x-transition:enter-end="opacity-100 translate-y-0 scale-100"
              x-transition:leave="transition ease-in duration-200 transform absolute inset-0 pointer-events-none"
              x-transition:leave-start="opacity-100 translate-y-0 scale-100"
              x-transition:leave-end="opacity-0 -translate-y-2 scale-[0.99]"
              class="space-y-4"
              x-cloak
            >
              <div class="flex items-center justify-between">
                <div class="text-sm font-semibold text-[var(--text-ink)]">Delivery Completed</div>
                <span class="badge badge-success text-[10px] font-mono">DELIVERED</span>
              </div>
              <div class="p-3.5 rounded-md bg-[var(--bg-surface-muted)] border border-[var(--border-color)] space-y-2 text-xs">
                <div class="flex items-center justify-between font-medium text-[var(--text-ink)]">
                  <span>Edited document &amp; feedback attached</span>
                  <span class="text-[var(--semantic-success-text)]">Ready</span>
                </div>
                <div class="flex items-center gap-2 text-[var(--accent)] font-medium">
                  <%- icon('download', { class: 'w-3.5 h-3.5 shrink-0' }) %>
                  <span class="font-mono text-[11px]">report-draft-edited.pdf</span>
                </div>
              </div>
              <div class="text-[11px] text-[var(--text-muted)]">
                Files are shared through private time-limited download links from your dashboard.
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </section>


