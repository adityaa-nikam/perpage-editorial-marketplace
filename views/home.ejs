  <!-- Glyph Portal Interactive Controller Script -->
  <script nonce="<%= locals.cspNonce || '' %>">
    (function() {
      const section = document.getElementById('gp-perpage-hero');
      if (!section) return;

      const pin = section.querySelector('[data-gp-pin]');
      const field = section.querySelector('[data-gp-field]');
      const art = section.querySelector('[data-gp-art]');
      const clip = section.querySelector('#gp-perpage-clip');
      const glyph = section.querySelector('[data-gp-glyph]');
      const marks = section.querySelector('[data-gp-marks]');
      const choices = section.querySelector('[data-gp-choices]');
      const buttons = Array.from(choices ? choices.querySelectorAll('button') : []);
      const picker = section.querySelector('[data-gp-select]');
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

      const text = 'perpage';
      const clamp = (n, a = 0, b = 1) => Math.min(b, Math.max(a, n));
      const smooth = (a, b, n) => {
        const t = clamp((n - a) / (b - a));
        return t * t * (3 - 2 * t);
      };

      const canvas = document.createElement('canvas');
      const context = canvas.getContext('2d', { willReadFrequently: true });
      if (!context) return;

      function interior(ctx, char, font) {
        const cvs = ctx.canvas;
        ctx.font = font;
        const m = ctx.measureText(char);
        const pad = 8;
        const left = Math.ceil(m.actualBoundingBoxLeft || 0);
        const ascent = Math.ceil(m.actualBoundingBoxAscent || 0);
        cvs.width = Math.max(1, Math.ceil((m.actualBoundingBoxLeft || 0) + (m.actualBoundingBoxRight || 0)) + pad * 2);
        cvs.height = Math.max(1, Math.ceil((m.actualBoundingBoxAscent || 0) + (m.actualBoundingBoxDescent || 0)) + pad * 2);
        ctx.font = font;
        ctx.fontKerning = 'none';
        ctx.fillText(char, pad + left, pad + ascent);
        const { width, height } = cvs;
        const pixels = ctx.getImageData(0, 0, width, height).data;
        const rows = new Uint16Array(width + 1);
        let size = 0, bx = 0, by = 0;
        for (let y = 0; y < height; y++) {
          let diagonal = 0;
          for (let x = 0; x < width; x++) {
            const above = rows[x + 1];
            rows[x + 1] = pixels[(y * width + x) * 4 + 3] > 245
              ? Math.min(above, rows[x], diagonal) + 1 : 0;
            diagonal = above;
            if (rows[x + 1] > size) { size = rows[x + 1]; bx = x; by = y; }
          }
        }
        if (size < 3) return null;
        return {
          x: (bx + 1 - size / 2 - pad - left) / 3,
          y: (by + 1 - size / 2 - pad - ascent) / 3,
          radius: (size / 2 - 1) / 3
        };
      }

      let disposed = false, raf = 0, dirty = true, active = true, ready = false;
      const mountedAt = performance.now();
      let browserFrameSeen = false, stalled = false;
      let W = 1, H = 1, travel = 1, startScale = 1, endScale = 1;
      let center = { x: 0, y: 0 }, target = null;
      let candidates = [], letters = [];
      let choosing = false;
      let bounds = { x: 0, y: 0, width: 1, height: 1 };
      const length = 2.2;

      function readInk() {
        const font = window.getComputedStyle(glyph);
        const scanFont = `${font.fontWeight || 900} 300px ${font.fontFamily}`;
        context.font = `${font.fontWeight || 900} 100px ${font.fontFamily}`;
        context.fontKerning = 'none';
        const metrics = context.measureText(text);
        const advances = Array.from({ length: text.length }, (_, i) => context.measureText(text.slice(0, i)).width);
        bounds = {
          x: -metrics.actualBoundingBoxLeft,
          y: -metrics.actualBoundingBoxAscent,
          width: metrics.actualBoundingBoxLeft + metrics.actualBoundingBoxRight,
          height: metrics.actualBoundingBoxAscent + metrics.actualBoundingBoxDescent
        };
        if (!bounds.width || !bounds.height) return false;
        center = { x: bounds.x + bounds.width / 2, y: bounds.y + bounds.height / 2 };

        let offset = 0;
        candidates = []; letters = [];
        for (const char of Array.from(text)) {
          context.font = `${font.fontWeight || 900} 100px ${font.fontFamily}`;
          const m = context.measureText(char);
          letters.push({
            index: offset,
            x: advances[offset] - m.actualBoundingBoxLeft,
            y: -m.actualBoundingBoxAscent,
            width: m.actualBoundingBoxLeft + m.actualBoundingBoxRight,
            height: m.actualBoundingBoxAscent + m.actualBoundingBoxDescent
          });
          const found = interior(context, char, scanFont);
          if (found) candidates.push({ ...found, x: found.x + advances[offset], index: offset });
          offset += char.length;
        }
        target = candidates.find(c => c.index === 0) || candidates[0] || null;
        return true;
      }

      function select(next) {
        target = next;
        endScale = target ? Math.max(startScale, Math.hypot(W, H) / (target.radius * 1.35)) : startScale;
        section.dataset.gpFocus = target ? Array.from(text.slice(target.index))[0] : "";
        section.dataset.gpFocusIndex = String(target ? target.index : -1);
        for (const button of buttons) {
          const selected = Number(button.dataset.gpLetter) === target?.index;
          button.disabled = !candidates.some(c => c.index === Number(button.dataset.gpLetter));
          button.setAttribute("aria-checked", String(selected));
          button.tabIndex = selected ? 0 : -1;
        }
        if (picker && picker.value !== "") picker.value = String(target?.index ?? -1);
      }

      function position() {
        return clamp(-section.getBoundingClientRect().top / travel);
      }

      let audioCtx = null;
      let cachedNoiseBuffer = null;
      let soundTriggered = false;
      let lastSoundTime = 0;

      function getAudioContext() {
        if (!audioCtx) {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (AudioContextClass) {
            audioCtx = new AudioContextClass();
          }
        }
        return audioCtx;
      }

      function ensureAudioReady() {
        const ctx = getAudioContext();
        if (ctx) {
          if (ctx.state === 'suspended') {
            ctx.resume().catch(() => {});
          }
          if (!cachedNoiseBuffer) {
            try {
              const bufferSize = Math.floor(ctx.sampleRate * 2.5);
              cachedNoiseBuffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
              const output = cachedNoiseBuffer.getChannelData(0);
              let b0 = 0, b1 = 0, b2 = 0;
              for (let i = 0; i < bufferSize; i++) {
                const white = Math.random() * 2 - 1;
                b0 = 0.997 * b0 + white * 0.05;
                b1 = 0.985 * b1 + white * 0.11;
                b2 = 0.950 * b2 + white * 0.25;
                output[i] = (b0 + b1 + b2) * 0.24;
              }
            } catch (e) {}
          }
        }
      }

      // Pre-warm audio immediately on first user gesture so playback has 0ms latency
      ['pointerdown', 'touchstart', 'scroll', 'keydown', 'wheel'].forEach(evt => {
        window.addEventListener(evt, ensureAudioReady, { once: true, passive: true });
      });

      function playPremiumZoomSound() {
        if (motion.matches) return;
        const now = Date.now();
        if (now - lastSoundTime < 2500) return; // 2.5s cooldown
        lastSoundTime = now;

        ensureAudioReady();
        const ctx = getAudioContext();
        if (!ctx) return;

        try {
          const t0 = ctx.currentTime;
          const duration = 2.4; // 2.4 seconds

          // Master Gain - Fast crisp attack (< 50ms) to eliminate audio lag!
          const masterGain = ctx.createGain();
          masterGain.gain.setValueAtTime(0.0001, t0);
          masterGain.gain.exponentialRampToValueAtTime(0.24, t0 + 0.05);
          masterGain.gain.linearRampToValueAtTime(0.26, t0 + 0.5);
          masterGain.gain.exponentialRampToValueAtTime(0.0001, t0 + duration);
          masterGain.connect(ctx.destination);

          // 1. Instant Deep Sub-Bass Swell (hits immediately with the visual zoom)
          const subOsc = ctx.createOscillator();
          subOsc.type = 'sine';
          subOsc.frequency.setValueAtTime(45, t0);
          subOsc.frequency.exponentialRampToValueAtTime(95, t0 + 0.5);
          subOsc.frequency.linearRampToValueAtTime(50, t0 + duration);

          const subGain = ctx.createGain();
          subGain.gain.setValueAtTime(0.0001, t0);
          subGain.gain.exponentialRampToValueAtTime(0.7, t0 + 0.06);
          subGain.gain.exponentialRampToValueAtTime(0.0001, t0 + duration);

          subOsc.connect(subGain);
          subGain.connect(masterGain);
          subOsc.start(t0);
          subOsc.stop(t0 + duration);

          // 2. Warm Cinematic Harmonic Body (120Hz -> 180Hz)
          const midOsc = ctx.createOscillator();
          midOsc.type = 'triangle';
          midOsc.frequency.setValueAtTime(120, t0);
          midOsc.frequency.exponentialRampToValueAtTime(180, t0 + 0.45);

          const midFilter = ctx.createBiquadFilter();
          midFilter.type = 'lowpass';
          midFilter.frequency.setValueAtTime(220, t0);
          midFilter.frequency.exponentialRampToValueAtTime(750, t0 + 0.4);
          midFilter.frequency.exponentialRampToValueAtTime(140, t0 + duration);

          const midGain = ctx.createGain();
          midGain.gain.setValueAtTime(0.0001, t0);
          midGain.gain.exponentialRampToValueAtTime(0.35, t0 + 0.06);
          midGain.gain.exponentialRampToValueAtTime(0.0001, t0 + duration);

          midOsc.connect(midFilter);
          midFilter.connect(midGain);
          midGain.connect(masterGain);
          midOsc.start(t0);
          midOsc.stop(t0 + duration);

          // 3. Crisp Airy Rush Whoosh (using pre-cached noise buffer - 0ms CPU latency!)
          if (cachedNoiseBuffer) {
            const noiseSource = ctx.createBufferSource();
            noiseSource.buffer = cachedNoiseBuffer;

            const noiseFilter = ctx.createBiquadFilter();
            noiseFilter.type = 'bandpass';
            noiseFilter.Q.value = 1.4;
            noiseFilter.frequency.setValueAtTime(280, t0);
            noiseFilter.frequency.exponentialRampToValueAtTime(1350, t0 + 0.45);
            noiseFilter.frequency.exponentialRampToValueAtTime(260, t0 + duration);

            const noiseGain = ctx.createGain();
            noiseGain.gain.setValueAtTime(0.0001, t0);
            noiseGain.gain.exponentialRampToValueAtTime(0.45, t0 + 0.05);
            noiseGain.gain.exponentialRampToValueAtTime(0.0001, t0 + duration);

            noiseSource.connect(noiseFilter);
            noiseFilter.connect(noiseGain);
            noiseGain.connect(masterGain);
            noiseSource.start(t0);
            noiseSource.stop(t0 + duration);
          }

        } catch (err) {
          // Graceful fallback
        }
      }

      function paint(progress) {
        const isStatic = motion.matches || !browserFrameSeen || stalled || !target;
        const p = isStatic ? 0 : progress;
        const t = clamp(p / 0.78);
        const eased = t < 0.5 ? 4 * Math.pow(t, 3) : 1 - Math.pow(-2 * t + 2, 3) / 2;
        const scale = Math.exp(Math.log(startScale) + Math.log(endScale / startScale) * eased);
        const blend = endScale === startScale ? 0 : (1 / scale - 1 / startScale) / (1 / endScale - 1 / startScale);
        const cx = center.x + ((target?.x ?? center.x) - center.x) * blend;
        const cy = center.y + ((target?.y ?? center.y) - center.y) * blend;
        const roll = -4 * smooth(0.06, 0.5, t) * (1 - smooth(0.62, 0.92, t));
        const radians = roll * Math.PI / 180;
        const dx = W / 2 / scale, dy = (H * 0.46 + H * 0.04 * eased) / scale;

        if (clip) clip.setAttribute("transform", `scale(${scale}) rotate(${roll})`);
        if (glyph) glyph.setAttribute("transform", `translate(${Math.cos(radians) * dx + Math.sin(radians) * dy - cx} ${-Math.sin(radians) * dx + Math.cos(radians) * dy - cy})`);
        if (marks) {
          marks.setAttribute("transform", `translate(${W / 2} ${H * 0.46 + H * 0.04 * eased}) scale(${scale}) rotate(${roll}) translate(${-cx} ${-cy})`);
          marks.style.opacity = String(1 - smooth(0.015, 0.17, p));
        }
        choosing = !isStatic && p < 0.04;
        if (choices) choices.inert = !choosing;
        section.dataset.gpChoosing = String(choosing);
        if (field) {
          field.style.clipPath = t >= 1 ? "none" : "url(#gp-perpage-clip)";
          field.style.opacity = isStatic ? "0" : String(t >= 1 ? Math.max(0, 1 - smooth(0.78, 0.95, p)) : 1);
        }
        section.style.setProperty("--gp-caption", String(1 - smooth(0.01, 0.16, p)));
        section.style.setProperty("--gp-reveal", String(isStatic ? 1 : smooth(0.78, 0.9, p)));
        section.style.setProperty("--gp-field-scale", String(1 + 0.16 * smooth(0, 0.82, p)));
        section.style.setProperty("--gp-caption-hit", p < 0.08 ? "auto" : "none");
        section.dataset.gpEntered = String(p >= 0.9);

        // Play premium zoom-in sound effect instantly as the camera begins expanding through the letter
        if (!soundTriggered && p > 0.015 && p < 0.75) {
          soundTriggered = true;
          playPremiumZoomSound();
        } else if (p < 0.005 || p > 0.92) {
          soundTriggered = false;
        }

        // Real-time scroll-driven drawing of the red proofreader underline
        const heroWavyPath = section.querySelector('.proof-wavy-hero path');
        if (heroWavyPath) {
          if (isStatic) {
            heroWavyPath.style.strokeDashoffset = '0';
          } else if (p < 0.74) {
            heroWavyPath.style.strokeDashoffset = '100';
          } else if (p >= 0.74 && p <= 0.94) {
            const drawT = (p - 0.74) / 0.20;
            heroWavyPath.style.strokeDashoffset = String(Math.max(0, Math.min(100, Math.round((1 - drawT) * 100))));
          } else {
            heroWavyPath.style.strokeDashoffset = '0';
          }
        }

      }

      function layout() {
        if (!section.clientWidth) return;
        W = pin.clientWidth;
        const viewportProbe = section.querySelector("[data-gp-viewport]");
        const smallViewport = viewportProbe ? viewportProbe.offsetHeight : window.innerHeight;
        const viewportHeight = Math.max(1, Math.min(window.innerHeight, smallViewport));
        H = motion.matches ? Math.min(viewportHeight * 0.75, 480) : viewportHeight;
        section.style.setProperty("--gp-height", `${H}px`);
        travel = H * length;
        if (art) art.setAttribute("viewBox", `0 0 ${W} ${H}`);
        if (!ready) { ready = readInk(); }
        if (!ready) return;
        const wordHeight = H * 0.32;
        startScale = Math.min(W * 0.72 / bounds.width, wordHeight / bounds.height);
        select(target);
        for (const button of buttons) {
          const letter = letters.find(item => item.index === Number(button.dataset.gpLetter));
          if (letter) {
            Object.assign(button.style, {
              left: `${W / 2 + (letter.x - center.x) * startScale}px`,
              top: `${H * 0.46 + (letter.y - center.y) * startScale - Math.max(0, 44 - letter.height * startScale) / 2}px`,
              width: `${Math.max(1, letter.width * startScale)}px`,
              height: `${Math.max(44, letter.height * startScale)}px`
            });
          }
        }
        section.style.setProperty("--gp-word-top", `${H * 0.46 - bounds.height * startScale / 2}px`);
        section.style.setProperty("--gp-word-bottom", `${H * 0.46 + bounds.height * startScale / 2}px`);
        section.dataset.gpReady = "true";
        section.dataset.gpMotion = !motion.matches && browserFrameSeen && !stalled && target ? "on" : "off";
      }

      function frame(time) {
        raf = 0;
        if (disposed) return;
        if (time !== undefined && !browserFrameSeen) {
          browserFrameSeen = true;
          stalled = (performance.now() - mountedAt > 2500);
          dirty = true;
        }
        if (dirty) { dirty = false; layout(); }
        if (ready) paint(position());
      }

      function schedule() { if (!raf && active) raf = requestAnimationFrame(frame); }
      function resize() { cancelAnimationFrame(raf); dirty = true; frame(); }
      function scroll() { schedule(); }

      function choose(event) {
        if (!choosing || position() >= 0.04) return;
        const button = event.target.closest("[data-gp-letter]");
        const next = candidates.find(c => c.index === Number(button?.dataset.gpLetter));
        if (!next || next === target) return;
        playPremiumZoomSound();
        select(next); paint(position());
      }

      if (choices) {
        choices.addEventListener("pointerover", choose);
        choices.addEventListener("click", choose);
      }
      const enterLink = section.querySelector("[data-gp-enter]");
      if (enterLink) {
        enterLink.addEventListener("click", () => {
          playPremiumZoomSound();
        });
      }
      if (picker) {
        picker.addEventListener("change", () => {
          if (!choosing || position() >= 0.04) return;
          const next = candidates.find(c => c.index === Number(picker.value));
          if (next) { playPremiumZoomSound(); select(next); paint(position()); }
        });
      }

      const observer = new ResizeObserver(resize);
      observer.observe(section);

      const visibility = new IntersectionObserver(([entry]) => {
        active = entry.isIntersecting;
        if (active) { dirty = true; schedule(); }
        else if (raf) { cancelAnimationFrame(raf); raf = 0; }
      }, { rootMargin: "100% 0px" });
      visibility.observe(section);

      window.addEventListener("scroll", scroll, { passive: true });
      window.addEventListener("resize", resize);
      motion.addEventListener("change", resize);

      // Observe all wavy underlines across the page (hero and bottom CTA)
      // When scrolled into view, smoothly draw the red pen stroke
      const allWavyElements = document.querySelectorAll('.proof-wavy-hero');
      if (allWavyElements.length && 'IntersectionObserver' in window) {
        const wavyScrollObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            const path = entry.target.querySelector('path');
            if (!path) return;
            if (entry.isIntersecting) {
              if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                path.style.transition = 'stroke-dashoffset 0.85s cubic-bezier(0.16, 1, 0.3, 1)';
                path.style.strokeDashoffset = '0';
              } else {
                path.style.strokeDashoffset = '0';
              }
            } else {
              // Reset when scrolled above/below viewport so re-entering draws it again
              if (entry.boundingClientRect.top > window.innerHeight || entry.boundingClientRect.bottom < 0) {
                path.style.transition = 'none';
                path.style.strokeDashoffset = '100';
              }
            }
          });
        }, { threshold: 0.15 });

        allWavyElements.forEach(el => wavyScrollObserver.observe(el));
      }

      frame();
      schedule();
    })();
  </script>


