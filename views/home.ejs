                  <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
                  Active Step
                </span>
              </div>
              <p 
                class="type-small leading-relaxed prose-measure transition-colors duration-200"
                :class="activeStep === 3 ? 'text-[var(--text-ink)]' : 'text-[var(--text-muted)]'"
              >
                Once the editor delivers, download your edited draft and feedback from your dashboard.
              </p>

              <!-- Mobile/Fallback Vignette 3 -->
              <div class="lg:hidden mt-4 p-3 rounded-md bg-[var(--bg-surface-muted)] border border-[var(--border-color)] flex items-center justify-between">
