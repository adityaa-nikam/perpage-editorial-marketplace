<%
  const activePath = typeof currentPath !== 'undefined' ? currentPath : '';
  const currentUser = typeof user !== 'undefined' && user ? user : null;

  function isActive(path) {
    if (path === '/' || path === '/home') {
      return activePath === '/' || activePath === '/home';
    }
    return activePath.startsWith(path);
  }

  function getInitials(name) {
    if (!name) return 'U';
    const parts = name.trim().split(' ');
    if (parts.length >= 2) {
      return (parts[0][0] + parts[1][0]).toUpperCase();
    }
    return name.slice(0, 2).toUpperCase();
  }
%>

<header 
  x-data="{ 
    mobileMenuOpen: false,
    userDropdownOpen: false,
    isDark: document.documentElement.classList.contains('dark'),
    toggleTheme() {
      this.isDark = !this.isDark;
      if (this.isDark) {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      } else {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      }
    }
  }"
  class="sticky top-0 z-40 w-full h-16 bg-[var(--bg-surface)] border-b border-[var(--border-color)] transition-colors duration-150"
>
  <div class="max-w-6xl mx-auto h-full px-4 sm:px-6 lg:px-8 flex items-center justify-between">
    <!-- Brand Wordmark -->
    <div class="flex items-center gap-8">
      <a href="/home" class="group flex items-center gap-2 text-decoration-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] rounded-sm">
        <span class="w-6 h-6 rounded-md bg-[var(--text-ink)] text-[var(--bg-surface)] flex items-center justify-center font-serif-display font-bold text-sm tracking-tighter">
          P
        </span>
        <span class="font-serif-display text-xl sm:text-2xl text-[var(--text-ink)] tracking-tight font-normal">
          PerPage<span class="text-[var(--accent)] font-sans text-xs ml-0.5 font-bold">.</span>
        </span>
      </a>

      <!-- Desktop Center Navigation -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Main Navigation">
        <a 
          href="/home" 
          class="px-3 py-1.5 text-sm font-medium rounded-md transition-colors duration-150 <%= isActive('/home') ? 'text-[var(--accent)] bg-[var(--accent-subtle)]' : 'text-[var(--text-muted)] hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-muted)]' %>"
        >
          Home
        </a>
        <a 
          href="/writers" 
          class="px-3 py-1.5 text-sm font-medium rounded-md transition-colors duration-150 <%= isActive('/writers') ? 'text-[var(--accent)] bg-[var(--accent-subtle)]' : 'text-[var(--text-muted)] hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-muted)]' %>"
        >
          Writers
        </a>
        <a 
          href="/about" 
          class="px-3 py-1.5 text-sm font-medium rounded-md transition-colors duration-150 <%= isActive('/about') ? 'text-[var(--accent)] bg-[var(--accent-subtle)]' : 'text-[var(--text-muted)] hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-muted)]' %>"
        >
          About
        </a>
        <% if (currentUser) { %>
          <a 
            href="/dashboard" 
            class="px-3 py-1.5 text-sm font-medium rounded-md transition-colors duration-150 <%= isActive('/dashboard') ? 'text-[var(--accent)] bg-[var(--accent-subtle)]' : 'text-[var(--text-muted)] hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-muted)]' %>"
          >
            Dashboard
          </a>
        <% } %>
      </nav>
    </div>

    <!-- Desktop Right Controls -->
    <div class="hidden md:flex items-center gap-3">
      <!-- Theme Toggle -->
      <button 
        type="button" 
        @click="toggleTheme()"
        class="w-9 h-9 rounded-md border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-muted)] flex items-center justify-center transition-colors duration-150 cursor-pointer"
        aria-label="Toggle color theme"
      >
        <span x-show="!isDark" class="flex items-center justify-center">
          <%- icon('moon', { class: 'w-4 h-4' }) %>
        </span>
        <span x-show="isDark" class="flex items-center justify-center" style="display: none;">
          <%- icon('sun', { class: 'w-4 h-4' }) %>
        </span>
      </button>

      <% if (currentUser) { %>
        <!-- User Avatar Dropdown -->
        <div class="relative" @keydown.escape="userDropdownOpen = false">
          <button 
            type="button"
            @click="userDropdownOpen = !userDropdownOpen"
            class="flex items-center gap-2 pl-2 pr-3 py-1 rounded-full border border-[var(--border-color)] bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-muted)] transition-colors duration-150 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]"
            id="user-menu-button"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <div class="avatar avatar-sm">
              <% if (currentUser.profilePic) { %>
                <img src="<%= currentUser.profilePic %>" alt="<%= currentUser.name || 'User' %>" class="w-full h-full object-cover">
              <% } else { %>
                <span><%= getInitials(currentUser.name || currentUser.username) %></span>
              <% } %>
            </div>
            <span class="text-xs font-medium text-[var(--text-ink)] max-w-[120px] truncate">
              <%= currentUser.name || currentUser.username || 'Account' %>
            </span>
            <%- icon('chevron-down', { class: 'w-3 h-3 text-[var(--text-muted)]' }) %>
          </button>

          <!-- Dropdown Menu -->
          <div 
            x-show="userDropdownOpen"
            @click.away="userDropdownOpen = false"
            x-transition:enter="transition ease-out duration-100"
            x-transition:enter-start="transform opacity-0 scale-95"
            x-transition:enter-end="transform opacity-100 scale-100"
            x-transition:leave="transition ease-in duration-75"
            x-transition:leave-start="transform opacity-100 scale-100"
            x-transition:leave-end="transform opacity-0 scale-95"
            class="dropdown-menu"
            role="menu"
            aria-orientation="vertical"
            aria-labelledby="user-menu-button"
            style="display: none;"
          >
            <div class="px-3.5 py-2 border-b border-[var(--border-color)]">
              <p class="text-xs font-semibold text-[var(--text-ink)] truncate"><%= currentUser.name || 'User' %></p>
              <p class="text-[11px] text-[var(--text-muted)] truncate"><%= currentUser.email %></p>
              <div class="mt-1">
                <span class="badge badge-neutral text-[10px] py-0 px-1.5 capitalize"><%= currentUser.role || 'user' %></span>
              </div>
            </div>

            <div class="py-1">
              <a href="/dashboard" class="dropdown-item" role="menuitem">
                <%- icon('layout-dashboard', { class: 'w-4 h-4 text-[var(--text-muted)]' }) %>
                Dashboard
              </a>
              <a href="/profile/<%= currentUser._id %>" class="dropdown-item" role="menuitem">
                <%- icon('user', { class: 'w-4 h-4 text-[var(--text-muted)]' }) %>
                Your Profile
              </a>
              <% if (process.env.NODE_ENV !== 'production') { %>
                <a href="/styleguide" class="dropdown-item" role="menuitem">
                  <%- icon('file-text', { class: 'w-4 h-4 text-[var(--text-muted)]' }) %>
                  Dev Styleguide
                </a>
              <% } %>
            </div>

            <div class="border-t border-[var(--border-color)] pt-1">
              <a href="/logout" class="dropdown-item is-danger" role="menuitem">
                <%- icon('log-out', { class: 'w-4 h-4' }) %>
                Sign out
              </a>
            </div>
          </div>
        </div>
      <% } else { %>
        <!-- Logged Out Actions -->
        <a href="/login" class="px-3 py-1.5 text-sm font-medium text-[var(--text-muted)] hover:text-[var(--text-ink)] transition-colors duration-150">
          Log in
        </a>
        <a href="/register" class="btn btn-primary btn-sm">
          Get started
          <%- icon('arrow-right', { class: 'w-3.5 h-3.5' }) %>
        </a>
      <% } %>
    </div>

    <!-- Mobile Menu Trigger -->
    <div class="flex items-center gap-2 md:hidden">
      <button 
        type="button"
        @click="toggleTheme()"
        class="w-9 h-9 rounded-md border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-muted)] flex items-center justify-center cursor-pointer"
        aria-label="Toggle theme"
      >
        <span x-show="!isDark" class="flex items-center justify-center">
          <%- icon('moon', { class: 'w-4 h-4' }) %>
        </span>
        <span x-show="isDark" class="flex items-center justify-center" style="display: none;">
          <%- icon('sun', { class: 'w-4 h-4' }) %>
        </span>
      </button>

      <button 
        type="button" 
        @click="mobileMenuOpen = !mobileMenuOpen"
        class="w-9 h-9 rounded-md border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-ink)] flex items-center justify-center cursor-pointer"
        aria-label="Open mobile menu"
        :aria-expanded="mobileMenuOpen.toString()"
      >
        <span x-show="!mobileMenuOpen">
          <%- icon('menu', { class: 'w-5 h-5' }) %>
        </span>
        <span x-show="mobileMenuOpen" style="display: none;">
          <%- icon('x', { class: 'w-5 h-5' }) %>
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown / Sheet Navigation -->
  <div 
    x-show="mobileMenuOpen"
    x-transition:enter="transition ease-out duration-150"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-100"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2"
    @click.away="mobileMenuOpen = false"
    @keydown.escape="mobileMenuOpen = false"
    class="md:hidden border-b border-[var(--border-color)] bg-[var(--bg-surface)] px-4 pt-3 pb-6 space-y-3 shadow-lg"
    style="display: none;"
  >
    <nav class="flex flex-col gap-1" aria-label="Mobile Navigation">
      <a 
        href="/home" 
        class="px-3 py-2 text-sm font-medium rounded-md <%= isActive('/home') ? 'bg-[var(--accent-subtle)] text-[var(--accent)]' : 'text-[var(--text-ink)] hover:bg-[var(--bg-surface-muted)]' %>"
      >
        Home
      </a>
      <a 
        href="/writers" 
        class="px-3 py-2 text-sm font-medium rounded-md <%= isActive('/writers') ? 'bg-[var(--accent-subtle)] text-[var(--accent)]' : 'text-[var(--text-ink)] hover:bg-[var(--bg-surface-muted)]' %>"
      >
        Writers
      </a>
      <a 
        href="/about" 
        class="px-3 py-2 text-sm font-medium rounded-md <%= isActive('/about') ? 'bg-[var(--accent-subtle)] text-[var(--accent)]' : 'text-[var(--text-ink)] hover:bg-[var(--bg-surface-muted)]' %>"
      >
        About
      </a>
      <% if (currentUser) { %>
        <a 
          href="/dashboard" 
          class="px-3 py-2 text-sm font-medium rounded-md <%= isActive('/dashboard') ? 'bg-[var(--accent-subtle)] text-[var(--accent)]' : 'text-[var(--text-ink)] hover:bg-[var(--bg-surface-muted)]' %>"
        >
          Dashboard
        </a>
        <a 
          href="/profile/<%= currentUser._id %>" 
          class="px-3 py-2 text-sm font-medium rounded-md <%= isActive('/profile') ? 'bg-[var(--accent-subtle)] text-[var(--accent)]' : 'text-[var(--text-ink)] hover:bg-[var(--bg-surface-muted)]' %>"
        >
          Your Profile
        </a>
      <% } %>
    </nav>

    <div class="pt-3 border-t border-[var(--border-color)] flex flex-col gap-2">
      <% if (currentUser) { %>
        <div class="px-3 py-1 flex items-center justify-between text-xs text-[var(--text-muted)]">
          <span>Signed in as <strong class="text-[var(--text-ink)]"><%= currentUser.name || currentUser.username %></strong></span>
          <span class="badge badge-neutral text-[10px]"><%= currentUser.role %></span>
        </div>
        <a href="/logout" class="btn btn-secondary btn-md w-full justify-center">
          <%- icon('log-out', { class: 'w-4 h-4' }) %>
          Sign out
        </a>
      <% } else { %>
        <a href="/login" class="btn btn-secondary btn-md w-full justify-center">
          Log in
        </a>
        <a href="/register" class="btn btn-primary btn-md w-full justify-center">
          Get started
          <%- icon('arrow-right', { class: 'w-4 h-4' }) %>
        </a>
      <% } %>
    </div>
  </div>
</header>
