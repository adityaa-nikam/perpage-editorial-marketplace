<%
  const activePath = typeof currentPath !== 'undefined' ? currentPath : '';
  const currentUser = (typeof user !== 'undefined' && user) ? user : (typeof locals !== 'undefined' && locals.user ? locals.user : null);

  function isActive(path) {
    if (path === '/' || path === '/home') {
      return activePath === '/' || activePath === '/home';
    }
    return activePath.startsWith(path);
  }

  function getInitials(name) {
    if (!name) return 'U';
    const parts = name.trim().split(' ');
    if (parts.length >= 2) {
      return (parts[0][0] + parts[1][0]).toUpperCase();
    }
    return name.slice(0, 2).toUpperCase();
  }
%>

<script nonce="<%= locals.cspNonce || '' %>">
  function navbarComponent() {
    return {
      mobileMenuOpen: false,
      userDropdownOpen: false,
      notifDropdownOpen: false,
      notifications: [],
      unreadNotifCount: 0,
      isDark: document.documentElement.classList.contains('dark'),
      audioCtx: null,
      lastHoverTarget: null,
      lastHoverTime: 0,
      async fetchNotifications() {
        <% if (currentUser) { %>
        try {
          const res = await fetch('/api/notifications');
          if (res.ok) {
            const data = await res.json();
            this.notifications = data.notifications || [];
            this.unreadNotifCount = data.unreadCount || 0;
          }
        } catch (e) {}
        <% } %>
      },
      async markAllRead() {
        try {
          await fetch('/api/notifications/read-all', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
          this.unreadNotifCount = 0;
          this.notifications.forEach(n => { n.read = true; });
        } catch (e) {}
      },
      init() {
        <% if (currentUser) { %>
        this.fetchNotifications();
        setInterval(() => this.fetchNotifications(), 30000);
        <% } %>
        window.__toggleTheme = (event) => this.toggleTheme(event);
      },
      isTogglingTheme: false,
      toggleTheme(event) {
        if (this.isTogglingTheme) return;
        this.isTogglingTheme = true;

        const nextDark = !this.isDark;

        let x = window.innerWidth - 48;
        let y = 32;
        try {
          if (event) {
            const rawTarget = event.currentTarget || event.target;
            const btn = (rawTarget && typeof rawTarget.closest === 'function')
              ? (rawTarget.closest('button') || rawTarget)
              : rawTarget;
            if (btn && typeof btn.getBoundingClientRect === 'function') {
              const rect = btn.getBoundingClientRect();
              x = Math.round(rect.left + rect.width / 2);
              y = Math.round(rect.top + rect.height / 2);
            } else if (event.clientX && event.clientY) {
              x = Math.round(event.clientX);
              y = Math.round(event.clientY);
            }
          }
        } catch (_) {}

        const endRadius = Math.ceil(Math.hypot(
          Math.max(x, window.innerWidth - x),
          Math.max(y, window.innerHeight - y)
        ));

        const applyTheme = () => {
          this.isDark = nextDark;
          if (nextDark) {
            document.documentElement.classList.add('dark');
            try { localStorage.setItem('theme', 'dark'); } catch (_) {}
          } else {
            document.documentElement.classList.remove('dark');
            try { localStorage.setItem('theme', 'light'); } catch (_) {}
          }
        };

        try { this.playSwitchSound(); } catch (_) {}

        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          applyTheme();
          this.isTogglingTheme = false;
          return;
        }

        if (typeof document.startViewTransition === 'function') {
          try {
            document.documentElement.style.setProperty('--vt-x', `${x}px`);
            document.documentElement.style.setProperty('--vt-y', `${y}px`);
            document.documentElement.style.setProperty('--vt-r', `${endRadius}px`);

            const transition = document.startViewTransition(() => {
              applyTheme();
            });

            if (transition && transition.ready) {
              transition.ready.then(() => {
                try {
                  document.documentElement.animate(
                    {
                      clipPath: [
                        `circle(0px at ${x}px ${y}px)`,
                        `circle(${endRadius}px at ${x}px ${y}px)`
                      ]
                    },
                    {
                      duration: 480,
                      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                      pseudoElement: '::view-transition-new(root)'
                    }
                  );
                } catch (_) {}
              }).catch(() => {});
            }

            if (transition && transition.finished) {
              transition.finished.finally(() => {
                this.isTogglingTheme = false;
              });
            } else {
              setTimeout(() => { this.isTogglingTheme = false; }, 500);
            }
            return;
          } catch (e) {}
        }

        try {
          const circle = document.createElement('div');
          circle.style.position = 'fixed';
          circle.style.top = `${y}px`;
          circle.style.left = `${x}px`;
          circle.style.width = '4px';
          circle.style.height = '4px';
          circle.style.borderRadius = '50%';
          circle.style.backgroundColor = nextDark ? '#0b0f17' : '#ffffff';
          circle.style.transform = 'translate(-50%, -50%) scale(0)';
          circle.style.pointerEvents = 'none';
          circle.style.zIndex = '999999';
          circle.style.transition = 'transform 440ms cubic-bezier(0.22, 1, 0.36, 1)';
          document.body.appendChild(circle);

          requestAnimationFrame(() => {
            circle.style.transform = `translate(-50%, -50%) scale(${(endRadius * 2) / 4})`;
          });

          setTimeout(() => {
            applyTheme();
            circle.style.opacity = '0';
            circle.style.transition = 'opacity 180ms ease-out';
            setTimeout(() => {
              circle.remove();
              this.isTogglingTheme = false;
            }, 200);
          }, 380);
          return;
        } catch (_) {
          applyTheme();
          this.isTogglingTheme = false;
        }
      },
      handleNavHover(e) {
        const target = e.target.closest('a, button, [role="button"]');
        if (!target || target === this.lastHoverTarget) return;
        const now = Date.now();
        if (now - this.lastHoverTime < 50) return;
        this.lastHoverTarget = target;
        this.lastHoverTime = now;
        this.playHoverSound();
      },
      playHoverSound() {
        try {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (!AudioCtx) return;
          if (!this.audioCtx) this.audioCtx = new AudioCtx();
          if (this.audioCtx.state === 'suspended') this.audioCtx.resume();
          const ctx = this.audioCtx;
          const now = ctx.currentTime;

          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          const filter = ctx.createBiquadFilter();

          osc.type = 'triangle';
          osc.frequency.setValueAtTime(1750, now);
          osc.frequency.exponentialRampToValueAtTime(850, now + 0.012);

          filter.type = 'bandpass';
          filter.frequency.setValueAtTime(1400, now);
          filter.Q.value = 2.0;

          gain.gain.setValueAtTime(0.035, now);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.012);

          osc.connect(filter);
          filter.connect(gain);
          gain.connect(ctx.destination);

          osc.start(now);
          osc.stop(now + 0.014);
        } catch (e) {}
      },
      playSwitchSound() {
        try {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (!AudioCtx) return;
          if (!this.audioCtx) this.audioCtx = new AudioCtx();
          if (this.audioCtx.state === 'suspended') this.audioCtx.resume();
          const ctx = this.audioCtx;
          const now = ctx.currentTime;

          const clickOsc = ctx.createOscillator();
          const clickGain = ctx.createGain();
          const clickFilter = ctx.createBiquadFilter();
          clickOsc.type = 'triangle';
          clickOsc.frequency.setValueAtTime(850, now);
          clickOsc.frequency.exponentialRampToValueAtTime(1450, now + 0.014);
          clickFilter.type = 'highpass';
          clickFilter.frequency.setValueAtTime(550, now);
          clickGain.gain.setValueAtTime(0.09, now);
          clickGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.016);
          clickOsc.connect(clickFilter);
          clickFilter.connect(clickGain);
          clickGain.connect(ctx.destination);
          clickOsc.start(now);
          clickOsc.stop(now + 0.018);

          const toneOsc = ctx.createOscillator();
          const toneGain = ctx.createGain();
          toneOsc.type = 'sine';
          if (this.isDark) {
            toneOsc.frequency.setValueAtTime(340, now + 0.01);
            toneOsc.frequency.exponentialRampToValueAtTime(220, now + 0.09);
            toneGain.gain.setValueAtTime(0.0001, now);
            toneGain.gain.linearRampToValueAtTime(0.08, now + 0.02);
            toneGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.12);
          } else {
            toneOsc.frequency.setValueAtTime(540, now + 0.01);
            toneOsc.frequency.exponentialRampToValueAtTime(760, now + 0.09);
            toneGain.gain.setValueAtTime(0.0001, now);
            toneGain.gain.linearRampToValueAtTime(0.07, now + 0.02);
            toneGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.12);
          }
          toneOsc.connect(toneGain);
          toneGain.connect(ctx.destination);
          toneOsc.start(now + 0.01);
          toneOsc.stop(now + 0.13);
        } catch (e) {}
      }
    };
  }
</script>

<header 
  x-data="navbarComponent()"
  @mouseover="handleNavHover($event)"
  @mouseleave="lastHoverTarget = null"
  class="floating-navbar-wrapper sticky top-3 sm:top-4 z-50 w-full px-3 sm:px-6 pointer-events-none mb-2"
>
  <div class="floating-navbar-capsule pointer-events-auto w-full max-w-5xl mx-auto h-13 sm:h-14 px-3 sm:px-5 rounded-full flex items-center justify-between transition-all duration-200">
    <!-- Brand Wordmark (Left) -->
    <a href="/home" class="group flex items-center gap-2.5 text-decoration-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring)] rounded-full py-1 px-1 transition-transform duration-150 active:scale-98">
      <span class="brand-mark-tile">
        <img src="/logo.png" alt="P" class="theme-logo-light w-4.5 h-4.5 object-contain" />
        <img src="/logo-white.png" alt="P" class="theme-logo-dark w-4.5 h-4.5 object-contain" />
      </span>
      <span class="navbar-brand-logo flex items-baseline select-none">
        perpage<span class="navbar-brand-dot">.</span>
      </span>
    </a>

    <!-- Floating Nav Links (Center) -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Main Navigation">
      <a 
        href="/home" 
        class="nav-capsule-link <%= isActive('/home') ? 'is-active' : '' %>"
      >
        Home
      </a>
      <a 
        href="/writers" 
        class="nav-capsule-link <%= isActive('/writers') ? 'is-active' : '' %>"
      >Editors</a>
      <a 
        href="/leaderboard" 
        class="nav-capsule-link <%= isActive('/leaderboard') ? 'is-active' : '' %>"
      >
        Leaderboard
      </a>
      <a 
        href="/about" 
        class="nav-capsule-link <%= isActive('/about') ? 'is-active' : '' %>"
      >
        About
      </a>
      <% if (currentUser) { %>
        <a 
          href="/dashboard" 
          class="nav-capsule-link <%= isActive('/dashboard') ? 'is-active' : '' %>"
        >
          Dashboard
        </a>
        <% if (currentUser.role === 'admin') { %>
          <a 
            href="/admin" 
            class="nav-capsule-link font-semibold text-emerald-600 dark:text-emerald-400 <%= isActive('/admin') ? 'is-active' : '' %>"
          >
            Admin
          </a>
        <% } %>
      <% } %>
    </nav>

    <!-- Desktop Right Controls (Right) -->
    <div class="hidden md:flex items-center gap-2.5 lg:gap-3">
      <!-- Theme Toggle (Smooth Circular Reveal Animation) -->
      <button 
        type="button" 
        @click="toggleTheme($event)"
        class="nav-theme-toggle focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring)] relative cursor-pointer overflow-hidden"
        aria-label="Toggle color theme"
      >
        <span 
          x-show="!isDark" 
          class="theme-icon-light flex items-center justify-center transition-transform duration-200"
        >
          <%- icon('moon', { class: 'w-3.5 h-3.5' }) %>
        </span>
        <span 
          x-show="isDark" 
          class="theme-icon-dark flex items-center justify-center transition-transform duration-200"
          style="display: none;"
        >
          <%- icon('sun', { class: 'w-3.5 h-3.5' }) %>
        </span>
      </button>

      <% if (currentUser) { %>
        <!-- Notifications Bell & Dropdown -->
        <div class="relative" @keydown.escape="notifDropdownOpen = false">
          <button 
            type="button" 
            @click="notifDropdownOpen = !notifDropdownOpen; userDropdownOpen = false"
            class="relative flex items-center justify-center w-8 h-8 rounded-full border border-[var(--border-color)] bg-[var(--bg-surface-muted)] text-[var(--text-ink)] hover:bg-[var(--bg-surface)] hover:border-[var(--border-strong)] transition-all duration-150 cursor-pointer shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring)]"
            aria-label="Notifications"
            :aria-expanded="notifDropdownOpen"
          >
            <%- icon('bell', { class: 'w-3.5 h-3.5 text-[var(--text-muted)]' }) %>
            <template x-if="unreadNotifCount > 0">
              <span 
                class="absolute -top-1 -right-1 flex items-center justify-center min-w-[16px] h-4 px-1 rounded-full bg-[var(--primary)] text-[var(--primary-foreground)] text-[9px] font-mono font-bold leading-none shadow-xs"
                x-text="unreadNotifCount"
              ></span>
            </template>
          </button>

          <!-- Notifications Dropdown Panel -->
          <div 
            x-show="notifDropdownOpen" 
            @click.away="notifDropdownOpen = false"
            x-transition:enter="transition ease-out duration-100"
            x-transition:enter-start="transform opacity-0 scale-95"
            x-transition:enter-end="transform opacity-100 scale-100"
            x-transition:leave="transition ease-in duration-75"
            x-transition:leave-start="transform opacity-100 scale-100"
            x-transition:leave-end="transform opacity-0 scale-95"
            class="dropdown-menu w-80 sm:w-96 right-0 py-0 overflow-hidden"
            style="display: none;"
          >
            <div class="flex items-center justify-between px-3.5 py-2.5 border-b border-[var(--border-color)] bg-[var(--bg-surface-muted)]">
              <div class="flex items-center gap-2">
                <span class="text-xs font-semibold text-[var(--text-ink)]">Notifications</span>
                <template x-if="unreadNotifCount > 0">
                  <span class="badge badge-accent text-[10px] py-0 px-1.5" x-text="unreadNotifCount + ' unread'"></span>
                </template>
              </div>
              <template x-if="unreadNotifCount > 0">
                <button 
                  type="button" 
                  @click="markAllRead()" 
                  class="text-[11px] text-[var(--text-muted)] hover:text-[var(--text-ink)] cursor-pointer"
                >
                  Mark all as read
                </button>
              </template>
            </div>

            <div class="max-h-72 overflow-y-auto divide-y divide-[var(--border-color)]">
              <template x-if="notifications.length === 0">
                <div class="py-8 text-center text-xs text-[var(--text-muted)]">
                  No notifications yet.
                </div>
              </template>
              <template x-for="notif in notifications" :key="notif._id">
                <a 
                  :href="notif.link || '/dashboard'" 
                  class="block p-3 hover:bg-[var(--bg-surface-muted)] transition-colors text-left"
                  :class="{ 'bg-[var(--muted)]/50': !notif.read }"
                >
                  <div class="flex items-start justify-between gap-2 mb-0.5">
                    <div class="flex items-center gap-1.5 min-w-0">
                      <span class="text-xs font-semibold text-[var(--text-ink)] truncate" x-text="notif.title"></span>
                      <template x-if="notif.type === 'order_accepted' || notif.type === 'payment_pending'">
                        <span class="badge badge-warning text-[9px] py-0 px-1 shrink-0 font-medium">Payment Due</span>
                      </template>
                    </div>
                    <span class="text-[10px] text-[var(--text-muted)] font-mono shrink-0" x-text="new Date(notif.createdAt).toLocaleDateString()"></span>
                  </div>
                  <p class="text-[11px] text-[var(--text-muted)] leading-relaxed" x-text="notif.message"></p>
                </a>
              </template>
            </div>
            
            <div class="p-2 border-t border-[var(--border-color)] bg-[var(--bg-surface-muted)] text-center">
              <a href="/dashboard" class="text-[11px] font-medium text-[var(--text-ink)] hover:underline">
                View all on Dashboard &rarr;
              </a>
            </div>
          </div>
        </div>

        <!-- User Avatar Dropdown -->
        <div class="relative" @keydown.escape="userDropdownOpen = false">
          <button 
            type="button"
            @click="userDropdownOpen = !userDropdownOpen"
            class="flex items-center gap-2 pl-1.5 pr-3 py-1 rounded-full border border-[var(--border-color)] bg-[var(--bg-surface-muted)] hover:bg-[var(--bg-surface)] transition-all duration-150 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring)] shadow-xs hover:border-[var(--border-strong)]"
            id="user-menu-button"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <div class="w-6 h-6 rounded-full overflow-hidden bg-[var(--bg-surface)] border border-[var(--border-color)] flex items-center justify-center text-[10px] font-semibold text-[var(--text-ink)] shrink-0">
              <% if (currentUser.profilePic) { %>
                <img src="<%= currentUser.profilePic %>" alt="<%= currentUser.name || 'User' %>" class="w-full h-full object-cover" referrerpolicy="no-referrer">
              <% } else { %>
                <span><%= getInitials(currentUser.name || currentUser.username) %></span>
              <% } %>
            </div>
            <span class="text-xs font-medium text-[var(--text-ink)] max-w-[120px] truncate">
              <%= currentUser.name || currentUser.username || 'Account' %>
            </span>
            <%- icon('chevron-down', { class: 'w-3 h-3 text-[var(--text-muted)]' }) %>
          </button>

          <!-- Dropdown Menu -->
          <div 
            x-show="userDropdownOpen"
            @click.away="userDropdownOpen = false"
            x-transition:enter="transition ease-out duration-100"
            x-transition:enter-start="transform opacity-0 scale-95"
            x-transition:enter-end="transform opacity-100 scale-100"
            x-transition:leave="transition ease-in duration-75"
            x-transition:leave-start="transform opacity-100 scale-100"
            x-transition:leave-end="transform opacity-0 scale-95"
            class="dropdown-menu"
            role="menu"
            aria-orientation="vertical"
            aria-labelledby="user-menu-button"
            style="display: none;"
          >
            <div class="px-3.5 py-2 border-b border-[var(--border-color)]">
              <p class="text-xs font-semibold text-[var(--text-ink)] truncate"><%= currentUser.name || 'User' %></p>
              <p class="text-[11px] text-[var(--text-muted)] truncate"><%= currentUser.email %></p>
              <div class="mt-1">
                <span class="badge <%= currentUser.role === 'admin' ? 'bg-[#0c2340] text-white font-mono' : 'badge-neutral' %> text-[10px] py-0 px-1.5 capitalize"><%= (currentUser.role === 'admin') ? 'Admin' : ((currentUser.role === 'writer') ? 'Editor' : 'User') %></span>
              </div>
            </div>

            <div class="py-1">
              <% if (currentUser.role === 'admin') { %>
                <a href="/admin" class="dropdown-item font-semibold text-emerald-600 dark:text-emerald-400" role="menuitem">
                  <%- icon('shield', { class: 'w-4 h-4 text-emerald-600 shrink-0' }) %>
                  Operations Backoffice
                </a>
              <% } %>
              <a href="/dashboard" class="dropdown-item" role="menuitem">
                <%- icon('layout-dashboard', { class: 'w-4 h-4 text-[var(--text-muted)]' }) %>
                Dashboard
              </a>
              <a href="/profile/<%= currentUser._id %>" class="dropdown-item" role="menuitem">
                <%- icon('user', { class: 'w-4 h-4 text-[var(--text-muted)]' }) %>
                Your Profile
              </a>
            </div>

            <div class="border-t border-[var(--border-color)] pt-1">
              <form method="post" action="/logout" class="block w-full m-0 p-0">
                <button type="submit" class="dropdown-item is-danger w-full text-left bg-transparent border-0 cursor-pointer font-normal" role="menuitem">
                  <%- icon('log-out', { class: 'w-4 h-4' }) %>
                  Sign out
                </button>
              </form>
            </div>
          </div>
        </div>
      <% } else { %>
        <!-- Logged Out Actions -->
        <div class="flex items-center gap-2">
          <a href="/login" class="nav-btn-ghost focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring)]">
            Log in
          </a>
          <a href="/register" class="nav-btn-pill-cta focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring)]">
            Get started
            <%- icon('chevron-right', { class: 'w-3.5 h-3.5' }) %>
          </a>
        </div>
      <% } %>
    </div>

    <!-- Mobile Menu Trigger -->
    <div class="flex items-center gap-2 md:hidden">
      <button 
        type="button" 
        @click="toggleTheme($event)"
        class="nav-theme-toggle relative cursor-pointer overflow-hidden"
        aria-label="Toggle theme"
      >
        <span 
          x-show="!isDark" 
          class="theme-icon-light flex items-center justify-center transition-transform duration-200"
        >
          <%- icon('moon', { class: 'w-3.5 h-3.5' }) %>
        </span>
        <span 
          x-show="isDark" 
          class="theme-icon-dark flex items-center justify-center transition-transform duration-200"
          style="display: none;"
        >
          <%- icon('sun', { class: 'w-3.5 h-3.5' }) %>
        </span>
      </button>

      <% if (currentUser) { %>
        <a 
          href="/dashboard"
          class="relative flex items-center justify-center w-8 h-8 rounded-full border border-[var(--border-color)] bg-[var(--bg-surface-muted)] text-[var(--text-ink)] hover:bg-[var(--bg-surface)] transition-all duration-150 shadow-xs"
          aria-label="Notifications"
        >
          <%- icon('bell', { class: 'w-3.5 h-3.5 text-[var(--text-muted)]' }) %>
          <template x-if="unreadNotifCount > 0">
            <span 
              class="absolute -top-1 -right-1 flex items-center justify-center min-w-[15px] h-3.5 px-0.5 rounded-full bg-[var(--primary)] text-[var(--primary-foreground)] text-[9px] font-mono font-bold leading-none shadow-xs"
              x-text="unreadNotifCount"
            ></span>
          </template>
        </a>
      <% } %>

      <button 
        type="button" 
        @click="mobileMenuOpen = !mobileMenuOpen"
        class="w-8 h-8 rounded-full border border-[var(--border-color)] bg-[var(--bg-surface-muted)] text-[var(--text-ink)] flex items-center justify-center cursor-pointer transition-all duration-150 hover:bg-[var(--bg-surface)] active:scale-95 shadow-xs"
        aria-label="Open mobile menu"
        :aria-expanded="mobileMenuOpen.toString()"
      >
        <span x-show="!mobileMenuOpen">
          <%- icon('menu', { class: 'w-4 h-4' }) %>
        </span>
        <span x-show="mobileMenuOpen" style="display: none;">
          <%- icon('x', { class: 'w-4 h-4' }) %>
        </span>
      </button>
    </div>
  </div>

  <!-- Floating Mobile Dropdown Card -->
  <div 
    x-show="mobileMenuOpen"
    x-transition:enter="transition ease-out duration-150"
    x-transition:enter-start="opacity-0 -translate-y-2 scale-98"
    x-transition:enter-end="opacity-100 translate-y-0 scale-100"
    x-transition:leave="transition ease-in duration-100"
    x-transition:leave-start="opacity-100 translate-y-0 scale-100"
    x-transition:leave-end="opacity-0 -translate-y-2 scale-98"
    @click.away="mobileMenuOpen = false"
    @keydown.escape="mobileMenuOpen = false"
    class="md:hidden pointer-events-auto w-full max-w-5xl mx-auto mt-2.5 rounded-2xl bg-white/95 dark:bg-[#0c1017]/95 backdrop-blur-2xl border border-black/[0.08] dark:border-white/[0.12] p-4 space-y-3 shadow-2xl"
    style="display: none;"
  >
    <nav class="flex flex-col gap-1" aria-label="Mobile Navigation">
      <a 
        href="/home" 
        class="px-3.5 py-2.5 text-sm font-medium rounded-lg <%= isActive('/home') ? 'bg-[var(--bg-surface-muted)] text-[var(--text-ink)] font-semibold' : 'text-[var(--text-muted)] hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-muted)]' %>"
      >
        Home
      </a>
      <a 
        href="/writers" 
        class="px-3.5 py-2.5 text-sm font-medium rounded-lg <%= isActive('/writers') ? 'bg-[var(--bg-surface-muted)] text-[var(--text-ink)] font-semibold' : 'text-[var(--text-muted)] hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-muted)]' %>"
      >Editors</a>
      <a 
        href="/leaderboard" 
        class="px-3.5 py-2.5 text-sm font-medium rounded-lg <%= isActive('/leaderboard') ? 'bg-[var(--bg-surface-muted)] text-[var(--text-ink)] font-semibold' : 'text-[var(--text-muted)] hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-muted)]' %>"
      >
        Leaderboard
      </a>
      <a 
        href="/about" 
        class="px-3.5 py-2.5 text-sm font-medium rounded-lg <%= isActive('/about') ? 'bg-[var(--bg-surface-muted)] text-[var(--text-ink)] font-semibold' : 'text-[var(--text-muted)] hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-muted)]' %>"
      >
        About
      </a>
      <% if (currentUser) { %>
        <% if (currentUser.role === 'admin') { %>
          <a 
            href="/admin" 
            class="px-3.5 py-2.5 text-sm font-semibold rounded-lg flex items-center justify-between text-emerald-600 dark:text-emerald-400 <%= isActive('/admin') ? 'bg-[var(--bg-surface-muted)]' : 'hover:bg-[var(--bg-surface-muted)]' %>"
          >
            <span class="flex items-center gap-2">
              <%- icon('shield', { class: 'w-4 h-4' }) %> Admin Backoffice
            </span>
            <span class="badge bg-[#0c2340] text-white text-[10px] font-mono">STAFF</span>
          </a>
        <% } %>
        <a 
          href="/dashboard" 
          class="px-3.5 py-2.5 text-sm font-medium rounded-lg flex items-center justify-between <%= isActive('/dashboard') ? 'bg-[var(--bg-surface-muted)] text-[var(--text-ink)] font-semibold' : 'text-[var(--text-muted)] hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-muted)]' %>"
        >
          <span>Dashboard</span>
          <template x-if="unreadNotifCount > 0">
            <span class="badge badge-accent text-[10px]" x-text="unreadNotifCount + ' unread'"></span>
          </template>
        </a>
        <a 
          href="/profile/<%= currentUser._id %>" 
          class="px-3.5 py-2.5 text-sm font-medium rounded-lg <%= isActive('/profile') ? 'bg-[var(--bg-surface-muted)] text-[var(--text-ink)] font-semibold' : 'text-[var(--text-muted)] hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-muted)]' %>"
        >
          Your Profile
        </a>
      <% } %>
    </nav>

    <div class="pt-3 border-t border-[var(--border-color)] flex flex-col gap-2">
      <% if (currentUser) { %>
        <div class="px-3 py-1 flex items-center justify-between text-xs text-[var(--text-muted)]">
          <span>Signed in as <strong class="text-[var(--text-ink)]"><%= currentUser.name || currentUser.username %></strong></span>
          <span class="badge <%= currentUser.role === 'admin' ? 'bg-[#0c2340] text-white font-mono' : 'badge-neutral' %> text-[10px]"><%= (currentUser.role === 'admin') ? 'Admin' : ((currentUser.role === 'writer') ? 'Editor' : 'User') %></span>
        </div>
        <form method="post" action="/logout" class="w-full m-0 p-0">
          <button type="submit" class="btn btn-secondary btn-md w-full justify-center">
            <%- icon('log-out', { class: 'w-4 h-4' }) %>
            Sign out
          </button>
        </form>
      <% } else { %>
        <a href="/login" class="btn btn-secondary btn-md w-full justify-center">
          Log in
        </a>
        <a href="/register" class="nav-btn-pill-cta w-full justify-center text-center">
          Get started
          <%- icon('chevron-right', { class: 'w-3.5 h-3.5' }) %>
        </a>
      <% } %>
    </div>
  </div>
</header>
