<!-- Global Toast Container -->
<% if (typeof messages !== 'undefined' && (messages.error || messages.success || messages.info)) { %>
  <div 
    x-data="{ show: true }" 
    x-show="show" 
    x-init="setTimeout(() => show = false, 5000)" 
    x-transition:enter="transition ease-out duration-200" 
    x-transition:enter-start="opacity-0 translate-y-3" 
    x-transition:enter-end="opacity-100 translate-y-0" 
    x-transition:leave="transition ease-in duration-150" 
    x-transition:leave-start="opacity-100 translate-y-0" 
    x-transition:leave-end="opacity-0 translate-y-3"
    class="toast-container"
    role="status"
    aria-live="polite"
  >
    <% if (messages.error) { %>
      <div class="toast border-[var(--semantic-danger-border)] bg-[var(--bg-surface)]">
        <span class="text-[var(--semantic-danger-text)]"><%- icon('alert-circle', { class: 'w-4 h-4' }) %></span>
        <span class="text-xs font-medium text-[var(--semantic-danger-text)]"><%= messages.error %></span>
        <button type="button" @click="show = false" class="ml-2 text-[var(--text-muted)] hover:text-[var(--text-ink)] cursor-pointer" aria-label="Close notification">
          <%- icon('x', { class: 'w-3.5 h-3.5' }) %>
        </button>
      </div>
    <% } %>

    <% if (messages.success) { %>
      <div class="toast border-[var(--semantic-success-border)] bg-[var(--bg-surface)]">
        <span class="text-[var(--semantic-success-text)]"><%- icon('check', { class: 'w-4 h-4' }) %></span>
        <span class="text-xs font-medium text-[var(--semantic-success-text)]"><%= messages.success %></span>
        <button type="button" @click="show = false" class="ml-2 text-[var(--text-muted)] hover:text-[var(--text-ink)] cursor-pointer" aria-label="Close notification">
          <%- icon('x', { class: 'w-3.5 h-3.5' }) %>
        </button>
      </div>
    <% } %>

    <% if (messages.info) { %>
      <div class="toast border-[var(--semantic-info-border)] bg-[var(--bg-surface)]">
        <span class="text-[var(--semantic-info-text)]"><%- icon('info', { class: 'w-4 h-4' }) %></span>
        <span class="text-xs font-medium text-[var(--semantic-info-text)]"><%= messages.info %></span>
        <button type="button" @click="show = false" class="ml-2 text-[var(--text-muted)] hover:text-[var(--text-ink)] cursor-pointer" aria-label="Close notification">
          <%- icon('x', { class: 'w-3.5 h-3.5' }) %>
        </button>
      </div>
    <% } %>
  </div>
<% } %>

<!-- Navigation Progress Bar & Motion Script -->
<script nonce="<%= locals.cspNonce || '' %>">
  // Top Navigation Progress Bar
  (function() {
    var progressBar = document.getElementById('nav-progress-bar');
    if (!progressBar) return;
    var progressTimer = null;

    function startProgress() {
      if (progressTimer) clearInterval(progressTimer);
      progressBar.classList.add('is-active');
      progressBar.style.width = '20%';
      var width = 20;
      progressTimer = setInterval(function() {
        if (width < 80) {
          width += (80 - width) * 0.2;
          progressBar.style.width = Math.min(width, 80) + '%';
        }
      }, 80);
    }

    function completeProgress() {
      if (progressTimer) clearInterval(progressTimer);
      progressBar.style.width = '100%';
      setTimeout(function() {
        progressBar.classList.remove('is-active');
        setTimeout(function() {
          progressBar.style.width = '0%';
        }, 200);
      }, 150);
    }

    // Intercept internal link clicks
    document.addEventListener('click', function(e) {
      var link = e.target.closest('a');
      if (!link) return;
      var href = link.getAttribute('href');
      var target = link.getAttribute('target');
      var isDownload = link.hasAttribute('download');
      if (!href || href.startsWith('#') || href.startsWith('javascript:') || href.startsWith('mailto:') || href.startsWith('tel:') || target === '_blank' || isDownload) {
        return;
      }
      if (href.startsWith('/') || href.startsWith(window.location.origin)) {
        startProgress();
      }
    });

    // Form submission progress
    document.addEventListener('submit', function(e) {
      var form = e.target;
      if (form && !form.getAttribute('target')) {
        startProgress();
      }
    });

    // Complete on pageshow
    window.addEventListener('pageshow', function() {
      completeProgress();
    });
  })();

  // Editorial Section Reveal (60ms stagger maximum, gated behind html.js)
  document.addEventListener('DOMContentLoaded', function() {
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var revealElements = document.querySelectorAll('.reveal-on-scroll');
      if (revealElements.length > 0) {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });

        revealElements.forEach(function(el, idx) {
          var stagger = Math.min((idx % 3) * 50, 60);
          el.style.transitionDelay = stagger + 'ms';
          observer.observe(el);
        });
      }
    } else {
      document.querySelectorAll('.reveal-on-scroll').forEach(function(el) {
        el.classList.add('is-revealed');
      });
    }
  });
</script>
</body>
</html>
