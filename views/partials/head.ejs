<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=5.0">
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0b0f17" media="(prefers-color-scheme: dark)">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="format-detection" content="telephone=no">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : (typeof title !== 'undefined' ? title : 'PerPage — Document Editing & Feedback Marketplace') %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'PerPage is a demonstration marketplace for editing and feedback on your own documents, connecting clients with freelance editors with upfront per-page rates.' %>">
  <link rel="canonical" href="<%= typeof canonical !== 'undefined' ? canonical : ('https://perpage.onrender.com' + (locals.currentPath || '/')) %>">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <% if (typeof robots !== 'undefined' && robots) { %>
  <meta name="robots" content="<%= robots %>">
  <% } else if (typeof noindex !== 'undefined' && noindex) { %>
  <meta name="robots" content="noindex, follow">
  <% } %>

  <!-- Open Graph / Social -->
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
  <meta property="og:site_name" content="PerPage">
  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : 'PerPage — Document Editing & Feedback Marketplace' %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Browse freelance editors, calculate rates upfront per page, and get feedback on your own documents.' %>">
  <meta property="og:url" content="<%= typeof canonical !== 'undefined' ? canonical : ('https://perpage.onrender.com' + (locals.currentPath || '/')) %>">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : 'PerPage — Document Editing & Feedback Marketplace' %>">
  <meta name="twitter:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Browse freelance editors, calculate rates upfront per page, and get feedback on your own documents.' %>">

  <!-- JSON-LD WebSite Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "PerPage",
    "url": "https://perpage.onrender.com",
    "description": "Demonstration marketplace for editing and feedback on a person's own documents with transparent per-page rates."
  }
  </script>

  <!-- Prevent Flash of Unstyled Theme (FOUC) and enable JS styling flag -->
  <script nonce="<%= locals.cspNonce || '' %>">
    (function() {
      try {
        document.documentElement.classList.add('js');
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
      window.__toggleTheme = function(e) {
        var isDark = document.documentElement.classList.contains('dark');
        var nextDark = !isDark;
        if (nextDark) {
          document.documentElement.classList.add('dark');
          try { localStorage.setItem('theme', 'dark'); } catch (_) {}
        } else {
          document.documentElement.classList.remove('dark');
          try { localStorage.setItem('theme', 'light'); } catch (_) {}
        }
      };
    })();
  </script>

  <!-- Preload Critical Self-hosted Fonts (font-display: swap) -->
  <link rel="preload" href="/fonts/source-serif-4-latin-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/instrument-sans-latin-var.woff2" as="font" type="font/woff2" crossorigin>

  <!-- Geist & Geist Mono Typography (Vercel Theme) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Production Built CSS with Content Hash -->
  <link rel="stylesheet" href="/css/app.css<%= locals.assetVersion ? ('?v=' + locals.assetVersion) : '' %>">

  <!-- Alpine.js (Pinned version, deferred) -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
</head>
<body class="bg-[var(--bg-background)] text-[var(--text-ink)] antialiased min-h-screen flex flex-col font-sans selection:bg-[var(--primary)] selection:text-[var(--primary-foreground)]">
  <!-- Top Navigation Progress Bar -->
  <div id="nav-progress-bar" aria-hidden="true"></div>

  <!-- Accessible Skip to Content Link -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--bg-surface)] focus:text-[var(--text-ink)] focus:border focus:border-[var(--primary)] focus:rounded-md focus:shadow-lg focus:outline-none">
    Skip to main content
  </a>
