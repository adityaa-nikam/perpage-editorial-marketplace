<footer class="mt-auto border-t border-[var(--border-color)] bg-[var(--bg-surface)] transition-colors duration-150">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      
      <!-- Brand & Mission Column -->
      <div class="md:col-span-5 space-y-3">
        <a href="/home" class="flex items-center gap-2 text-decoration-none">
          <span class="w-6 h-6 rounded-md border border-[var(--border-color)] bg-[var(--bg-surface-muted)] flex items-center justify-center overflow-hidden shrink-0">
            <img src="/logo.png" alt="PerPage" class="theme-logo-light w-4 h-4 object-contain" />
            <img src="/logo-white.png" alt="PerPage" class="theme-logo-dark w-4 h-4 object-contain" />
          </span>
          <span class="navbar-brand-logo">
            perpage<span class="navbar-brand-dot">.</span>
          </span>
        </a>
        <p class="text-xs text-[var(--text-muted)] leading-relaxed max-w-sm">
          Transparent per-page pricing and structured editorial critique for your academic drafts and manuscripts.
        </p>
      </div>

      <!-- Platform Links -->
      <div class="md:col-span-4 space-y-2.5">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)] font-mono">Platform</h3>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-xs">
          <li><a href="/home" class="text-[var(--text-muted)] hover:text-[var(--text-ink)] transition-colors">Home</a></li>
          <li><a href="/writers" class="text-[var(--text-muted)] hover:text-[var(--text-ink)] transition-colors">Browse Editors</a></li>
          <li><a href="/leaderboard" class="text-[var(--text-muted)] hover:text-[var(--text-ink)] transition-colors">Leaderboard</a></li>
          <li><a href="/about" class="text-[var(--text-muted)] hover:text-[var(--text-ink)] transition-colors">How It Works</a></li>
          <li><a href="/dashboard" class="text-[var(--text-muted)] hover:text-[var(--text-ink)] transition-colors">Dashboard</a></li>
        </ul>
      </div>

      <!-- Editorial & Policies -->
      <div class="md:col-span-3 space-y-2.5">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)] font-mono">Editorial</h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/acceptable-use" class="text-[var(--text-muted)] hover:text-[var(--text-ink)] transition-colors">Acceptable Use Policy</a></li>
          <li><a href="/about" class="text-[var(--text-muted)] hover:text-[var(--text-ink)] transition-colors">About Our Mission</a></li>
          <li><a href="https://github.com/adityaa-nikam/perpage-academic-help-platform" target="_blank" rel="noopener noreferrer" class="text-[var(--text-muted)] hover:text-[var(--text-ink)] inline-flex items-center gap-1 transition-colors">
            Source Repository
            <%- icon('arrow-up-right', { class: 'w-3 h-3' }) %>
          </a></li>
        </ul>
      </div>

    </div>

    <!-- Minimal Bottom Bar -->
    <div class="mt-8 pt-6 border-t border-[var(--border-color)] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[var(--text-muted)] text-center sm:text-left">
      <p class="text-center sm:text-left">
        &copy; <%= new Date().getFullYear() %> PerPage. Developed by <a href="https://github.com/adityaa-nikam" target="_blank" rel="noopener noreferrer" class="text-[var(--text-ink)] font-medium hover:text-[var(--accent)] transition-colors">Aditya Nikam</a>.
      </p>
      <span class="text-[11px] opacity-75 text-center sm:text-right">
        Demonstration marketplace &bull; No real payments processed
      </span>
    </div>
  </div>
</footer>
