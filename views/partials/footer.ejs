<footer class="mt-auto border-t border-[var(--border-color)] bg-[var(--bg-surface)] transition-colors duration-150">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
      <!-- Brand & Mission Column -->
      <div class="md:col-span-1 space-y-3">
        <a href="/home" class="flex items-center gap-2 text-decoration-none">
          <span class="w-6 h-6 rounded-md bg-[var(--text-ink)] text-[var(--bg-surface)] flex items-center justify-center font-serif-display font-bold text-sm tracking-tighter">
            P
          </span>
          <span class="font-serif-display text-xl text-[var(--text-ink)] tracking-tight">
            PerPage<span class="text-[var(--accent)] font-sans text-xs ml-0.5 font-bold">.</span>
          </span>
        </a>
        <p class="text-xs text-[var(--text-muted)] leading-relaxed">
          Calm, transparent academic writing &amp; research collaboration. Transparent per-page pricing, direct writer assignment, and secure draft delivery.
        </p>
      </div>

      <!-- Platform Navigation -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">Platform</h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/home" class="text-[var(--text-muted)] hover:text-[var(--text-ink)] transition-colors">Home</a></li>
          <li><a href="/writers" class="text-[var(--text-muted)] hover:text-[var(--text-ink)] transition-colors">Browse Writers</a></li>
          <li><a href="/about" class="text-[var(--text-muted)] hover:text-[var(--text-ink)] transition-colors">How It Works</a></li>
          <li><a href="/dashboard" class="text-[var(--text-muted)] hover:text-[var(--text-ink)] transition-colors">Student &amp; Writer Dashboard</a></li>
        </ul>
      </div>

      <!-- Resources & Standards -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">Editorial Standards</h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/about" class="text-[var(--text-muted)] hover:text-[var(--text-ink)] transition-colors">About Our Mission</a></li>
          <li><a href="/writers" class="text-[var(--text-muted)] hover:text-[var(--text-ink)] transition-colors">Writer Verification</a></li>
          <li><a href="/about#academic-integrity" class="text-[var(--text-muted)] hover:text-[var(--text-ink)] transition-colors">Academic Honor Code</a></li>
          <li><a href="https://github.com/adityaa-nikam/perpage-academic-help-platform" target="_blank" rel="noopener noreferrer" class="text-[var(--text-muted)] hover:text-[var(--text-ink)] inline-flex items-center gap-1 transition-colors">
            Source Repository
            <%- icon('arrow-up-right', { class: 'w-3 h-3' }) %>
          </a></li>
        </ul>
      </div>

      <!-- Legal & Architecture -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">Academic Project</h3>
        <ul class="space-y-2 text-xs text-[var(--text-muted)]">
          <li><span>Stack: Node.js, Express 5, EJS, MongoDB</span></li>
          <li><span>Storage: AWS S3 Encrypted Presigned URLs</span></li>
          <li><span>Session Store: Connect-Mongo TTL</span></li>
          <li><a href="/health" class="text-[var(--text-muted)] hover:text-[var(--text-ink)] inline-flex items-center gap-1 transition-colors">
            System Health Check
            <%- icon('shield-check', { class: 'w-3 h-3 text-[var(--accent)]' }) %>
          </a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Disclaimer Bar -->
    <div class="mt-12 pt-8 border-t border-[var(--border-color)] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--text-muted)]">
      <p class="text-center sm:text-left">
        &copy; <%= new Date().getFullYear() %> PerPage. Designed in the <span class="text-[var(--text-ink)] font-medium">Paper &amp; Ink</span> editorial style.
      </p>
      <p class="text-center sm:text-right text-[11px] max-w-md">
        Educational demonstration project. No real financial payments are processed. Built for academic workflow evaluation.
      </p>
    </div>
  </div>
</footer>
