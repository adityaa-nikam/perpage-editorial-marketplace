<%- include('partials/head', { pageTitle: 'About Us — PerPage Academic Collaboration', metaDescription: 'Learn about the mission, values, and architectural design behind PerPage.' }) %>
<%- include('partials/navbar') %>

<main id="main-content" class="py-12 sm:py-20 space-y-20">

  <!-- Header Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl space-y-4">
      <span class="type-eyebrow">Our Mission</span>
      <h1 class="type-display">Academic Collaboration Built on Trust &amp; Integrity</h1>
      <p class="type-body text-[var(--text-muted)] text-base sm:text-lg">
        PerPage was created with a clear purpose: to connect students struggling with complex research assignments with credentialed academic authors through transparent per-page rates.
      </p>
    </div>
  </section>

  <!-- Story & Background Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 space-y-6">
        <h2 class="type-h2">The Story Behind PerPage</h2>
        <div class="space-y-4 type-body text-[var(--text-muted)] leading-relaxed">
          <p>
            Traditional academic assistance is often opaque, marked by unpredictable pricing, anonymous intermediaries, and inconsistent quality. We designed PerPage as an open marketplace where students inspect author profiles, evaluate past performance, and agree upon milestone rates.
          </p>
          <p>
            Whether coordinating literature syntheses, methodology reviews, or technical draft analysis, our platform facilitates clear communication, verifiable deliverables, and secure storage for research files.
          </p>
        </div>

        <div class="pt-4 border-t border-[var(--border-color)] grid grid-cols-3 gap-6">
          <div>
            <div class="font-serif-display text-3xl text-[var(--text-ink)]">2024</div>
            <div class="text-xs text-[var(--text-muted)] mt-1">Platform Inception</div>
          </div>
          <div>
            <div class="font-serif-display text-3xl text-[var(--text-ink)]">1,000+</div>
            <div class="text-xs text-[var(--text-muted)] mt-1">Students Assisted</div>
          </div>
          <div>
            <div class="font-serif-display text-3xl text-[var(--text-ink)]">50+</div>
            <div class="text-xs text-[var(--text-muted)] mt-1">Academic Authors</div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="card p-8 bg-[var(--bg-surface-muted)] space-y-6">
          <span class="type-eyebrow">Core Principles</span>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-md bg-[var(--bg-surface)] border border-[var(--border-color)] flex items-center justify-center text-[var(--accent)] shrink-0">
                <%- icon('shield-check', { class: 'w-4 h-4' }) %>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-[var(--text-ink)]">Author Verification</h4>
                <p class="text-xs text-[var(--text-muted)] mt-0.5">Every writer submits academic background credentials and sample publications.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-md bg-[var(--bg-surface)] border border-[var(--border-color)] flex items-center justify-center text-[var(--accent)] shrink-0">
                <%- icon('file-text', { class: 'w-4 h-4' }) %>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-[var(--text-ink)]">Transparent Unit Pricing</h4>
                <p class="text-xs text-[var(--text-muted)] mt-0.5">Fixed rates per page with upfront calculations. No hidden service charges.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-md bg-[var(--bg-surface)] border border-[var(--border-color)] flex items-center justify-center text-[var(--accent)] shrink-0">
                <%- icon('clock', { class: 'w-4 h-4' }) %>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-[var(--text-ink)]">Milestone Delivery</h4>
                <p class="text-xs text-[var(--text-muted)] mt-0.5">Direct oversight of draft progress through the integrated status dashboard.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vision, Mission & Values -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="card p-8 space-y-3">
        <div class="w-10 h-10 rounded-lg bg-[var(--bg-surface-muted)] border border-[var(--border-color)] flex items-center justify-center text-[var(--accent)]">
          <%- icon('search', { class: 'w-5 h-5' }) %>
        </div>
        <h3 class="type-h3 text-lg">Our Vision</h3>
        <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed">
          Empowering university students worldwide by making expert scholarly assistance accessible, transparent, and ethically guided.
        </p>
      </div>

      <div class="card p-8 space-y-3">
        <div class="w-10 h-10 rounded-lg bg-[var(--bg-surface-muted)] border border-[var(--border-color)] flex items-center justify-center text-[var(--accent)]">
          <%- icon('shield-check', { class: 'w-5 h-5' }) %>
        </div>
        <h3 class="type-h3 text-lg">Our Mission</h3>
        <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed">
          Bridging the gap between students under strict academic deadlines and independent researchers seeking fair compensation for their expertise.
        </p>
      </div>

      <div class="card p-8 space-y-3">
        <div class="w-10 h-10 rounded-lg bg-[var(--bg-surface-muted)] border border-[var(--border-color)] flex items-center justify-center text-[var(--accent)]">
          <%- icon('star', { class: 'w-5 h-5' }) %>
        </div>
        <h3 class="type-h3 text-lg">Our Values</h3>
        <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed">
          Rigorous research ethics, respect for author independence, institutional privacy, and collaborative academic learning.
        </p>
      </div>
    </div>
  </section>

  <!-- Academic Integrity Policy -->
  <section id="academic-integrity" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="card border-[var(--border-strong)] p-8 sm:p-10 space-y-4">
      <div class="flex items-center gap-2">
        <%- icon('alert-circle', { class: 'w-5 h-5 text-[var(--accent)]' }) %>
        <h3 class="type-h3 text-lg">Academic Integrity Notice</h3>
      </div>
      <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed max-w-3xl">
        PerPage is an academic assistance and tutoring collaboration platform. Delivered manuscripts, analyses, and source bibliographies are intended as scholarly model drafts, study guides, and research references. Users are expected to comply with their respective institutional honor codes and citation policies.
      </p>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
