<%- include('partials/head', { 
  pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : 'About — PerPage Document Editing Marketplace', 
  metaDescription: typeof metaDescription !== 'undefined' ? metaDescription : 'An academic demonstration project modeling how clients and freelance editors agree on editing and feedback per page.',
  canonical: typeof canonical !== 'undefined' ? canonical : undefined,
  ogType: 'website'
}) %>
<%- include('partials/navbar') %>

<main id="main-content" class="py-12 sm:py-20 space-y-16 sm:space-y-24">

  <!-- 1. HEADER SECTION -->
  <header class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-4 border-b border-[var(--border-color)] pb-8">
      <div class="section-eyebrow">
        <span class="eyebrow-num">01</span>
        <span class="eyebrow-rule"></span>
        <span class="eyebrow-label">Platform Overview &amp; Specifications</span>
      </div>
      <h1 class="type-h1 text-3xl sm:text-5xl">A demonstration project about a document editing marketplace</h1>
      <p class="type-body text-[var(--text-muted)] text-base sm:text-lg prose-measure">
        Models how clients and freelance editors coordinate draft editing agreements with upfront per-page rates.
      </p>
    </div>
  </header>

  <!-- 2. WHAT PERPAGE IS -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-4">
      <div class="section-eyebrow">
        <span class="eyebrow-num">01</span>
        <span class="eyebrow-rule"></span>
        <span class="eyebrow-label">Scope &amp; Intent</span>
      </div>
      <h2 class="type-h2 text-xl sm:text-2xl">What PerPage is</h2>
      <div class="space-y-4 type-body text-[var(--text-muted)] leading-relaxed prose-measure">
        <p>
          PerPage is an academic demonstration project that models how clients and freelance editors agree on editing and feedback per page. Editors improve what the client wrote—they do not write documents from scratch. It was built to explore marketplace state transitions, authenticated file handoffs, and clear unit pricing without hidden fees, artificial urgency, or dark patterns.
        </p>
        <p>
          The application demonstrates a calm, accessible interface designed around standard web standards and server-rendered HTML. Users can inspect editor rates, initiate formal editing agreements with attached drafts and instructions, and track deliverables through each stage of the fulfillment process.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. HOW A DEAL WORKS (STEPPER) -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-6">
      <div>
        <div class="section-eyebrow mb-2">
          <span class="eyebrow-num">02</span>
          <span class="eyebrow-rule"></span>
          <span class="eyebrow-label">Transaction Lifecycle</span>
        </div>
        <h2 class="type-h2 text-xl sm:text-2xl">How a deal works</h2>
        <p class="type-body text-sm text-[var(--text-muted)] mt-1">
          Every editing deal progresses through four sequential statuses.
        </p>
      </div>

      <div class="card p-6 sm:p-8 bg-[var(--bg-surface)]">
        <div class="timeline-stepper py-2" aria-label="Deal lifecycle steps">
          <!-- Step 1 -->
          <div class="stepper-step is-complete">
            <div class="stepper-indicator"><%- icon('check', { class: 'w-3.5 h-3.5' }) %></div>
            <div class="stepper-label text-xs mt-1.5 font-medium">Pending</div>
            <div class="stepper-line"></div>
          </div>
          <!-- Step 2 -->
          <div class="stepper-step is-complete">
            <div class="stepper-indicator"><%- icon('check', { class: 'w-3.5 h-3.5' }) %></div>
            <div class="stepper-label text-xs mt-1.5 font-medium">Accepted</div>
            <div class="stepper-line"></div>
          </div>
          <!-- Step 3 -->
          <div class="stepper-step is-complete">
            <div class="stepper-indicator"><%- icon('check', { class: 'w-3.5 h-3.5' }) %></div>
            <div class="stepper-label text-xs mt-1.5 font-medium">Delivered</div>
            <div class="stepper-line"></div>
          </div>
          <!-- Step 4 -->
          <div class="stepper-step is-complete">
            <div class="stepper-indicator"><%- icon('check', { class: 'w-3.5 h-3.5' }) %></div>
            <div class="stepper-label text-xs mt-1.5 font-medium">Completed</div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-6 border-t border-[var(--border-color)] text-xs text-[var(--text-muted)]">
          <div class="space-y-1">
            <div class="font-semibold text-[var(--text-ink)]">1. Pending</div>
            <p>Client submits document details, page count, deadline, instructions, and draft PDF.</p>
          </div>
          <div class="space-y-1">
            <div class="font-semibold text-[var(--text-ink)]">2. Accepted</div>
            <p>Editor reviews editing scope and agrees to review the draft.</p>
          </div>
          <div class="space-y-1">
            <div class="font-semibold text-[var(--text-ink)]">3. Delivered</div>
            <p>Editor completes editing and feedback, uploading the revised PDF to private cloud storage.</p>
          </div>
          <div class="space-y-1">
            <div class="font-semibold text-[var(--text-ink)]">4. Completed</div>
            <p>Client downloads deliverable and confirms receipt to conclude the deal.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. WHAT IS REAL AND WHAT IS SIMULATED -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-6">
      <div>
        <div class="section-eyebrow mb-2">
          <span class="eyebrow-num">03</span>
          <span class="eyebrow-rule"></span>
          <span class="eyebrow-label">System Boundaries</span>
        </div>
        <h2 class="type-h2 text-xl sm:text-2xl">What is real and what is simulated</h2>
        <p class="type-body text-sm text-[var(--text-muted)] mt-1">
          An honest architectural breakdown of functional subsystems versus prototype boundaries.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Implemented Subsystems Column -->
        <div class="card card-ticket p-6 bg-[var(--bg-surface)] space-y-4">
          <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-3">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-[var(--accent)]"></div>
              <h3 class="type-h3 text-base">Implemented Subsystems</h3>
            </div>
            <span class="badge badge-accent text-[10px]">Production Engine</span>
          </div>
          <ul class="space-y-3 text-xs sm:text-sm text-[var(--text-muted)]">
            <li class="flex items-start gap-2.5">
              <span class="text-[var(--accent)] mt-0.5 shrink-0"><%- icon('check', { class: 'w-4 h-4' }) %></span>
              <span><strong>Accounts &amp; Multi-Strategy OAuth:</strong> Local bcrypt security, Google OAuth 2.0, and GitHub OAuth with persistent MongoDB sessions.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[var(--accent)] mt-0.5 shrink-0"><%- icon('check', { class: 'w-4 h-4' }) %></span>
              <span><strong>Razorpay Gateway &amp; Escrow:</strong> Real order generation, checkout modal, cryptographic HMAC-SHA256 signature verification, and protected funds escrow.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[var(--accent)] mt-0.5 shrink-0"><%- icon('check', { class: 'w-4 h-4' }) %></span>
              <span><strong>Dual-Role Email Receipts:</strong> Automated Nodemailer delivery dispatching branded payment receipts to clients and escrow alerts to editors.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[var(--accent)] mt-0.5 shrink-0"><%- icon('check', { class: 'w-4 h-4' }) %></span>
              <span><strong>5-Star Ratings &amp; Reviews:</strong> Real client review submissions on completed deals, updating live average editor ratings and public testimonials.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[var(--accent)] mt-0.5 shrink-0"><%- icon('check', { class: 'w-4 h-4' }) %></span>
              <span><strong>Private AWS S3 Storage:</strong> Direct cloud uploads with time-limited pre-signed URLs preventing document leakage.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[var(--accent)] mt-0.5 shrink-0"><%- icon('check', { class: 'w-4 h-4' }) %></span>
              <span><strong>Deal Lifecycle:</strong> Deterministic state machine (pending, accepted, funded, submitted, completed) with in-app notification alerts.</span>
            </li>
          </ul>
        </div>

        <!-- Demonstration Sandbox Boundaries Column -->
        <div class="card card-ticket p-6 bg-[var(--bg-surface-muted)] space-y-4">
          <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-3">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-[var(--text-muted)]"></div>
              <h3 class="type-h3 text-base">Demonstration Sandbox</h3>
            </div>
            <span class="badge badge-neutral text-[10px]">Test Environment</span>
          </div>
          <ul class="space-y-3 text-xs sm:text-sm text-[var(--text-muted)]">
            <li class="flex items-start gap-2.5">
              <span class="text-[var(--text-muted)] mt-0.5 shrink-0"><%- icon('info', { class: 'w-4 h-4' }) %></span>
              <span><strong>Razorpay Test Mode:</strong> Live payment flow operates using Razorpay's Test Mode API keys (simulating card/UPI transactions without real bank debits).</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[var(--text-muted)] mt-0.5 shrink-0"><%- icon('info', { class: 'w-4 h-4' }) %></span>
              <span><strong>Authentic Reviews:</strong> Reviews can only be submitted by clients who have actually funded and completed a deal with that specific editor.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[var(--text-muted)] mt-0.5 shrink-0"><%- icon('info', { class: 'w-4 h-4' }) %></span>
              <span><strong>Scope Guardrails:</strong> Strictly enforces editorial review and document annotation; scratch paper writing from zero is blocked by policy.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. BUILT WITH (NEUTRAL BADGES) -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-4">
      <div class="section-eyebrow">
        <span class="eyebrow-num">04</span>
        <span class="eyebrow-rule"></span>
        <span class="eyebrow-label">Technology Stack</span>
      </div>
      <h2 class="type-h2 text-xl sm:text-2xl">Built with</h2>
      <div class="flex flex-wrap gap-2 pt-1">
        <span class="badge badge-neutral text-xs py-1 px-3">Node.js</span>
        <span class="badge badge-neutral text-xs py-1 px-3">Express</span>
        <span class="badge badge-neutral text-xs py-1 px-3">EJS</span>
        <span class="badge badge-neutral text-xs py-1 px-3">MongoDB</span>
        <span class="badge badge-neutral text-xs py-1 px-3">AWS S3</span>
        <span class="badge badge-neutral text-xs py-1 px-3">Tailwind CSS</span>
        <span class="badge badge-neutral text-xs py-1 px-3">Alpine.js</span>
      </div>
    </div>
  </section>

  <!-- 6. SOURCE CODE (CONDITIONAL) -->
  <% if (typeof repoUrl !== 'undefined' && repoUrl) { %>
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-3">
        <h2 class="type-h2 text-xl sm:text-2xl">Source code</h2>
        <p class="type-body text-sm text-[var(--text-muted)]">
          The code for this project is available on GitHub under an open-source license.
        </p>
        <div>
          <a href="<%= repoUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm inline-flex items-center gap-1.5">
            <%- icon('external-link', { class: 'w-4 h-4' }) %>
            View repository
          </a>
        </div>
      </div>
    </section>
  <% } %>

  <!-- 7. CLOSING CTA BAND -->
  <section class="w-full bg-[var(--card)] text-[var(--foreground)] border-y border-[var(--border)] py-16 sm:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="type-h2 text-[var(--foreground)] text-2xl sm:text-4xl">
        Ready to polish your next draft?
      </h2>

      <p class="type-body text-[var(--muted-foreground)] max-w-xl mx-auto text-sm sm:text-base">
        Browse freelance editors, calculate your upfront rate, and submit your draft in minutes.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <% if (locals.user) { %>
          <a href="/dashboard" class="btn btn-primary btn-lg">
            Go to dashboard
            <%- icon('arrow-right', { class: 'w-4 h-4' }) %>
          </a>
          <a href="/writers" class="btn btn-secondary btn-lg">
            Browse editors
          </a>
        <% } else { %>
          <a href="/writers" class="btn btn-primary btn-lg">
            Browse editors
            <%- icon('arrow-right', { class: 'w-4 h-4' }) %>
          </a>
          <a href="/register" class="btn btn-secondary btn-lg">
            Create an account
          </a>
        <% } %>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
