<%
const defaultUser = {
  name: "Kapil Kor",
  email: "kapil@example.com",
  role: "Writer",
  pricePerPage: 15,
  bio: "Passionate academic researcher and content creator specializing in high-quality writing, literature syntheses, and methodology analysis."
};

const profileData = typeof writer !== 'undefined' ? writer : (typeof user !== 'undefined' && user ? user : defaultUser);
%>
<%- include('partials/head', { pageTitle: profileData.name + ' — Academic Profile | PerPage' }) %>
<%- include('partials/navbar') %>

<main id="main-content" class="py-12 sm:py-16">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <div class="space-y-1">
      <div class="flex items-center gap-2 text-xs text-[var(--text-muted)]">
        <a href="/home" class="hover:text-[var(--text-ink)] transition-colors">Home</a>
        <%- icon('chevron-right', { class: 'w-3 h-3' }) %>
        <span class="text-[var(--text-ink)] font-medium">Author Profile</span>
      </div>
      <h1 class="type-h2">Academic Profile</h1>
    </div>

    <div class="card p-6 sm:p-8 space-y-6">
      <div class="flex items-center gap-4 pb-6 border-b border-[var(--border-color)]">
        <div class="avatar avatar-xl">
          <% if (profileData.profilePic) { %>
            <img src="<%= profileData.profilePic %>" alt="<%= profileData.name %>">
          <% } else { %>
            <span><%= (profileData.name || 'U').charAt(0).toUpperCase() %></span>
          <% } %>
        </div>
        <div>
          <h2 class="type-h3 text-xl"><%= profileData.name %></h2>
          <span class="badge badge-accent capitalize mt-1"><%= (profileData.role === 'writer') ? 'Editor' : 'User' %></span>
          <p class="text-xs text-[var(--text-muted)] mt-1"><%= profileData.email %></p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div class="card-muted p-4 space-y-1">
          <span class="form-label">Rate per Page</span>
          <p class="font-serif-display text-2xl text-[var(--text-ink)]">₹<%= profileData.pricePerPage || 0 %></p>
        </div>

        <div class="card-muted p-4 space-y-1">
          <span class="form-label">Verification</span>
          <div class="flex items-center gap-1.5 text-xs text-[var(--semantic-success-text)] font-medium mt-1">
            <%- icon('shield-check', { class: 'w-4 h-4' }) %>
            Platform Contributor
          </div>
        </div>

        <div class="card-muted p-4 space-y-1 sm:col-span-2">
          <span class="form-label">Research Statement</span>
          <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed">
            <%= profileData.bio || 'Available for document draft editing, analytical literature reviews, and scholarly feedback.' %>
          </p>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>