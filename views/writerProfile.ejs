<%- include('partials/head', { 
  pageTitle: pageTitle || (writer.name + ' — Editor | PerPage'), 
  metaDescription: metaDescription || ('Editor profile for ' + writer.name + ' on PerPage.'),
  canonical: canonical 
}) %>
<%- include('partials/navbar') %>

<% 
  const initials = (writer.name || 'E').split(' ').map(n => n.charAt(0)).slice(0, 2).join('').toUpperCase();
  const nameParts = (writer.name || 'this editor').replace(/^(Dr\.|Prof\.|Mr\.|Ms\.|Mrs\.)\s+/i, '').split(' ');
  const firstName = nameParts[0] || writer.name;
  const isOwnProfile = Boolean(user && user._id && user._id.toString() === writer._id.toString());
  const hasRate = Boolean(writer.pricePerPage && writer.pricePerPage > 0);
  const rate = writer.pricePerPage || 0;

  let memberSince = '';
  if (writer.createdAt) {
    const d = new Date(writer.createdAt);
    memberSince = d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  }
%>

<main id="main-content" class="py-10 sm:py-14">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

    <!-- Breadcrumb & Index Stamp -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[var(--border-color)] pb-4">
      <nav class="flex items-center gap-2 text-xs text-[var(--text-muted)]" aria-label="Breadcrumb">
        <a href="/writers" class="hover:text-[var(--text-ink)] transition-colors">Editors</a>
        <span aria-hidden="true">/</span>
        <span class="text-[var(--text-ink)] font-medium" aria-current="page"><%= writer.name %></span>
      </nav>
      <div class="section-eyebrow">
        <span class="eyebrow-num">ED-<%= writer._id.toString().slice(-4).toUpperCase() %></span>
        <span class="eyebrow-rule"></span>
        <span class="eyebrow-label">Editor Profile</span>
      </div>
    </div>

    <!-- Two-Column Desktop Grid / Single-Column Mobile -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Profile Details & Workflow -->
      <div class="lg:col-span-8 space-y-8">

        <!-- Writer Header Card -->
        <div class="card p-6 sm:p-8 space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center gap-5">
            <div class="avatar avatar-xl flex-shrink-0" aria-hidden="true">
              <% if (writer.profilePic) { %>
                <img src="<%= writer.profilePic %>" alt="<%= writer.name %>">
              <% } else { %>
                <span><%= initials %></span>
              <% } %>
            </div>

            <div class="space-y-1.5 min-w-0">
              <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="type-h2"><%= writer.name %></h1>
                <span class="badge badge-neutral text-xs">Editor</span>
              </div>

              <div class="flex flex-wrap items-center gap-3 text-xs text-[var(--text-muted)]">
                <% if (memberSince) { %>
                  <span>Member since <%= memberSince %></span>
                  <span aria-hidden="true">&bull;</span>
                <% } %>

                <% if (completedCount > 0) { %>
                  <span class="font-medium text-[var(--text-ink)] tabular-nums">
                    <%= completedCount %> completed <%= completedCount === 1 ? 'deal' : 'deals' %>
                  </span>
                  <span aria-hidden="true">&bull;</span>
                <% } else { %>
                  <span>New Editor</span>
                  <span aria-hidden="true">&bull;</span>
                <% } %>

                <% const currentAvg = typeof averageRating !== 'undefined' ? averageRating : (writer.averageRating || 0); %>
                <% const currentReviews = typeof reviewCount !== 'undefined' ? reviewCount : (writer.reviewCount || 0); %>
                <% if (currentReviews > 0) { %>
                  <span class="inline-flex items-center gap-1 font-semibold text-amber-500">
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    <span class="text-[var(--text-ink)]"><%= currentAvg.toFixed(1) %></span>
                    <span class="text-[var(--text-muted)] font-normal">(<%= currentReviews %> <%= currentReviews === 1 ? 'review' : 'reviews' %>)</span>
                  </span>
                <% } else { %>
                  <span class="text-[var(--text-muted)]">No reviews yet</span>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <!-- Mobile-Only Order Card (Shown after header on mobile, hidden on desktop) -->
        <div class="block lg:hidden">
          <div class="card card-ticket p-6 space-y-5" x-data="{ pages: 1, rate: <%= rate %> }">
            <div class="border-b border-[var(--border-color)] pb-4 space-y-1">
              <span class="text-xs text-[var(--text-muted)]">Rate per page</span>
              <% if (hasRate) { %>
                <div class="font-serif-display text-3xl font-normal text-[var(--text-ink)] tabular-nums">
                  ₹<%= rate %>
                </div>
              <% } else { %>
                <div>
                  <span class="badge badge-neutral text-xs font-mono">Rate on inquiry</span>
                  <p class="text-xs text-[var(--text-muted)] mt-1.5">
                    This editor has not set a per-page rate yet. Direct inquiries are pending rate configuration.
                  </p>
                </div>
              <% } %>
            </div>

            <% if (isOwnProfile) { %>
              <div class="space-y-3">
                <p class="text-xs text-[var(--text-muted)]">
                  This is your public editor profile as seen by clients. You give feedback and edits on the client's own text. You do not write documents from scratch.
                </p>
                <a href="/profile/<%= writer._id %>" class="btn btn-secondary btn-md w-full justify-center">
                  Edit your profile
                </a>
              </div>
            <% } else if (!hasRate) { %>
              <div>
                <button type="button" disabled class="btn btn-primary btn-md w-full opacity-50 cursor-not-allowed justify-center">
                  Create a deal
                </button>
                <p class="text-xs text-[var(--text-muted)] mt-2">
                  Deals cannot be created until the editor sets their rate.
                </p>
              </div>
            <% } else { %>
              <!-- Alpine Interactive Price Estimator -->
              <div class="space-y-3 pt-1">
                <div class="space-y-1.5">
                  <label for="pages-estimator-mobile" class="form-label text-xs">Number of pages</label>
                  <input 
                    type="number" 
                    id="pages-estimator-mobile" 
                    min="1" 
                    max="500" 
                    x-model.number="pages"
                    class="form-input text-sm w-full"
                  >
                </div>

                <div class="card-muted p-3 space-y-1">
                  <div class="flex items-center justify-between text-xs text-[var(--text-muted)]">
                    <span>Estimated total</span>
                    <span class="text-sm font-semibold text-[var(--text-ink)]" x-text="'₹' + new Intl.NumberFormat('en-IN').format(Math.max(1, Math.min(500, pages || 1)) * rate)">
                      ₹<%= rate %>
                    </span>
                  </div>
                  <p class="text-[11px] text-[var(--text-muted)] leading-tight">
                    Estimate. The final total is confirmed when you create the deal.
                  </p>
                </div>

                <div class="pt-2">
                  <% if (user) { %>
                    <a href="/deal?writerId=<%= writer._id %>" class="btn btn-primary btn-md w-full justify-center">
                      Create a deal
                      <%- icon('arrow-right', { class: 'w-4 h-4 ml-1.5' }) %>
                    </a>
                  <% } else { %>
                    <a href="/login?returnTo=<%= encodeURIComponent('/deal?writerId=' + writer._id) %>" class="btn btn-primary btn-md w-full justify-center">
                      Log in to create a deal
                    </a>
                    <p class="text-[11px] text-[var(--text-muted)] text-center mt-1.5">
                      Log in or register to commission document editing.
                    </p>
                  <% } %>
                </div>

                <p class="text-[11px] text-[var(--text-muted)] text-center leading-normal pt-1">
                  Files are stored privately and shared through time-limited links.
                </p>
              </div>
            <% } %>
          </div>
        </div>

        <!-- About Section -->
        <div class="card p-6 sm:p-8 space-y-4">
          <div class="section-eyebrow">
            <span class="eyebrow-num">01</span>
            <span class="eyebrow-rule"></span>
            <span class="eyebrow-label">Editorial Background</span>
          </div>
          <h2 class="type-h3 text-lg">Editor Biography</h2>
          <% if (writer.bio && writer.bio.trim()) { %>
            <div class="type-body text-sm text-[var(--text-muted)] leading-relaxed whitespace-pre-line prose-measure">
              <%= writer.bio.trim() %>
            </div>
          <% } else { %>
            <p class="type-body text-sm text-[var(--text-muted)] italic opacity-80 prose-measure">
              This editor has active availability. A full editorial background bio is pending publication.
            </p>
          <% } %>
        </div>

        <!-- How Working with Editor Works Timeline/Stepper -->
        <div class="card p-6 sm:p-8 space-y-6">
          <div class="space-y-1">
            <div class="section-eyebrow">
              <span class="eyebrow-num">02</span>
              <span class="eyebrow-rule"></span>
              <span class="eyebrow-label">Engagement Protocol</span>
            </div>
            <h2 class="type-h3 text-lg">How working with <%= firstName %> works</h2>
            <p class="type-body text-xs text-[var(--text-muted)]">
              PerPage uses a transparent, step-by-step workflow for document editing.
            </p>
          </div>

          <div class="editor-flow-stepper pt-2">
            <!-- Step 1 -->
            <div class="editor-flow-step">
              <div class="editor-flow-marker">1</div>
              <div class="editor-flow-content">
                <h3 class="editor-flow-title">Create a deal</h3>
                <p class="editor-flow-desc">
                  Provide your page count, editing notes, and upload your draft document directly to <%= firstName %>.
                </p>
              </div>
            </div>

            <!-- Step 2 -->
            <div class="editor-flow-step">
              <div class="editor-flow-marker">2</div>
              <div class="editor-flow-content">
                <h3 class="editor-flow-title">Editor accepts or declines</h3>
                <p class="editor-flow-desc">
                  <%= firstName %> reviews your draft details and accepts or declines based on current availability.
                </p>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="editor-flow-step">
              <div class="editor-flow-marker">3</div>
              <div class="editor-flow-content">
                <h3 class="editor-flow-title">Edited file delivered</h3>
                <p class="editor-flow-desc">
                  Once completed, the editor uploads the edited document and feedback through the platform.
                </p>
              </div>
            </div>

            <!-- Step 4 -->
            <div class="editor-flow-step">
              <div class="editor-flow-marker">4</div>
              <div class="editor-flow-content">
                <h3 class="editor-flow-title">Download from your dashboard</h3>
                <p class="editor-flow-desc">
                  Access and download your edited work anytime directly from your PerPage dashboard.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Section 03: Client Reviews & Ratings (Credibility) -->
        <div class="card p-6 sm:p-8 space-y-6">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div>
              <div class="section-eyebrow">
                <span class="eyebrow-num">03</span>
                <span class="eyebrow-rule"></span>
                <span class="eyebrow-label">Editorial Credibility</span>
              </div>
              <h2 class="type-h3 text-lg mt-1">Client Reviews & Ratings</h2>
            </div>
            <% if (currentReviews > 0) { %>
              <div class="flex items-center gap-2 bg-[var(--bg-muted)] py-1.5 px-3 rounded-lg border border-[var(--border-color)]">
                <div class="flex text-amber-500">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <svg class="w-4 h-4 <%= i <= Math.round(currentAvg) ? 'fill-current' : 'text-slate-300 dark:text-slate-700' %>" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  <% } %>
                </div>
                <span class="text-sm font-bold text-[var(--text-ink)]"><%= currentAvg.toFixed(1) %> / 5.0</span>
              </div>
            <% } %>
          </div>

          <% if (typeof reviews !== 'undefined' && reviews.length > 0) { %>
            <div class="divide-y divide-[var(--border-color)]">
              <% reviews.forEach(r => { %>
                <div class="py-4 space-y-2 first:pt-0 last:pb-0">
                  <div class="flex items-center justify-between text-xs">
                    <div class="flex items-center gap-2">
                      <div class="w-6 h-6 rounded-full bg-[var(--accent-primary)]/10 text-[var(--accent-primary)] flex items-center justify-center font-bold text-[10px]">
                        <%= (r.userId?.name || 'Client').charAt(0).toUpperCase() %>
                      </div>
                      <span class="font-medium text-[var(--text-ink)]"><%= r.userId?.name || 'Client' %></span>
                      <span class="badge badge-success text-[10px] py-0 px-1.5">Completed Deal</span>
                    </div>
                    <span class="text-[var(--text-muted)]"><%= new Date(r.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                  </div>
                  
                  <!-- Stars -->
                  <div class="flex items-center gap-1 text-amber-500">
                    <% for (let s = 1; s <= 5; s++) { %>
                      <svg class="w-3.5 h-3.5 <%= s <= r.rating ? 'fill-current' : 'text-slate-300 dark:text-slate-700' %>" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                      </svg>
                    <% } %>
                    <span class="text-xs font-semibold text-[var(--text-ink)] ml-1"><%= r.rating %>.0</span>
                  </div>

                  <% if (r.comment) { %>
                    <p class="text-sm text-[var(--text-muted)] leading-relaxed italic">
                      "<%= r.comment %>"
                    </p>
                  <% } %>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="text-center py-6 px-4 bg-[var(--bg-muted)] rounded-lg border border-[var(--border-color)] space-y-1.5">
              <p class="text-sm font-medium text-[var(--text-ink)]">No reviews yet for <%= firstName %></p>
              <p class="text-xs text-[var(--text-muted)] max-w-md mx-auto">
                Reviews are posted by clients upon deal completion and deliverable acceptance.
              </p>
            </div>
          <% } %>
        </div>

      </div>

      <!-- Right Column: Desktop Sticky Order Card -->
      <aside class="hidden lg:block lg:col-span-4 sticky top-6">
        <div class="card card-ticket p-6 space-y-5" x-data="{ pages: 1, rate: <%= rate %> }">
          
          <div class="border-b border-[var(--border-color)] pb-4 space-y-1">
            <span class="text-xs text-[var(--text-muted)]">Rate per page</span>
            <% if (hasRate) { %>
              <div class="font-serif-display text-3xl font-normal text-[var(--text-ink)] tabular-nums">
                ₹<%= rate %>
              </div>
            <% } else { %>
              <div>
                <span class="badge badge-neutral text-xs font-mono">Rate on inquiry</span>
                <p class="text-xs text-[var(--text-muted)] mt-1.5">
                  This editor has not set a per-page rate yet. Direct inquiries are pending rate configuration.
                </p>
              </div>
            <% } %>
          </div>

          <% if (isOwnProfile) { %>
            <div class="space-y-3">
              <p class="text-xs text-[var(--text-muted)]">
                This is your public editor profile as seen by clients. You give feedback and edits on the client's own text. You do not write documents from scratch.
              </p>
              <a href="/profile/<%= writer._id %>" class="btn btn-secondary btn-md w-full justify-center">
                Edit your profile
              </a>
            </div>
          <% } else if (!hasRate) { %>
            <div>
              <button type="button" disabled class="btn btn-primary btn-md w-full opacity-50 cursor-not-allowed justify-center">
                Create a deal
              </button>
              <p class="text-xs text-[var(--text-muted)] mt-2">
                Deals cannot be created until the editor sets their rate.
              </p>
            </div>
          <% } else { %>
            <!-- Estimator -->
            <div class="space-y-3 pt-1">
              <div class="space-y-1.5">
                <label for="pages-estimator-desktop" class="form-label text-xs">Number of pages</label>
                <input 
                  type="number" 
                  id="pages-estimator-desktop" 
                  min="1" 
                  max="500" 
                  x-model.number="pages"
                  class="form-input text-sm w-full"
                >
              </div>

              <div class="card-muted p-3 space-y-1">
                <div class="flex items-center justify-between text-xs text-[var(--text-muted)]">
                  <span>Estimated total</span>
                  <span class="text-sm font-semibold text-[var(--text-ink)]" x-text="'₹' + new Intl.NumberFormat('en-IN').format(Math.max(1, Math.min(500, pages || 1)) * rate)">
                    ₹<%= rate %>
                  </span>
                </div>
                <p class="text-[11px] text-[var(--text-muted)] leading-tight">
                  Estimate. The final total is confirmed when you create the deal.
                </p>
              </div>

              <div class="pt-2">
                <% if (user) { %>
                  <a href="/deal?writerId=<%= writer._id %>" class="btn btn-primary btn-md w-full justify-center">
                    Create a deal
                    <%- icon('arrow-right', { class: 'w-4 h-4 ml-1.5' }) %>
                  </a>
                <% } else { %>
                  <a href="/login?returnTo=<%= encodeURIComponent('/deal?writerId=' + writer._id) %>" class="btn btn-primary btn-md w-full justify-center">
                    Log in to create a deal
                  </a>
                  <p class="text-[11px] text-[var(--text-muted)] text-center mt-1.5">
                    Log in or register to commission document editing.
                  </p>
                <% } %>
              </div>

              <p class="text-[11px] text-[var(--text-muted)] text-center leading-normal pt-1">
                Files are stored privately and shared through time-limited links.
              </p>
            </div>
          <% } %>

        </div>
      </aside>

    </div>

  </div>
</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
