<%- include('partials/head', { 
  pageTitle: 'Sign in | perpage.', 
  metaDescription: 'Sign in to your PerPage document editing account to review deals, coordinate with freelance editors, and download completed drafts.' 
}) %>
<%- include('partials/navbar') %>

<main id="main-content" class="auth-wrapper" x-data="{ showPassword: false, isSubmitting: false }">
  <div class="auth-grid">

    <!-- Left Column: Editorial Showcase (Brand consistency with navbar) -->
    <div class="auth-showcase-panel">
      <!-- Brand Header -->
      <div>
        <a href="/home" class="inline-flex items-center gap-2 text-decoration-none group mb-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring)] rounded-lg">
          <span class="brand-mark-tile w-7 h-7 rounded-md text-sm">P</span>
          <span class="font-serif text-xl tracking-tight text-[var(--text-ink)] font-bold flex items-baseline select-none">
            perpage<span class="text-[var(--mark)]">.</span>
          </span>
        </a>

        <div class="space-y-1.5">
          <div class="section-eyebrow">
            <span class="eyebrow-num">01</span>
            <span class="eyebrow-rule"></span>
            <span class="eyebrow-label">Editorial Access Desk</span>
          </div>
          <h2 class="type-h2 text-xl font-normal text-[var(--text-ink)] leading-snug">
            Peerless scholarly review, priced by the page.
          </h2>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed">
            Connect directly with freelance editors. Get structural copy editing and line-by-line feedback on your authored drafts.
          </p>
        </div>
      </div>

      <!-- Live Interactive Manuscript Preview Card -->
      <div class="my-4 p-3 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-color)] shadow-xs space-y-2">
        <div class="flex items-center justify-between text-[10px] pb-1.5 border-b border-[var(--border-color)]">
          <span class="font-mono text-[var(--text-muted)]">Commission #4092</span>
          <span class="font-mono font-semibold text-[var(--text-ink)]">₹150 / page</span>
        </div>

        <div>
          <div class="text-xs font-semibold text-[var(--text-ink)] truncate">
            Empirical Modeling of Emerging Markets Volatility
          </div>
          <div class="text-[10px] text-[var(--text-muted)] mt-0.5">
            Academic Economics Draft · 14 pages
          </div>
        </div>

        <!-- Inline Editorial Annotation Snippet -->
        <div class="p-2 rounded bg-[var(--bg-surface-muted)] border-l-2 border-[var(--mark)] text-[10px] space-y-0.5">
          <div class="flex items-center gap-1 font-medium text-[var(--mark)]">
            <%- icon('file-text', { class: 'w-2.5 h-2.5' }) %>
            <span>Editor Feedback Note</span>
          </div>
          <p class="text-[var(--text-ink)] leading-tight">
            “Rephrased thesis statement in section 2.1. Reference list checked for APA 7th edition alignment.”
          </p>
        </div>

        <div class="flex items-center justify-between pt-0.5 text-[10px] text-[var(--text-muted)]">
          <span class="flex items-center gap-1">
            <%- icon('clock', { class: 'w-2.5 h-2.5' }) %>
            Standard 24–48h review
          </span>
          <span class="flex items-center gap-1 font-mono text-[var(--text-ink)]">
            <%- icon('check', { class: 'w-2.5 h-2.5 text-[var(--text-ink)]' }) %>
            14 pages complete
          </span>
        </div>
      </div>

      <!-- Platform Features Footer -->
      <div class="pt-2.5 border-t border-[var(--border-color)] space-y-1 text-[11px] text-[var(--text-muted)]">
        <div class="flex items-center gap-1.5">
          <%- icon('check', { class: 'w-3 h-3 text-[var(--text-ink)] shrink-0' }) %>
          <span>Upfront per-page pricing calculated before submission</span>
        </div>
        <div class="flex items-center gap-1.5">
          <%- icon('check', { class: 'w-3 h-3 text-[var(--text-ink)] shrink-0' }) %>
          <span>Private draft delivery through expiring download links</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Sleek Auth Form -->
    <div class="auth-form-panel">
      <!-- Mobile-only Brand Wordmark -->
      <div class="lg:hidden flex items-center justify-center gap-2 mb-3">
        <a href="/home" class="inline-flex items-center gap-2 text-decoration-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring)] rounded-lg">
          <span class="brand-mark-tile w-6 h-6 text-xs rounded-md">
            P
          </span>
          <span class="font-serif text-lg tracking-tight text-[var(--text-ink)] font-bold flex items-baseline select-none">
            perpage<span class="text-[var(--mark)]">.</span>
          </span>
        </a>
      </div>

      <!-- Top Tab Switcher (Segmented Control) -->
      <div class="segmented-control w-full mb-3.5 grid grid-cols-2 p-0.5 bg-[var(--bg-surface-muted)] border border-[var(--border-color)] rounded-lg">
        <a href="/login" class="segmented-tab is-active py-1.5 text-center text-xs font-semibold rounded-md bg-[var(--bg-surface)] shadow-xs text-[var(--text-ink)]" aria-current="page">
          Sign In
        </a>
        <a href="/register" class="segmented-tab py-1.5 text-center text-xs font-medium rounded-md text-[var(--text-muted)] hover:text-[var(--text-ink)]">
          Create Account
        </a>
      </div>

      <!-- Title & Subtitle -->
      <div class="mb-3">
        <h1 class="text-lg sm:text-xl font-serif text-[var(--text-ink)] font-normal">
          Welcome back to <span class="font-bold">perpage<span class="text-[var(--mark)]">.</span></span>
        </h1>
        <p class="text-xs text-[var(--text-muted)] mt-0.5">
          Access your editing commissions, editors, and documents.
        </p>
      </div>

      <!-- Fast OAuth Social Buttons -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-3">
        <form action="/auth/google" method="GET">
          <button type="submit" class="auth-social-button" aria-label="Sign in with Google">
            <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span>Google</span>
          </button>
        </form>

        <form action="/auth/github" method="GET">
          <button type="submit" class="auth-social-button" aria-label="Sign in with GitHub">
            <svg class="w-3.5 h-3.5 shrink-0 fill-current text-[var(--text-ink)]" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>GitHub</span>
          </button>
        </form>
      </div>

      <!-- Hairline Divider -->
      <div class="relative flex items-center justify-center my-2.5">
        <div class="w-full border-t border-[var(--border-color)]"></div>
        <span class="absolute bg-[var(--bg-surface)] px-2.5 text-[9px] uppercase font-mono tracking-wider text-[var(--text-muted)]">
          or sign in with email
        </span>
      </div>

      <!-- Email & Password Form -->
      <form action="/login" method="POST" class="space-y-2.5" @submit="isSubmitting = true">
        <!-- Email Input -->
        <div class="space-y-1">
          <label for="email" class="form-label text-xs">Email address</label>
          <div class="auth-input-group">
            <span class="auth-input-icon">
              <%- icon('mail', { class: 'w-3.5 h-3.5' }) %>
            </span>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              autocomplete="email"
              placeholder="name@university.edu"
              class="auth-input"
            >
          </div>
        </div>

        <!-- Password Input with Interactive Visibility Toggle -->
        <div class="space-y-1">
          <div class="flex items-center justify-between">
            <label for="password" class="form-label text-xs mb-0">Password</label>
          </div>
          <div class="auth-input-group">
            <span class="auth-input-icon">
              <%- icon('lock', { class: 'w-3.5 h-3.5' }) %>
            </span>
            <input 
              :type="showPassword ? 'text' : 'password'" 
              id="password" 
              name="password" 
              required 
              autocomplete="current-password"
              placeholder="••••••••"
              class="auth-input"
            >
            <button 
              type="button" 
              @click="showPassword = !showPassword" 
              class="auth-password-toggle"
              :aria-label="showPassword ? 'Hide password' : 'Show password'"
            >
              <span x-show="!showPassword">
                <%- icon('eye', { class: 'w-3.5 h-3.5' }) %>
              </span>
              <span x-show="showPassword" x-cloak>
                <%- icon('eye-off', { class: 'w-3.5 h-3.5' }) %>
              </span>
            </button>
          </div>
        </div>

        <!-- Submit Button -->
        <button 
          type="submit" 
          class="btn btn-primary h-9 w-full mt-1 text-xs font-medium"
          :disabled="isSubmitting"
          :aria-busy="isSubmitting ? 'true' : 'false'"
        >
          <span x-show="!isSubmitting" class="flex items-center justify-center gap-1.5">
            <span>Sign in to PerPage</span>
            <%- icon('arrow-right', { class: 'w-3.5 h-3.5' }) %>
          </span>
          <span x-show="isSubmitting" x-cloak class="flex items-center justify-center gap-1.5">
            <%- icon('loader', { class: 'w-3.5 h-3.5 animate-spin' }) %>
            <span>Signing in...</span>
          </span>
        </button>
      </form>

      <!-- Bottom Redirect Link -->
      <div class="text-center mt-3 pt-2.5 border-t border-[var(--border-color)]">
        <p class="text-xs text-[var(--text-muted)]">
          Don't have an account? 
          <a href="/register" class="text-[var(--text-ink)] font-semibold hover:underline">
            Create an account &rarr;
          </a>
        </p>
      </div>

    </div>

  </div>
</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
