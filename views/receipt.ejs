<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment Receipt — Deal #<%= dealShortId %> — PerPage</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css<%= locals.assetVersion ? ('?v=' + locals.assetVersion) : '' %>">
  <style>
    @media print {
      body {
        background: #ffffff !important;
        color: #000000 !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      .no-print {
        display: none !important;
      }
      .receipt-paper {
        box-shadow: none !important;
        border: none !important;
        padding: 0 !important;
        max-width: 100% !important;
        margin: 0 !important;
      }
      .paid-stamp {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
    }

    .paid-stamp {
      display: inline-block;
      padding: 4px 16px;
      font-size: 26px;
      font-weight: 900;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #dc2626;
      border: 3px solid #dc2626;
      border-radius: 8px;
      transform: rotate(-12deg);
      box-shadow: 0 0 0 2px rgba(220, 38, 38, 0.15);
      user-select: none;
      line-height: 1.1;
      background: rgba(254, 242, 242, 0.85);
    }
  </style>
</head>
<body class="bg-gray-100 text-gray-800 antialiased min-h-screen flex flex-col font-sans">

  <!-- Top Test Mode Banner (Styled exactly like Razorpay's authentic checkout banner) -->
  <div class="no-print bg-[#fef9c3] border-b border-[#fde047] text-[#854d0e] py-2 px-4 text-xs font-medium text-center">
    This invoice is created in Test Mode. Only test payments can be made for this invoice.
  </div>

  <!-- Navigation bar (no-print) -->
  <header class="no-print bg-white border-b border-gray-200 px-4 py-3 sm:px-8 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/dashboard" class="flex items-center gap-2 text-gray-900 font-bold hover:text-blue-600 transition-colors">
        <span class="w-8 h-8 rounded-lg bg-[#0c2340] text-white flex items-center justify-center font-bold text-base shadow-sm">P</span>
        <span class="text-base tracking-tight">PerPage</span>
      </a>
      <span class="text-gray-300">/</span>
      <span class="text-xs font-mono text-gray-500">Receipt #<%= dealShortId %></span>
    </div>
    <div class="flex items-center gap-2">
      <a href="/dashboard" class="btn btn-secondary btn-sm text-xs py-1 px-3 inline-flex items-center gap-1.5 rounded-md">
        <span>&larr; Back to Dashboard</span>
      </a>
    </div>
  </header>

  <!-- Main Container -->
  <main class="flex-1 max-w-5xl w-full mx-auto p-4 sm:p-8 flex flex-col md:flex-row gap-6 items-start">

    <!-- Official Razorpay Invoice Paper (Left / Main) -->
    <div class="receipt-paper flex-1 bg-white rounded-lg shadow-sm border border-gray-200 p-6 sm:p-10 w-full relative">

      <!-- Header: Platform Merchant & Razorpay Logo -->
      <div class="flex items-start justify-between border-b border-gray-100 pb-6 mb-6">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-lg bg-[#0c2340] text-white flex items-center justify-center font-bold text-xl shadow-sm">
            P
          </div>
          <div>
            <h2 class="text-base font-bold text-gray-900 tracking-tight leading-tight">aditya nikam</h2>
            <p class="text-xs text-gray-500">PerPage Academic Marketplace</p>
          </div>
        </div>

        <div class="text-right flex flex-col items-end">
          <div class="flex items-center gap-1 text-[#0284c7] font-bold text-lg leading-none">
            <svg class="w-5 h-5 fill-current shrink-0" width="20" height="20" viewBox="0 0 24 24"><path d="M13.5 2L6 14h5.5l-2 8L20 9.5h-6.5L15 2h-1.5z"/></svg>
            <span class="tracking-tight font-extrabold text-[#0284c7]">Razorpay</span>
          </div>
          <span class="text-[10px] text-gray-400 block mt-1">Invoicing and payments powered by Razorpay</span>
        </div>
      </div>

      <!-- Invoice Title & Receipt Meta -->
      <div class="mb-6">
        <div class="flex items-baseline gap-2 flex-wrap">
          <h1 class="text-2xl font-bold text-gray-900">Invoice</h1>
          <span class="text-xs text-gray-500 font-mono">Receipt: deal_<%= dealShortId %>_<%= dateSuffix %></span>
        </div>
        <p class="text-sm text-gray-600 mt-1 font-medium">PerPage Editorial Review - Deal #<%= dealShortId %></p>
      </div>

      <!-- Amount Due & Prominent PAID Rubber Stamp -->
      <div class="bg-gray-50/75 rounded-xl p-5 border border-gray-100 mb-8 flex items-center justify-between flex-wrap gap-4 relative overflow-hidden">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-wider text-gray-500 block">AMOUNT DUE</span>
          <div class="text-3xl font-extrabold text-gray-900 tracking-tight font-mono mt-0.5">
            ₹ 0.00
          </div>
          <span class="text-xs text-emerald-600 font-medium inline-flex items-center gap-1 mt-1">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Payment fully settled via Razorpay
          </span>
        </div>

        <!-- AUTHENTIC RED PAID STAMP -->
        <div class="shrink-0 my-1">
          <div class="paid-stamp">
            PAID
          </div>
        </div>
      </div>

      <!-- Meta Grid: Dates & Transaction IDs -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs border-b border-gray-100 pb-6 mb-6">
        <div>
          <span class="text-gray-400 block text-[10px] uppercase font-mono tracking-wider">ISSUE DATE</span>
          <span class="font-medium text-gray-800"><%= dateFormatted %></span>
        </div>
        <div>
          <span class="text-gray-400 block text-[10px] uppercase font-mono tracking-wider">PAYMENT STATUS</span>
          <span class="font-semibold text-emerald-600 inline-flex items-center gap-1">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Paid (Captured)
          </span>
        </div>
        <div>
          <span class="text-gray-400 block text-[10px] uppercase font-mono tracking-wider">PAYMENT ID</span>
          <span class="font-mono text-gray-700 truncate block font-medium" title="<%= paymentId %>"><%= paymentId %></span>
        </div>
        <div>
          <span class="text-gray-400 block text-[10px] uppercase font-mono tracking-wider">PAYMENT METHOD</span>
          <span class="font-medium text-gray-800 truncate block"><%= paymentMethod %></span>
        </div>
      </div>

      <!-- Line Items Table -->
      <div class="mb-8 overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-gray-200 text-gray-400 font-mono uppercase text-[10px] tracking-wider">
              <th class="py-2.5 pr-4 font-semibold">DESCRIPTION</th>
              <th class="py-2.5 px-4 font-semibold text-right">UNIT PRICE</th>
              <th class="py-2.5 px-4 font-semibold text-center">QTY</th>
              <th class="py-2.5 pl-4 font-semibold text-right">AMOUNT</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <tr>
              <td class="py-3.5 pr-4">
                <span class="font-semibold text-gray-900 block text-sm">Academic Editorial Review (<%= deal.pages || 1 %> pages)</span>
                <span class="text-gray-500 text-xs mt-0.5 block">Editorial review by <%= editorName %> on PerPage</span>
              </td>
              <td class="py-3.5 px-4 text-right font-mono text-gray-700">₹ <%= unitPriceFormatted %></td>
              <td class="py-3.5 px-4 text-center font-mono text-gray-700">1</td>
              <td class="py-3.5 pl-4 text-right font-mono font-semibold text-gray-900">₹ <%= totalFormatted %></td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Financial Totals Summary -->
      <div class="border-t border-gray-200 pt-4 flex flex-col items-end space-y-1.5 text-xs">
        <div class="flex justify-between w-48 text-gray-600">
          <span>Subtotal:</span>
          <span class="font-mono text-gray-900">₹ <%= totalFormatted %></span>
        </div>
        <div class="flex justify-between w-48 text-gray-600">
          <span>Taxes &amp; Fees:</span>
          <span class="font-mono text-gray-900">₹ 0.00</span>
        </div>
        <div class="flex justify-between w-48 font-bold text-gray-900 text-sm border-t border-gray-200 pt-2">
          <span>Total:</span>
          <span class="font-mono">₹ <%= totalFormatted %></span>
        </div>
        <div class="flex justify-between w-48 text-emerald-600 font-semibold pt-1">
          <span>Amount Paid:</span>
          <span class="font-mono">₹ <%= totalFormatted %></span>
        </div>
        <div class="flex justify-between w-48 text-gray-500 font-mono text-[11px] pt-0.5">
          <span>Balance Due:</span>
          <span>₹ 0.00</span>
        </div>
      </div>

      <!-- Bottom Paper Footer -->
      <div class="mt-10 pt-6 border-t border-gray-100 flex items-center justify-between text-[11px] text-gray-400 flex-wrap gap-2">
        <div>
          <span>aditya nikam • India</span>
        </div>
        <div>
          <span>Verified Razorpay Escrow Transaction • PerPage Marketplace</span>
        </div>
      </div>
    </div>

    <!-- Right Action Sidebar (no-print) -->
    <aside class="no-print w-full md:w-72 shrink-0 space-y-4">

      <!-- Status Card -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5 space-y-3">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <div>
            <h3 class="text-xs font-bold text-gray-900">Payment Completed</h3>
            <span class="text-[10px] text-emerald-600 font-medium">Receipt Cleared &amp; Verified</span>
          </div>
        </div>
        <p class="text-xs text-gray-500 leading-relaxed">
          Your payment of <strong class="text-gray-800">₹<%= totalFormatted %></strong> was verified successfully. Funds are secured in escrow while your editor begins editorial review.
        </p>
      </div>

      <!-- Download & Print Actions (Styled matching Razorpay's invoice buttons) -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden divide-y divide-gray-100">
        <button 
          type="button" 
          onclick="window.print()" 
          class="w-full py-3.5 px-4 text-xs font-semibold text-gray-700 hover:bg-gray-50 flex items-center justify-center gap-2 transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          <span>Download Invoice (PDF)</span>
        </button>
        <button 
          type="button" 
          onclick="window.print()" 
          class="w-full py-3.5 px-4 text-xs font-semibold text-gray-700 hover:bg-gray-50 flex items-center justify-center gap-2 transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
          <span>Print Invoice</span>
        </button>
      </div>

      <!-- Return Link -->
      <a 
        href="/dashboard?view=orders" 
        class="block w-full py-2.5 px-4 text-center rounded-lg bg-[#0c2340] text-white hover:bg-[#072654] font-semibold text-xs transition-colors shadow-xs"
      >
        Return to My Dashboard &rarr;
      </a>
    </aside>

  </main>

</body>
</html>
