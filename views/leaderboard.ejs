<%- include('partials/head', { 
  pageTitle: 'Editor Leaderboard — Live Rankings | PerPage', 
  metaDescription: 'Competitive rankings of freelance editors ordered top to bottom by completed works, client ratings, and reviews.',
  canonical: '/leaderboard',
  noindex: false 
}) %>
<%- include('partials/navbar') %>

<main id="main-content" class="py-8 sm:py-12 min-h-[80vh]">
  <!-- Centered, sleek layout with reduced width for info section -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-8" x-data="leaderboardApp()">

    <!-- Sleek Reduced-Width Info & Header Section -->
    <div class="max-w-2xl mx-auto text-center space-y-3 pb-2">
      <div class="section-eyebrow flex items-center justify-center gap-2">
        <span class="eyebrow-num">05</span>
        <span class="eyebrow-rule"></span>
        <span class="eyebrow-label">Rankings</span>
      </div>
      <h1 class="type-h1 text-2xl sm:text-3xl flex items-center justify-center gap-2">
        <span>Editor Leaderboard</span>
        <span class="text-2xl select-none" title="Competitive Leaderboard">🏆</span>
      </h1>
      <p class="type-body text-xs sm:text-sm text-[var(--text-muted)] max-w-lg mx-auto">
        Live competitive rankings of editors ordered top to bottom by completed works. Newly registered editors join the board with a zero count.
      </p>
      
      <!-- Live Status Indicator -->
      <div class="pt-1 flex items-center justify-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[var(--border-color)] bg-[var(--bg-surface-muted)] text-[11px] text-[var(--text-ink)] shadow-xs">
          <span class="pulse-live"></span>
          <span class="font-medium">Live Rankings</span>
          <span class="text-[var(--text-muted)] font-mono" x-text="'· ' + lastSync">· Just now</span>
        </span>
        <button 
          type="button" 
          @click="fetchLiveLeaderboard()" 
          class="btn btn-secondary btn-sm text-xs py-1 px-2.5 inline-flex items-center gap-1 cursor-pointer"
          :disabled="isRefreshing"
          title="Refresh rankings now"
        >
          <span :class="{ 'animate-spin': isRefreshing }">
            <%- icon('refresh', { class: 'w-3 h-3' }) %>
          </span>
          <span x-text="isRefreshing ? 'Syncing...' : 'Sync'">Sync</span>
        </button>
      </div>
    </div>

    <!-- Reduced-Width Search & Filter Bar -->
    <div class="max-w-2xl mx-auto card p-3 sm:p-4">
      <div class="space-y-3">
        <!-- Search Input -->
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[var(--text-muted)] pointer-events-none">
            <%- icon('search', { class: 'w-3.5 h-3.5' }) %>
          </span>
          <input 
            type="text" 
            x-model="searchQuery"
            placeholder="Search editor by name or keywords..."
            class="form-input !pl-10 !pr-8 text-xs sm:text-sm w-full py-1.5 has-search-icon"
            maxlength="80"
          >
          <button 
            type="button" 
            x-show="searchQuery.length > 0" 
            @click="searchQuery = ''" 
            class="absolute right-2.5 top-1/2 -translate-y-1/2 text-[var(--text-muted)] hover:text-[var(--text-ink)] p-0.5"
            style="display: none;"
            aria-label="Clear search"
          >
            <%- icon('x', { class: 'w-3 h-3' }) %>
          </button>
        </div>

        <!-- Filter Chips -->
        <div class="flex items-center justify-center gap-1.5 flex-wrap text-xs">
          <button 
            type="button" 
            @click="activeFilter = 'all'" 
            class="px-2.5 py-1 rounded-full font-medium transition-colors text-[11px]"
            :class="activeFilter === 'all' ? 'bg-[var(--primary)] text-[var(--primary-foreground)]' : 'bg-[var(--bg-surface-muted)] text-[var(--text-muted)] hover:text-[var(--text-ink)]'"
          >
            All Contenders
          </button>
          <button 
            type="button" 
            @click="activeFilter = 'podium'" 
            class="px-2.5 py-1 rounded-full font-medium transition-colors text-[11px]"
            :class="activeFilter === 'podium' ? 'bg-[var(--primary)] text-[var(--primary-foreground)]' : 'bg-[var(--bg-surface-muted)] text-[var(--text-muted)] hover:text-[var(--text-ink)]'"
          >
            Top 3 🏆
          </button>
          <button 
            type="button" 
            @click="activeFilter = 'active'" 
            class="px-2.5 py-1 rounded-full font-medium transition-colors text-[11px]"
            :class="activeFilter === 'active' ? 'bg-[var(--primary)] text-[var(--primary-foreground)]' : 'bg-[var(--bg-surface-muted)] text-[var(--text-muted)] hover:text-[var(--text-ink)]'"
          >
            Completed Works (1+)
          </button>
          <button 
            type="button" 
            @click="activeFilter = 'new'" 
            class="px-2.5 py-1 rounded-full font-medium transition-colors text-[11px]"
            :class="activeFilter === 'new' ? 'bg-[var(--primary)] text-[var(--primary-foreground)]' : 'bg-[var(--bg-surface-muted)] text-[var(--text-muted)] hover:text-[var(--text-ink)]'"
          >
            New Contenders (0)
          </button>
        </div>
      </div>
    </div>

    <!-- Direct Server-Rendered Top 3 Podium (Directly visible immediately on page load) -->
    <% if (leaderboard && leaderboard.length >= 3) { 
        const top1 = leaderboard[0];
        const top2 = leaderboard[1];
        const top3 = leaderboard[2];
    %>
      <section class="space-y-3 pt-2" x-show="activeFilter === 'all' || activeFilter === 'podium'">
        <div class="flex items-center justify-between px-1">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)] flex items-center gap-1.5">
            <%- icon('trophy', { class: 'w-3.5 h-3.5 text-amber-500' }) %>
            Podium Leaders
          </h2>
          <span class="text-[11px] text-[var(--text-muted)]">Ranks 1 · 2 · 3</span>
        </div>

        <!-- 3-Column Podium Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
          
          <!-- Rank 2: Silver (Left) -->
          <div class="podium-card podium-card-silver p-4 sm:p-5 flex flex-col justify-between order-2 md:order-1 min-h-[250px]">
            <div class="space-y-3">
              <div class="flex items-start justify-between">
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold text-xs">
                  🥈 2nd Place
                </span>
                <span class="text-xs font-semibold text-[var(--text-ink)] tabular-nums">
                  <%= top2.pricePerPage > 0 ? ('₹' + top2.pricePerPage + '/page') : 'Flexible' %>
                </span>
              </div>

              <div class="text-center space-y-1.5 py-1">
                <div class="w-14 h-14 mx-auto rounded-full ring-2 ring-slate-300 dark:ring-slate-700 overflow-hidden bg-[var(--bg-surface-muted)] flex items-center justify-center font-bold text-base text-[var(--text-ink)]">
                  <% if (top2.profilePic) { %>
                    <img src="<%= top2.profilePic %>" alt="<%= top2.name %>" class="w-full h-full object-cover">
                  <% } else { %>
                    <span><%= (top2.name || 'E').slice(0, 2).toUpperCase() %></span>
                  <% } %>
                </div>
                <div>
                  <h3 class="font-bold text-sm sm:text-base text-[var(--text-ink)] truncate"><%= top2.name %></h3>
                  <p class="text-[11px] text-[var(--text-muted)] line-clamp-1"><%= top2.bio || 'Editorial Fellow' %></p>
                </div>
              </div>

              <div class="flex items-center justify-center gap-3 pt-2 border-t border-[var(--border-color)] text-xs">
                <span class="font-semibold text-[var(--text-ink)]">
                  🥈 <%= top2.completedCount %> completed
                </span>
                <% if (top2.averageRating > 0) { %>
                  <span class="text-amber-500 font-semibold">★ <%= Number(top2.averageRating).toFixed(1) %></span>
                <% } %>
              </div>
            </div>

            <div class="pt-3 flex items-center gap-2">
              <a href="/writers/<%= top2._id %>" class="btn btn-secondary btn-sm flex-1 text-center text-xs py-1">Profile</a>
              <a href="/deal?writerId=<%= top2._id %>" class="btn btn-primary btn-sm flex-1 text-center text-xs py-1">Hire</a>
            </div>
          </div>

          <!-- Rank 1: Gold (Center & Tallest) -->
          <div class="podium-card podium-card-gold p-5 sm:p-6 flex flex-col justify-between order-1 md:order-2 md:-translate-y-2 min-h-[285px]">
            <div class="space-y-3">
              <div class="flex items-start justify-between">
                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 font-extrabold text-xs shadow-xs border border-amber-300/40">
                  🥇 #1 Champion
                </span>
                <span class="text-xs font-semibold text-[var(--text-ink)] tabular-nums">
                  <%= top1.pricePerPage > 0 ? ('₹' + top1.pricePerPage + '/page') : 'Flexible' %>
                </span>
              </div>

              <div class="text-center space-y-2 py-1">
                <div class="relative w-16 h-16 mx-auto">
                  <div class="w-16 h-16 rounded-full ring-4 ring-amber-400 dark:ring-amber-500 overflow-hidden bg-[var(--bg-surface-muted)] flex items-center justify-center font-bold text-lg text-[var(--text-ink)] shadow-md">
                    <% if (top1.profilePic) { %>
                      <img src="<%= top1.profilePic %>" alt="<%= top1.name %>" class="w-full h-full object-cover">
                    <% } else { %>
                      <span><%= (top1.name || 'E').slice(0, 2).toUpperCase() %></span>
                    <% } %>
                  </div>
                  <span class="absolute -bottom-1.5 -right-1 text-xl select-none">🥇</span>
                </div>

                <div>
                  <h3 class="font-extrabold text-base sm:text-lg text-[var(--text-ink)] truncate"><%= top1.name %></h3>
                  <p class="text-[11px] text-[var(--text-muted)] line-clamp-1"><%= top1.bio || 'Lead Editorial Contender' %></p>
                </div>
              </div>

              <div class="flex items-center justify-center gap-3 pt-2 border-t border-[var(--border-color)] text-xs">
                <div class="font-bold text-[var(--text-ink)] bg-amber-500/10 px-2.5 py-0.5 rounded-full">
                  🔥 <span class="tabular-nums"><%= top1.completedCount %> works completed</span>
                </div>
                <% if (top1.averageRating > 0) { %>
                  <span class="text-amber-500 font-bold">★ <%= Number(top1.averageRating).toFixed(1) %></span>
                <% } %>
              </div>
            </div>

            <div class="pt-3 flex items-center gap-2">
              <a href="/writers/<%= top1._id %>" class="btn btn-secondary btn-sm flex-1 text-center text-xs py-1">Profile</a>
              <a href="/deal?writerId=<%= top1._id %>" class="btn btn-primary btn-sm flex-1 text-center text-xs py-1 font-bold">Hire #1</a>
            </div>
          </div>

          <!-- Rank 3: Bronze (Right) -->
          <div class="podium-card podium-card-bronze p-4 sm:p-5 flex flex-col justify-between order-3 md:order-3 min-h-[250px]">
            <div class="space-y-3">
              <div class="flex items-start justify-between">
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-amber-50 dark:bg-amber-950/30 text-amber-900 dark:text-amber-200 font-bold text-xs">
                  🥉 3rd Place
                </span>
                <span class="text-xs font-semibold text-[var(--text-ink)] tabular-nums">
                  <%= top3.pricePerPage > 0 ? ('₹' + top3.pricePerPage + '/page') : 'Flexible' %>
                </span>
              </div>

              <div class="text-center space-y-1.5 py-1">
                <div class="w-14 h-14 mx-auto rounded-full ring-2 ring-amber-600/40 dark:ring-amber-600/30 overflow-hidden bg-[var(--bg-surface-muted)] flex items-center justify-center font-bold text-base text-[var(--text-ink)]">
                  <% if (top3.profilePic) { %>
                    <img src="<%= top3.profilePic %>" alt="<%= top3.name %>" class="w-full h-full object-cover">
                  <% } else { %>
                    <span><%= (top3.name || 'E').slice(0, 2).toUpperCase() %></span>
                  <% } %>
                </div>
                <div>
                  <h3 class="font-bold text-sm sm:text-base text-[var(--text-ink)] truncate"><%= top3.name %></h3>
                  <p class="text-[11px] text-[var(--text-muted)] line-clamp-1"><%= top3.bio || 'Editorial Fellow' %></p>
                </div>
              </div>

              <div class="flex items-center justify-center gap-3 pt-2 border-t border-[var(--border-color)] text-xs">
                <span class="font-semibold text-[var(--text-ink)]">
                  🥉 <%= top3.completedCount %> completed
                </span>
                <% if (top3.averageRating > 0) { %>
                  <span class="text-amber-500 font-semibold">★ <%= Number(top3.averageRating).toFixed(1) %></span>
                <% } %>
              </div>
            </div>

            <div class="pt-3 flex items-center gap-2">
              <a href="/writers/<%= top3._id %>" class="btn btn-secondary btn-sm flex-1 text-center text-xs py-1">Profile</a>
              <a href="/deal?writerId=<%= top3._id %>" class="btn btn-primary btn-sm flex-1 text-center text-xs py-1">Hire</a>
            </div>
          </div>

        </div>
      </section>
    <% } %>

    <!-- Complete Top-to-Bottom Leaderboard (Directly visible with all editors!) -->
    <div class="card overflow-hidden">
      <div class="px-4 sm:px-5 py-3 border-b border-[var(--border-color)] flex items-center justify-between">
        <h2 class="text-xs sm:text-sm font-semibold text-[var(--text-ink)] flex items-center gap-2">
          <span>Overall Standings</span>
          <span class="text-[11px] font-mono text-[var(--text-muted)]">(<%= leaderboard ? leaderboard.length : 0 %> editors)</span>
        </h2>
        <span class="text-[11px] text-[var(--text-muted)] hidden sm:inline">Ordered by count of completed works</span>
      </div>

      <!-- Direct Server-Rendered List of ALL Editors -->
      <div class="divide-y divide-[var(--border-color)]" id="leaderboard-list">
        <% if (leaderboard && leaderboard.length > 0) { %>
          <% leaderboard.forEach((editor) => { %>
            <div 
              class="leaderboard-row p-3 sm:p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3"
              x-show="isEditorVisible('<%= (editor.name || '').toLowerCase() %>', '<%= (editor.bio || '').toLowerCase() %>', <%= editor.rank %>, <%= editor.completedCount %>)"
            >
              <!-- Left: Rank, Avatar & Details -->
              <div class="flex items-center gap-3 min-w-0 flex-1">
                
                <!-- Rank & Trophy -->
                <div class="w-10 flex-shrink-0 text-center">
                  <% if (editor.rank === 1) { %>
                    <span class="text-lg select-none" title="Rank 1">🥇</span>
                  <% } else if (editor.rank === 2) { %>
                    <span class="text-lg select-none" title="Rank 2">🥈</span>
                  <% } else if (editor.rank === 3) { %>
                    <span class="text-lg select-none" title="Rank 3">🥉</span>
                  <% } else { %>
                    <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-[var(--bg-surface-muted)] text-[11px] font-mono font-bold text-[var(--text-muted)]">
                      #<%= editor.rank %>
                    </span>
                  <% } %>
                </div>

                <!-- Avatar -->
                <div class="w-9 h-9 rounded-full bg-[var(--bg-surface-muted)] ring-1 ring-[var(--border-color)] overflow-hidden shrink-0 flex items-center justify-center font-bold text-xs text-[var(--text-ink)]">
                  <% if (editor.profilePic) { %>
                    <img src="<%= editor.profilePic %>" alt="<%= editor.name %>" class="w-full h-full object-cover">
                  <% } else { %>
                    <span><%= (editor.name || 'E').slice(0, 2).toUpperCase() %></span>
                  <% } %>
                </div>

                <!-- Name & Bio -->
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <a href="/writers/<%= editor._id %>" class="font-bold text-xs sm:text-sm text-[var(--text-ink)] hover:text-[var(--accent)] transition-colors truncate">
                      <%= editor.name %>
                    </a>
                    <% if (editor.trophy) { %>
                      <span class="text-xs select-none"><%= editor.trophy %></span>
                    <% } %>
                  </div>
                  <p class="text-[11px] text-[var(--text-muted)] truncate max-w-sm sm:max-w-md">
                    <%= editor.bio || 'Freelance Editor' %>
                  </p>
                </div>
              </div>

              <!-- Right: Completed Count, Rate & Action -->
              <div class="flex items-center justify-between sm:justify-end gap-2.5 sm:gap-3 w-full sm:w-auto shrink-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-[var(--border-color)] flex-wrap sm:flex-nowrap">
                
                <!-- Completed Count Badge -->
                <div class="text-left sm:text-right min-w-[110px]">
                  <% if (editor.completedCount > 0) { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-300/30 text-[11px] font-semibold">
                      <span>🔥</span>
                      <span class="font-mono tabular-nums"><%= editor.completedCount %></span>
                      <span>completed</span>
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-[var(--bg-surface-muted)] text-[var(--text-muted)] border border-[var(--border-color)] text-[10px] font-medium">
                      <span>🌱</span>
                      <span>New Contender · 0</span>
                    </span>
                  <% } %>
                </div>

                <!-- Rate Per Page -->
                <div class="text-right min-w-[70px]">
                  <div class="text-xs font-semibold text-[var(--text-ink)] tabular-nums">
                    <%= editor.pricePerPage > 0 ? ('₹' + editor.pricePerPage) : 'Flexible' %>
                  </div>
                  <div class="text-[10px] text-[var(--text-muted)]">per page</div>
                </div>

                <!-- Action CTA Buttons -->
                <div class="flex items-center gap-1.5">
                  <a href="/writers/<%= editor._id %>" class="btn btn-secondary btn-sm text-[11px] py-1 px-2.5" title="View editor profile">Profile</a>
                  <a href="/deal?writerId=<%= editor._id %>" class="btn btn-primary btn-sm text-[11px] py-1 px-2.5" title="Hire editor for a deal">Hire</a>
                </div>

              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="p-8 text-center text-xs text-[var(--text-muted)]">
            No editor records found at this time.
          </div>
        <% } %>
      </div>

    </div>

  </div>
</main>

<script nonce="<%= locals.cspNonce || '' %>">
  function leaderboardApp() {
    return {
      searchQuery: '',
      activeFilter: 'all',
      lastSync: 'Just now',
      isRefreshing: false,
      isEditorVisible(name, bio, rank, completedCount) {
        if (this.activeFilter === 'podium' && rank > 3) return false;
        if (this.activeFilter === 'active' && completedCount === 0) return false;
        if (this.activeFilter === 'new' && completedCount > 0) return false;
        
        if (this.searchQuery && this.searchQuery.trim()) {
          const q = this.searchQuery.trim().toLowerCase();
          return name.includes(q) || bio.includes(q);
        }
        return true;
      },
      async fetchLiveLeaderboard() {
        this.isRefreshing = true;
        try {
          const res = await fetch('/api/leaderboard');
          if (res.ok) {
            const data = await res.json();
            if (data && data.success) {
              const now = new Date();
              this.lastSync = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            }
          }
        } catch (e) {
          console.warn('Leaderboard sync error:', e);
        } finally {
          this.isRefreshing = false;
        }
      }
    };
  }
</script>

<%- include('partials/footer') %>
