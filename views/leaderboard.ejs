<%- include('partials/head', { 
  pageTitle: 'Editor Leaderboard — Live Rankings | PerPage', 
  metaDescription: 'Competitive rankings of freelance editors ordered top to bottom by completed works, client ratings, and reviews.',
  canonical: '/leaderboard',
  noindex: false 
}) %>
<%- include('partials/navbar') %>

<main id="main-content" class="py-8 sm:py-12 min-h-[80vh]">
  <!-- Centered, sleek layout with reduced width for info section -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-8" x-data="leaderboardApp()">

    <!-- Sleek Reduced-Width Info & Header Section -->
    <div class="max-w-2xl mx-auto text-center space-y-3 pb-2">
      <div class="section-eyebrow flex items-center justify-center gap-2">
        <span class="eyebrow-num">05</span>
        <span class="eyebrow-rule"></span>
        <span class="eyebrow-label">Rankings</span>
      </div>
      <h1 class="type-h1 text-2xl sm:text-3xl flex items-center justify-center gap-2">
        <span>Editor Leaderboard</span>
        <span class="text-2xl select-none" title="Competitive Leaderboard">🏆</span>
      </h1>
      <p class="type-body text-xs sm:text-sm text-[var(--text-muted)] max-w-lg mx-auto">
        Live competitive rankings of editors ordered top to bottom by completed works. Newly registered editors join the board with a zero count.
      </p>
      
      <!-- Live Status Indicator -->
      <div class="pt-1 flex items-center justify-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[var(--border-color)] bg-[var(--bg-surface-muted)] text-[11px] text-[var(--text-ink)] shadow-xs">
          <span class="pulse-live"></span>
          <span class="font-medium">Live Rankings</span>
          <span class="text-[var(--text-muted)] font-mono" x-text="'· ' + lastSync">· Just now</span>
        </span>
        <button 
          type="button" 
          @click="fetchLiveLeaderboard()" 
          class="btn btn-secondary btn-sm text-xs py-1 px-2.5 inline-flex items-center gap-1 cursor-pointer"
          :disabled="isRefreshing"
          title="Refresh rankings now"
        >
          <span :class="{ 'animate-spin': isRefreshing }">
            <%- icon('refresh', { class: 'w-3 h-3' }) %>
          </span>
          <span x-text="isRefreshing ? 'Syncing...' : 'Sync'">Sync</span>
        </button>
      </div>
    </div>

    <!-- Reduced-Width Search & Filter Bar -->
    <div class="max-w-2xl mx-auto card p-3 sm:p-4">
      <div class="space-y-3">
        <!-- Search Input -->
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[var(--text-muted)] pointer-events-none">
            <%- icon('search', { class: 'w-3.5 h-3.5' }) %>
          </span>
          <input 
            type="text" 
            x-model="searchQuery"
            placeholder="Search editor by name or keywords..."
            class="form-input !pl-10 !pr-8 text-xs sm:text-sm w-full py-1.5 has-search-icon"
            maxlength="80"
          >
          <button 
            type="button" 
            x-show="searchQuery.length > 0" 
            @click="searchQuery = ''" 
            class="absolute right-2.5 top-1/2 -translate-y-1/2 text-[var(--text-muted)] hover:text-[var(--text-ink)] p-0.5"
            style="display: none;"
            aria-label="Clear search"
          >
            <%- icon('x', { class: 'w-3 h-3' }) %>
          </button>
        </div>

        <!-- Filter Chips -->
        <div class="flex items-center justify-center gap-1.5 flex-wrap text-xs">
          <button 
            type="button" 
            @click="activeFilter = 'all'" 
            class="px-2.5 py-1 rounded-full font-medium transition-colors text-[11px]"
            :class="activeFilter === 'all' ? 'bg-[var(--primary)] text-[var(--primary-foreground)]' : 'bg-[var(--bg-surface-muted)] text-[var(--text-muted)] hover:text-[var(--text-ink)]'"
          >
            All Contenders
          </button>
          <button 
            type="button" 
            @click="activeFilter = 'podium'" 
            class="px-2.5 py-1 rounded-full font-medium transition-colors text-[11px]"
            :class="activeFilter === 'podium' ? 'bg-[var(--primary)] text-[var(--primary-foreground)]' : 'bg-[var(--bg-surface-muted)] text-[var(--text-muted)] hover:text-[var(--text-ink)]'"
          >
            Top 3 🏆
          </button>
          <button 
            type="button" 
            @click="activeFilter = 'active'" 
            class="px-2.5 py-1 rounded-full font-medium transition-colors text-[11px]"
            :class="activeFilter === 'active' ? 'bg-[var(--primary)] text-[var(--primary-foreground)]' : 'bg-[var(--bg-surface-muted)] text-[var(--text-muted)] hover:text-[var(--text-ink)]'"
          >
            Completed Works (1+)
          </button>
          <button 
            type="button" 
            @click="activeFilter = 'new'" 
            class="px-2.5 py-1 rounded-full font-medium transition-colors text-[11px]"
            :class="activeFilter === 'new' ? 'bg-[var(--primary)] text-[var(--primary-foreground)]' : 'bg-[var(--bg-surface-muted)] text-[var(--text-muted)] hover:text-[var(--text-ink)]'"
          >
            New Contenders (0)
          </button>
        </div>
      </div>
    </div>

    <!-- Direct Server-Rendered Top 3 Podium (Directly visible immediately on page load) -->
    <% if (leaderboard && leaderboard.length >= 3) { 
        const top1 = leaderboard[0];
        const top2 = leaderboard[1];
        const top3 = leaderboard[2];
    %>
      <section class="space-y-3 pt-2" x-show="activeFilter === 'all' || activeFilter === 'podium'">
        <div class="flex items-center justify-between px-1">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)] flex items-center gap-1.5">
            <%- icon('trophy', { class: 'w-3.5 h-3.5 text-amber-500' }) %>
            Podium Leaders
          </h2>
          <span class="text-[11px] text-[var(--text-muted)]">Ranks 1 · 2 · 3</span>
        </div>

        <!-- 3-Column Podium Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 items-end pt-2">
          
          <!-- Rank 2: Silver (Left) -->
          <div class="podium-card podium-card-silver p-5 flex flex-col justify-between order-2 md:order-1 min-h-[320px] rounded-2xl relative shadow-md">
            <div class="space-y-4">
              <!-- Top Row: Badge & Price -->
              <div class="flex items-center justify-between pb-3 border-b border-slate-300/40 dark:border-slate-700/60">
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800/80 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-200 shadow-xs">
                  <span class="text-sm select-none">🥈</span>
                  <span class="tracking-wide uppercase text-[10px] font-mono font-bold">2nd Place</span>
                </div>
                <div class="text-right">
                  <div class="font-serif-display text-base sm:text-lg font-bold text-[var(--text-ink)] leading-none tabular-nums">
                    <%= top2.pricePerPage > 0 ? ('₹' + top2.pricePerPage) : 'Flexible' %>
                  </div>
                  <span class="text-[9px] text-[var(--text-muted)] font-mono uppercase tracking-wider block mt-0.5">/ page</span>
                </div>
              </div>

              <!-- Avatar & Name Centerpiece -->
              <div class="text-center py-2 space-y-2">
                <div class="relative inline-block mx-auto">
                  <div class="w-16 h-16 rounded-full ring-3 ring-slate-300 dark:ring-slate-600 overflow-hidden bg-[var(--bg-surface-muted)] flex items-center justify-center font-bold text-lg text-[var(--text-ink)] shadow-md shadow-slate-400/10 mx-auto">
                    <% if (top2.profilePic) { %>
                      <img src="<%= top2.profilePic %>" alt="<%= top2.name %>" class="w-full h-full object-cover">
                    <% } else { %>
                      <span><%= (top2.name || 'E').slice(0, 2).toUpperCase() %></span>
                    <% } %>
                  </div>
                  <span class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-800 dark:text-white font-black text-[11px] flex items-center justify-center border-2 border-[var(--bg-surface)] shadow-xs select-none">
                    2
                  </span>
                </div>

                <div>
                  <div class="flex items-center justify-center gap-1.5 min-w-0">
                    <h3 class="font-bold text-base text-[var(--text-ink)] truncate tracking-tight"><%= top2.name %></h3>
                    <% if (top2.isVerified) { %>
                      <span title="Verified Editor by Platform Administration" class="inline-flex items-center text-emerald-600 dark:text-emerald-400 shrink-0">
                        <%- icon('shield-check', { class: 'w-3.5 h-3.5' }) %>
                      </span>
                    <% } %>
                  </div>
                  <p class="text-xs text-[var(--text-muted)] line-clamp-1 max-w-[200px] mx-auto mt-0.5"><%= top2.bio || 'Editorial Fellow' %></p>
                </div>
              </div>

              <!-- Metrics Strip -->
              <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-300/40 dark:border-slate-700/60">
                <div class="flex items-center justify-center gap-1.5 px-2 py-1.5 rounded-xl bg-[var(--bg-surface-muted)] border border-[var(--border-color)] text-xs">
                  <span class="select-none text-slate-500">🥈</span>
                  <span class="font-bold font-mono text-[var(--text-ink)] tabular-nums"><%= top2.completedCount %></span>
                  <span class="text-[10px] text-[var(--text-muted)]">done</span>
                </div>
                <div class="flex items-center justify-center gap-1.5 px-2 py-1.5 rounded-xl bg-[var(--bg-surface-muted)] border border-[var(--border-color)] text-xs">
                  <svg class="w-3.5 h-3.5 fill-amber-400 text-amber-500 shrink-0" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <span class="font-bold font-mono text-[var(--text-ink)] tabular-nums"><%= top2.averageRating > 0 ? Number(top2.averageRating).toFixed(1) : '5.0' %></span>
                  <span class="text-[10px] text-[var(--text-muted)]">rating</span>
                </div>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="pt-4 flex items-center gap-2">
              <a href="/writers/<%= top2._id %>" class="btn btn-secondary btn-sm flex-1 text-center text-xs py-2 rounded-xl">Profile</a>
              <a href="/deal?writerId=<%= top2._id %>" class="btn btn-primary btn-sm flex-1 text-center text-xs py-2 rounded-xl font-semibold flex items-center justify-center gap-1">
                <span>Hire</span>
                <%- icon('arrow-right', { class: 'w-3.5 h-3.5' }) %>
              </a>
            </div>
          </div>

          <!-- Rank 1: Gold / Champion (Center & Elevated) -->
          <div class="podium-card podium-card-gold p-6 flex flex-col justify-between order-1 md:order-2 md:-translate-y-3 min-h-[350px] rounded-2xl relative shadow-xl">
            <div class="space-y-4">
              <!-- Top Row: Badge & Price -->
              <div class="flex items-center justify-between pb-3 border-b border-amber-500/20">
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/15 dark:bg-amber-400/20 border border-amber-400/50 text-amber-900 dark:text-amber-200 shadow-xs">
                  <span class="text-sm select-none">👑</span>
                  <span class="tracking-wide uppercase text-[10px] font-mono font-extrabold">#1 Champion</span>
                </div>
                <div class="text-right">
                  <div class="font-serif-display text-lg sm:text-xl font-bold text-[var(--text-ink)] leading-none tabular-nums">
                    <%= top1.pricePerPage > 0 ? ('₹' + top1.pricePerPage) : 'Flexible' %>
                  </div>
                  <span class="text-[9px] text-[var(--text-muted)] font-mono uppercase tracking-wider block mt-0.5">/ page</span>
                </div>
              </div>

              <!-- Hero Avatar & Laurels -->
              <div class="text-center py-2 space-y-2">
                <div class="relative inline-block mx-auto">
                  <div class="w-20 h-20 rounded-full ring-4 ring-amber-400 dark:ring-amber-500/90 overflow-hidden bg-[var(--bg-surface-muted)] flex items-center justify-center font-bold text-xl text-[var(--text-ink)] shadow-xl shadow-amber-500/20 mx-auto">
                    <% if (top1.profilePic) { %>
                      <img src="<%= top1.profilePic %>" alt="<%= top1.name %>" class="w-full h-full object-cover">
                    <% } else { %>
                      <span><%= (top1.name || 'E').slice(0, 2).toUpperCase() %></span>
                    <% } %>
                  </div>
                  <span class="absolute -bottom-1 -right-1 w-7 h-7 rounded-full bg-amber-400 text-slate-950 font-black text-xs flex items-center justify-center border-2 border-[var(--bg-surface)] shadow-md select-none">
                    1
                  </span>
                </div>

                <div>
                  <div class="flex items-center justify-center gap-1.5 min-w-0">
                    <h3 class="font-extrabold text-lg sm:text-xl text-[var(--text-ink)] truncate tracking-tight"><%= top1.name %></h3>
                    <% if (top1.isVerified) { %>
                      <span title="Verified Editor by Platform Administration" class="inline-flex items-center text-emerald-600 dark:text-emerald-400 shrink-0">
                        <%- icon('shield-check', { class: 'w-4 h-4 text-emerald-600 dark:text-emerald-400' }) %>
                      </span>
                    <% } %>
                  </div>
                  <p class="text-xs text-[var(--text-muted)] line-clamp-1 max-w-[220px] mx-auto mt-0.5"><%= top1.bio || 'Lead Editorial Contender' %></p>
                </div>
              </div>

              <!-- Metrics Strip -->
              <div class="grid grid-cols-2 gap-2 pt-2 border-t border-amber-500/20">
                <div class="flex items-center justify-center gap-1.5 px-2 py-1.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs">
                  <span class="select-none">🔥</span>
                  <span class="font-bold font-mono text-[var(--text-ink)] tabular-nums"><%= top1.completedCount %></span>
                  <span class="text-[10px] text-[var(--text-muted)]">done</span>
                </div>
                <div class="flex items-center justify-center gap-1.5 px-2 py-1.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs">
                  <svg class="w-3.5 h-3.5 fill-amber-400 text-amber-500 shrink-0" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <span class="font-bold font-mono text-[var(--text-ink)] tabular-nums"><%= top1.averageRating > 0 ? Number(top1.averageRating).toFixed(1) : '5.0' %></span>
                  <span class="text-[10px] text-[var(--text-muted)]">rating</span>
                </div>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="pt-4 flex items-center gap-2">
              <a href="/writers/<%= top1._id %>" class="btn btn-secondary btn-sm flex-1 text-center text-xs py-2 rounded-xl">Profile</a>
              <a href="/deal?writerId=<%= top1._id %>" class="btn btn-primary btn-sm flex-1 text-center text-xs py-2 rounded-xl font-bold flex items-center justify-center gap-1.5 shadow-md shadow-amber-500/20">
                <span>Hire #1</span>
                <%- icon('arrow-right', { class: 'w-3.5 h-3.5' }) %>
              </a>
            </div>
          </div>

          <!-- Rank 3: Bronze (Right) -->
          <div class="podium-card podium-card-bronze p-5 flex flex-col justify-between order-3 md:order-3 min-h-[320px] rounded-2xl relative shadow-md">
            <div class="space-y-4">
              <!-- Top Row: Badge & Price -->
              <div class="flex items-center justify-between pb-3 border-b border-amber-600/30 dark:border-amber-800/40">
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 dark:bg-amber-950/40 border border-amber-600/30 text-amber-900 dark:text-amber-200 shadow-xs">
                  <span class="text-sm select-none">🥉</span>
                  <span class="tracking-wide uppercase text-[10px] font-mono font-bold">3rd Place</span>
                </div>
                <div class="text-right">
                  <div class="font-serif-display text-base sm:text-lg font-bold text-[var(--text-ink)] leading-none tabular-nums">
                    <%= top3.pricePerPage > 0 ? ('₹' + top3.pricePerPage) : 'Flexible' %>
                  </div>
                  <span class="text-[9px] text-[var(--text-muted)] font-mono uppercase tracking-wider block mt-0.5">/ page</span>
                </div>
              </div>

              <!-- Avatar & Name Centerpiece -->
              <div class="text-center py-2 space-y-2">
                <div class="relative inline-block mx-auto">
                  <div class="w-16 h-16 rounded-full ring-3 ring-amber-700/40 dark:ring-amber-700/30 overflow-hidden bg-[var(--bg-surface-muted)] flex items-center justify-center font-bold text-lg text-[var(--text-ink)] shadow-md shadow-amber-800/10 mx-auto">
                    <% if (top3.profilePic) { %>
                      <img src="<%= top3.profilePic %>" alt="<%= top3.name %>" class="w-full h-full object-cover">
                    <% } else { %>
                      <span><%= (top3.name || 'E').slice(0, 2).toUpperCase() %></span>
                    <% } %>
                  </div>
                  <span class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-amber-700/50 text-amber-100 font-black text-[11px] flex items-center justify-center border-2 border-[var(--bg-surface)] shadow-xs select-none">
                    3
                  </span>
                </div>

                <div>
                  <div class="flex items-center justify-center gap-1.5 min-w-0">
                    <h3 class="font-bold text-base text-[var(--text-ink)] truncate tracking-tight"><%= top3.name %></h3>
                    <% if (top3.isVerified) { %>
                      <span title="Verified Editor by Platform Administration" class="inline-flex items-center text-emerald-600 dark:text-emerald-400 shrink-0">
                        <%- icon('shield-check', { class: 'w-3.5 h-3.5' }) %>
                      </span>
                    <% } %>
                  </div>
                  <p class="text-xs text-[var(--text-muted)] line-clamp-1 max-w-[200px] mx-auto mt-0.5"><%= top3.bio || 'Editorial Fellow' %></p>
                </div>
              </div>

              <!-- Metrics Strip -->
              <div class="grid grid-cols-2 gap-2 pt-2 border-t border-amber-600/30 dark:border-amber-800/40">
                <div class="flex items-center justify-center gap-1.5 px-2 py-1.5 rounded-xl bg-[var(--bg-surface-muted)] border border-[var(--border-color)] text-xs">
                  <span class="select-none text-amber-700">🥉</span>
                  <span class="font-bold font-mono text-[var(--text-ink)] tabular-nums"><%= top3.completedCount %></span>
                  <span class="text-[10px] text-[var(--text-muted)]">done</span>
                </div>
                <div class="flex items-center justify-center gap-1.5 px-2 py-1.5 rounded-xl bg-[var(--bg-surface-muted)] border border-[var(--border-color)] text-xs">
                  <svg class="w-3.5 h-3.5 fill-amber-400 text-amber-500 shrink-0" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <span class="font-bold font-mono text-[var(--text-ink)] tabular-nums"><%= top3.averageRating > 0 ? Number(top3.averageRating).toFixed(1) : '5.0' %></span>
                  <span class="text-[10px] text-[var(--text-muted)]">rating</span>
                </div>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="pt-4 flex items-center gap-2">
              <a href="/writers/<%= top3._id %>" class="btn btn-secondary btn-sm flex-1 text-center text-xs py-2 rounded-xl">Profile</a>
              <a href="/deal?writerId=<%= top3._id %>" class="btn btn-primary btn-sm flex-1 text-center text-xs py-2 rounded-xl font-semibold flex items-center justify-center gap-1">
                <span>Hire</span>
                <%- icon('arrow-right', { class: 'w-3.5 h-3.5' }) %>
              </a>
            </div>
          </div>

        </div>
      </section>
    <% } %>

    <!-- Complete Top-to-Bottom Leaderboard (Directly visible with all editors!) -->
    <div class="card overflow-hidden">
      <div class="px-4 sm:px-5 py-3 border-b border-[var(--border-color)] flex items-center justify-between">
        <h2 class="text-xs sm:text-sm font-semibold text-[var(--text-ink)] flex items-center gap-2">
          <span>Overall Standings</span>
          <span class="text-[11px] font-mono text-[var(--text-muted)]">(<%= leaderboard ? leaderboard.length : 0 %> editors)</span>
        </h2>
        <span class="text-[11px] text-[var(--text-muted)] hidden sm:inline">Ordered by count of completed works</span>
      </div>

      <!-- Direct Server-Rendered List of ALL Editors -->
      <div class="divide-y divide-[var(--border-color)]" id="leaderboard-list">
        <% if (leaderboard && leaderboard.length > 0) { %>
          <% leaderboard.forEach((editor) => { %>
            <div 
              class="leaderboard-row p-3 sm:p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3"
              x-show="isEditorVisible('<%= (editor.name || '').toLowerCase() %>', '<%= (editor.bio || '').toLowerCase() %>', <%= editor.rank %>, <%= editor.completedCount %>)"
            >
              <!-- Left: Rank, Avatar & Details -->
              <div class="flex items-center gap-3 min-w-0 flex-1">
                
                <!-- Rank & Trophy -->
                <div class="w-10 flex-shrink-0 text-center">
                  <% if (editor.rank === 1) { %>
                    <span class="text-lg select-none" title="Rank 1">🥇</span>
                  <% } else if (editor.rank === 2) { %>
                    <span class="text-lg select-none" title="Rank 2">🥈</span>
                  <% } else if (editor.rank === 3) { %>
                    <span class="text-lg select-none" title="Rank 3">🥉</span>
                  <% } else { %>
                    <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-[var(--bg-surface-muted)] text-[11px] font-mono font-bold text-[var(--text-muted)]">
                      #<%= editor.rank %>
                    </span>
                  <% } %>
                </div>

                <!-- Avatar -->
                <div class="w-9 h-9 rounded-full bg-[var(--bg-surface-muted)] ring-1 ring-[var(--border-color)] overflow-hidden shrink-0 flex items-center justify-center font-bold text-xs text-[var(--text-ink)]">
                  <% if (editor.profilePic) { %>
                    <img src="<%= editor.profilePic %>" alt="<%= editor.name %>" class="w-full h-full object-cover">
                  <% } else { %>
                    <span><%= (editor.name || 'E').slice(0, 2).toUpperCase() %></span>
                  <% } %>
                </div>

                <!-- Name & Bio -->
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <a href="/writers/<%= editor._id %>" class="font-bold text-xs sm:text-sm text-[var(--text-ink)] hover:text-[var(--accent)] transition-colors truncate">
                      <%= editor.name %>
                    </a>
                    <% if (editor.isVerified) { %>
                      <span title="Verified Editor by Platform Administration" class="inline-flex items-center text-emerald-600 dark:text-emerald-400 shrink-0">
                        <%- icon('shield-check', { class: 'w-3.5 h-3.5' }) %>
                      </span>
                    <% } %>
                    <% if (editor.trophy) { %>
                      <span class="text-xs select-none"><%= editor.trophy %></span>
                    <% } %>
                  </div>
                  <p class="text-[11px] text-[var(--text-muted)] truncate max-w-sm sm:max-w-md">
                    <%= editor.bio || 'Freelance Editor' %>
                  </p>
                </div>
              </div>

              <!-- Right: Completed Count, Rate & Action -->
              <div class="flex items-center justify-between sm:justify-end gap-2.5 sm:gap-3 w-full sm:w-auto shrink-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-[var(--border-color)] flex-wrap sm:flex-nowrap">
                
                <!-- Completed Count Badge -->
                <div class="text-left sm:text-right min-w-[110px]">
                  <% if (editor.completedCount > 0) { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-300/30 text-[11px] font-semibold">
                      <span>🔥</span>
                      <span class="font-mono tabular-nums"><%= editor.completedCount %></span>
                      <span>completed</span>
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-[var(--bg-surface-muted)] text-[var(--text-muted)] border border-[var(--border-color)] text-[10px] font-medium">
                      <span>🌱</span>
                      <span>New Contender · 0</span>
                    </span>
                  <% } %>
                </div>

                <!-- Rate Per Page -->
                <div class="text-right min-w-[70px]">
                  <div class="text-xs font-semibold text-[var(--text-ink)] tabular-nums">
                    <%= editor.pricePerPage > 0 ? ('₹' + editor.pricePerPage) : 'Flexible' %>
                  </div>
                  <div class="text-[10px] text-[var(--text-muted)]">per page</div>
                </div>

                <!-- Action CTA Buttons -->
                <div class="flex items-center gap-1.5">
                  <a href="/writers/<%= editor._id %>" class="btn btn-secondary btn-sm text-[11px] py-1 px-2.5" title="View editor profile">Profile</a>
                  <a href="/deal?writerId=<%= editor._id %>" class="btn btn-primary btn-sm text-[11px] py-1 px-2.5" title="Hire editor for a deal">Hire</a>
                </div>

              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="p-8 text-center text-xs text-[var(--text-muted)]">
            No editor records found at this time.
          </div>
        <% } %>
      </div>

    </div>

  </div>
</main>

<script nonce="<%= locals.cspNonce || '' %>">
  function leaderboardApp() {
    return {
      searchQuery: '',
      activeFilter: 'all',
      lastSync: 'Just now',
      isRefreshing: false,
      isEditorVisible(name, bio, rank, completedCount) {
        if (this.activeFilter === 'podium' && rank > 3) return false;
        if (this.activeFilter === 'active' && completedCount === 0) return false;
        if (this.activeFilter === 'new' && completedCount > 0) return false;
        
        if (this.searchQuery && this.searchQuery.trim()) {
          const q = this.searchQuery.trim().toLowerCase();
          return name.includes(q) || bio.includes(q);
        }
        return true;
      },
      async fetchLiveLeaderboard() {
        this.isRefreshing = true;
        try {
          const res = await fetch('/api/leaderboard');
          if (res.ok) {
            const data = await res.json();
            if (data && data.success) {
              const now = new Date();
              this.lastSync = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            }
          }
        } catch (e) {
          console.warn('Leaderboard sync error:', e);
        } finally {
          this.isRefreshing = false;
        }
      }
    };
  }
</script>

<%- include('partials/footer') %>
